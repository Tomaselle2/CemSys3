@* Views/ReporteProblemas/Index.cshtml *@
@{
    ViewData["Title"] = "Reporte de Problemas";
}

<div class="container-fluid py-4">

    <div class="page-header-container">
        <a asp-action="Index" asp-controller="Configuracion" class="btn btn-secondary m-3" title="Configuración">
            <i class="bi bi-arrow-left"></i>
        </a>
        <h2 class="mb-0">Reporte de Problemas</h2>
    </div>

    <div class="alert alert-primary d-flex align-items-center mb-4" role="alert">
        <i class="bi bi-info-circle-fill me-2 fs-5"></i>
        <div>
            Reportes en Excel para detectar inconvenientes en los datos del sistema.
        </div>
    </div>

    <div class="row g-4">

        <!-- Reporte: Concesiones sin difuntos -->
        <div class="col-md-6 col-lg-4">
            <div class="card shadow-sm border-0 h-100">
                <div class="card-body d-flex flex-column">
                    <div class="d-flex align-items-center mb-2">
                        <i class="bi bi-file-earmark-person fs-3 text-secondary me-2"></i>
                        <h5 class="card-title mb-0">Concesiones sin difuntos</h5>
                    </div>
                    <p class="card-text text-muted flex-grow-1">
                        Concesiones vigentes o vencidas (no caducadas) que no tienen ningún difunto
                        registrado en su parcela.
                    </p>
                    <a data-no-loader class="btn btn-success align-self-start"
                       asp-action="ExportarExcelConcesionesSinDifuntos"
                       asp-controller="ReporteProblemas">
                        <i class="bi bi-file-earmark-excel"></i> Exportar a Excel
                    </a>
                </div>
            </div>
        </div>

        <!-- Reporte: Titular que también es difunto -->
        <div class="col-md-6 col-lg-4">
            <div class="card shadow-sm border-0 h-100">
                <div class="card-body d-flex flex-column">
                    <div class="d-flex align-items-center mb-2">
                        <i class="bi bi-person-fill-exclamation fs-3 text-secondary me-2"></i>
                        <h5 class="card-title mb-0">Titular es también difunto</h5>
                    </div>
                    <p class="card-text text-muted flex-grow-1">
                        Concesiones donde la misma persona figura como titular activo
                        y, a la vez, como difunto vigente en esa parcela.
                        1- Cambiar titular como fallecido.
                        2- Cambiar titular manualmente en la concesión.
                    </p>
                    <a data-no-loader class="btn btn-success align-self-start"
                       asp-action="ExportarExcelTitularesFallecidos"
                       asp-controller="ReporteProblemas">
                        <i class="bi bi-file-earmark-excel"></i> Exportar a Excel
                    </a>
                </div>
            </div>
        </div>

    </div>
</div>