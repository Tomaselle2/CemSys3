@* Views/ReporteProblemas/Index.cshtml *@
@{
    ViewData["Title"] = "Reporte de Problemas";
}

<div class="container-fluid py-4">
    <div class="d-flex align-items-center mb-4">
        <i class="bi bi-exclamation-triangle-fill text-warning me-2 fs-3"></i>
        <h3 class="mb-0">Reporte de Problemas</h3>
    </div>

    <div class="alert alert-primary d-flex align-items-center mb-4" role="alert">
        <i class="bi bi-info-circle-fill me-2 fs-5"></i>
        <div>
            Reportes en Excel para detectar inconvenientes en los datos del sistema.
        </div>
    </div>

    <div class="row g-4">

        <!-- Reporte: Concesiones sin difuntos -->
        <div class="col-md-6 col-lg-4">
            <div class="card shadow-sm border-0 h-100">
                <div class="card-body d-flex flex-column">
                    <div class="d-flex align-items-center mb-2">
                        <i class="bi bi-file-earmark-person fs-3 text-secondary me-2"></i>
                        <h5 class="card-title mb-0">Concesiones sin difuntos</h5>
                    </div>
                    <p class="card-text text-muted flex-grow-1">
                        Concesiones vigentes o vencidas (no caducadas) que no tienen ningún difunto
                        registrado en su parcela.
                    </p>
                    <a data-no-loader class="btn btn-success align-self-start"
                       asp-action="ExportarExcelConcesionesSinDifuntos"
                       asp-controller="ReporteProblemas">
                        <i class="bi bi-file-earmark-excel"></i> Exportar a Excel
                    </a>
                </div>
            </div>
        </div>

        <!-- Próximos reportes: agregar acá una nueva tarjeta col-md-6 col-lg-4 -->

    </div>
</div>