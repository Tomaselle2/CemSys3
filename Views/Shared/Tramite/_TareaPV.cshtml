@using CemSys3.DTOs.Tarea
@using CemSys3.Enumerables
@using CemSys3.Helpers.Enumerable 
@model TareaPVDTO

<!-- Listado de tareas-->
<div class="accordion">
    <div class="accordion-item">
        <h2 class="accordion-header" id="panelsStayOpen-headingTareas">
            <button class="accordion-button nueva-seccion acordeon-fijo" type="button" data-bs-target="#panelsStayOpen-collapseTareas" aria-expanded="true" aria-controls="panelsStayOpen-collapseTareas">
                Tareas
            </button>
        </h2>
        <div id="panelsStayOpen-collapseTareas" class="accordion-collapse collapse show" aria-labelledby="panelsStayOpen-headingTareas">
            <div class="mb-3 p-3">
                <form asp-action="GuardarTareas" asp-controller="TramiteConcesion" method="post" onsubmit="return validarTareas()">

                    <div id="tareas">
                        @for (int i = 0; i < Model.Tareas.Count; i++)
                        {
                            <div class="d-flex gap-2 mb-2 task-row align-items-center">

                                <input type="hidden" asp-for="Tareas[i].Id" />
                                <input type="hidden" asp-for="Tareas[i].Eliminada" class="eliminada-flag" />
                                <input type="hidden" asp-for="Tareas[i].NotaId" />
                                <input type="hidden" asp-for="Tareas[i].TareaPlantillaId" />
                                <input type="hidden" asp-for="Tareas[i].TramiteId" />

                                <!-- IMPORTANTE: solo esto, sin duplicados -->
                                <input type="checkbox"
                                       class="form-check-input border border-dark border-1"
                                       asp-for="Tareas[i].Estado" />

                                <input class="form-control flex-grow-1"
                                       asp-for="Tareas[i].Descripcion" />

                                <button type="button"
                                        class="btn btn-danger btn-sm btn-eliminar"
                                        onclick="marcarEliminada(this)">
                                    ✖
                                </button>

                                <button type="button"
                                        class="btn btn-warning btn-sm btn-restaurar d-none"
                                        onclick="restaurar(this)">
                                    ↩
                                </button>
                            </div>
                        }
                    </div>

                    @if (Model.EstadoTramiteId != (int)EstadosTramiteEnum.Finalizado &&
                                                                            Model.EstadoTramiteId != (int)EstadosTramiteEnum.Cancelado)
                        {
                        <button type="button"
                                class="btn btn-sm btn-outline-primary"
                                onclick="agregarTarea()">
                            + Tarea
                        </button>
                        }
                    <hr />

                    <input type="hidden" name="tramiteId" value="@Model.TramiteId" />
                    <input type="hidden" name="returnUrl" value="@Model.returnUrl" />

                     @if (Model.EstadoTramiteId != (int)EstadosTramiteEnum.Finalizado &&
                                                                            Model.EstadoTramiteId != (int)EstadosTramiteEnum.Cancelado)
                        {
                            
                        <button type="submit" class="btn btn-outline-secondary my-3">
                            Actualizar tareas
                        </button>
                        }
                       
                </form>
            </div>
        </div>
    </div>
</div>





<div class="d-flex justify-content-between my-3">

    <!-- Btn Cancelar-->
    <form asp-action="Cancelar" asp-controller="Tramite" method="get" class="documento-form js-confirm my-3">
        <input type="hidden" name="tramiteId" value="@Model.TramiteId" />
        <input type="hidden" name="concesionId" value="@Model.ConcesionId" />

        @if (Model.EstadoTramiteId != (int)EstadosTramiteEnum.Finalizado &&
                            Model.EstadoTramiteId != (int)EstadosTramiteEnum.Cancelado)
        {
            <button type="submit" class="btn btn-outline-danger">
                Cancelar trámite
            </button>
        }
    </form>

    <!-- Btn Finalizar-->
    <form id="formFinalizar"
          asp-action="Finalizar"
          asp-controller="TramiteConcesion"
          method="post"
          class="js-confirm">

        <input type="hidden" name="tipoTramiteId" value="@Model.TipoTramiteId" />
        <input type="hidden" name="tramiteId" value="@Model.TramiteId" />
        <input type="hidden" name="returnUrl" value="@Model.returnUrl" />

        @if (Model.EstadoTramiteId != (int)EstadosTramiteEnum.Finalizado &&
                                    Model.EstadoTramiteId != (int)EstadosTramiteEnum.Cancelado)
        {
            <button id="btnFinalizar" class="btn btn-success" disabled>
                Finalizar trámite
            </button>
        }
     
    </form>
</div>