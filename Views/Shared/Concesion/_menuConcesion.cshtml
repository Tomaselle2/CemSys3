@model int
<style>
    .sidebar-right {
        width: 250px;
        position: fixed;
        right: 0;
        top: 0;
        height: 100vh;
        background: #ffffff;
        border-left: 1px solid #ddd;
    }

    .sidebar_concesion {
        padding: 5px;
    }

    .sidebar_concesion h3 {
            margin-bottom: 20px;
    }

    .sidebar_concesion ul {
            list-style: none;
            padding: 0;
    }

    .sidebar_concesion li {
        margin-bottom: 10px;
        border-radius: 8px;
        transition: all 0.2s ease;
    }

    .sidebar_concesion li:hover {
                background: #9ce0db; /* color suave */
    }

    .sidebar_concesion li.active {
                background: #9ce0db;
        font-weight: 600;
    }

    .sidebar_concesion li.active a {
        color: #000;
    }

    .sidebar_concesion li a {
        display: block;       /* CLAVE */
        padding: 10px;
        text-decoration: none;
        color: #333;
    }

    .sidebar_concesion a {
            text-decoration: none;
            color: #333;
    }

</style>

@{
    var action = ViewContext.RouteData.Values["action"]?.ToString();
}
<div class="sidebar-right">
    <div class="sidebar_concesion">
        <ul>
            <li class="@(action == "Concesion" ? "active" : "")">
                <a asp-controller="Concesion" asp-action="Concesion" asp-route-tramiteId="@Model"><i class="bi bi-info-square"></i> Información General</a>
            </li>

            <li class="@(action == "ArchivosConcesion" ? "active" : "")">
                <a asp-controller="Concesion" asp-action="ArchivosConcesion" asp-route-tramiteId="@Model"><i class="bi bi-file-earmark-pdf"></i> Archivos Adjuntos</a>
            </li>

            <li class="@(action == "CalcularDeuda" ? "active" : "")">
                <a asp-controller="Concesion" asp-action="CalcularDeuda" asp-route-tramiteId="@Model"><i class="bi bi-calculator-fill"></i> Calcular Deuda</a>
            </li>

            <li class="@(action == "HistorialConcesion" ? "active" : "")">
                <a asp-controller="Concesion" asp-action="HistorialConcesion" asp-route-tramiteId="@Model"><i class="bi bi-hourglass-bottom"></i> Historial</a>
            </li>

            <li class="@(action == "Index" ? "active" : "")">
                <a asp-controller="TramiteConcesion" asp-action="Index" target="_blank" asp-route-tramiteId="@Model"><i class="bi bi-file-earmark-text"></i> Trámites</a>
            </li>

            <li class="@(action == "ModificarConcesion" ? "active" : "")">
                <a asp-controller="Concesion" asp-action="ModificarConcesion" asp-route-tramiteId="@Model"><i class="bi bi-pencil-square"></i> Modificar Concesión</a>
            </li>
        </ul>
    </div>
</div>

