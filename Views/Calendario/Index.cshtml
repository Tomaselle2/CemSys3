<div class="d-flex justify-content-end mb-3 my-1">
    <button class="btn btn-primary"
            onclick="abrirNuevoEvento()">
        <i class="bi bi-calendar-plus"></i>
        Nuevo Evento
    </button>
</div>
<div id='calendar'></div>
<div id="modal-container"></div>


<style>
    /* Evitar que los números de día sean seleccionables/clicables */
    .fc-daygrid-day-number {
        pointer-events: none !important;
        user-select: none !important;
        cursor: default !important;
    }
    
    /* Pero permitir clics solo en los eventos */
    .fc-daygrid-day-frame {
        pointer-events: none !important;
    }
    
    .fc-daygrid-day-events,
    .fc-daygrid-event {
        pointer-events: auto !important;
    }
</style>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />

    <script src='https://cdn.jsdelivr.net/npm/fullcalendar@6.1.20/index.global.min.js'></script>
    <script>
        let calendar;
        document.addEventListener('DOMContentLoaded', function () {

            var calendarEl = document.getElementById('calendar');

             calendar = new FullCalendar.Calendar(calendarEl, {

                initialView: 'dayGridMonth',
                events: '/Calendario/GetEvents',
                locale: 'es',
                timeZone: 'local',

                headerToolbar: { 
                left: 'prev,next today',
                center: 'title',
                right: 'dayGridMonth,timeGridWeek,timeGridDay,listMonth'
            },


            // Deshabilitar clics en los días
            dateClick: function(info) {
                htmx.ajax(
                    'GET',
                    `/Calendario/NuevoEvento?fecha=${info.dateStr}`,
                    '#modal-container'
                );
            },

        selectable: false,


            eventClick: function(info) {
                info.jsEvent.preventDefault();
                info.jsEvent.stopPropagation();

                const tipo = info.event.extendedProps.tipo;


                if(tipo === "NotaRecordatorio")
                {
                    Loader.hide();

                    htmx.ajax(
                        'GET',
                        `/Nota/Visualizar?id=${info.event.extendedProps.tramiteId}`,
                        '#modal-container'
                    );

                    return;
                }

                if(tipo === "Manual")
                {
                    htmx.ajax(
                        'GET',
                        `/Calendario/ModalEvento?id=${info.event.id}`,
                        '#modal-container'
                    );

                    return;
                }

                if (info.event.url) {
                    window.location.href = info.event.url;
                }

            }

        });

        calendar.render();


    });


    function abrirNuevoEvento()
    {
        console.log("click");
        htmx.ajax(
            'GET',
            '/Calendario/ModalEvento',
            '#modal-container'
        );
    }


    function guardarEvento()
    {
        $.ajax({
            url: '/Calendario/CrearEvento',
            type: 'POST',
            data: {
                title: $('#title').val(),
                start: $('#start').val()
            },
            success: function() {

                bootstrap.Modal
                    .getInstance(
                        document.getElementById('eventoModal')
                    )
                    .hide();

                calendar.refetchEvents();
            }
        });
    }

    function modificarEvento()
    {
        $.ajax({
            url: '/Calendario/ModificarEvento',
            type: 'POST',
            data: {
                id: $('#id').val(),
                title: $('#title').val(),
                start: $('#start').val()
            },
            success: function() {

                bootstrap.Modal
                    .getInstance(
                        document.getElementById('eventoModal')
                    )
                    .hide();

                calendar.refetchEvents();
            }
        });
    }

    function eliminarEvento(id)
    {
        $.post('/Calendario/EliminarEvento',
        {
            id: id
        },
        function(){

            bootstrap.Modal
                .getInstance(
                    document.getElementById('eventoModal')
                )
                .hide();

            calendar.refetchEvents();
        });
    }
    </script>

    

}


