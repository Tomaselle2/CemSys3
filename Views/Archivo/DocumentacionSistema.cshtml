@using CemSys3.ViewModels.Archivo
@model ArchivosSistemaVM

<style>
    .main-content {
        margin-right: 180px; /* un poco más que el sidebar */
    }

    @@media (max-width: 992px) {
        .main-content {
            margin-right: 0;
        }

        .sidebar-right {
            position: static;
            width: 100%;
            height: auto;
            border-left: none;
        }
    }
</style>
@{
    ViewData["Title"] = $"Archivos del sistema";
    Layout = "~/Views/Shared/_Layout.cshtml";

}

<div class="page-header-container">
    <a asp-action="Index" asp-controller="Configuracion" class="btn btn-secondary m-3" title="Configuración"><i class="bi bi-arrow-left"></i></a>
    <h1 class="title-page">Documentación de CemSys</h1>
</div>

<div class="main-content">

    <!-- Archivos-->
    @{
        var returnUrl = Context.Request.Path + Context.Request.QueryString;
    }
    @await Html.PartialAsync("ArchivoPV/_ArchivoPV",
    new ArchivoVM
    {
        Archivos = Model.Archivos,
        TramiteId = 0,
        returnUrl = returnUrl
    })

</div>



@* Renderizamos el manejador pasándole el DTO del modelo *@
<partial name="_SweetAlertHandler" model="Model.SweetAlert" />
