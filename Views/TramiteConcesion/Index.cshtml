@using CemSys3.Helpers.Enumerable
@using CemSys3.ViewModels.TramiteConcesion
@using CemSys3.Enumerables
@model ListadoTramitesVM
@{
    ViewData["Title"] = "Trámites de concesión";

    string requisitosCambioTitularidad = string.Empty;

    foreach (var requisito in Model.Dto.Requisitos)
    {
        if (requisito.TipoTramiteId == (int)TipoTramiteEnum.CambioTitular)
            requisitosCambioTitularidad = requisito.Descripcion;
    }
}

<!-- Tabla de historial de tramites -->
<div class="accordion" id="accordionPanelsStayOpenExample">
    <div class="accordion-item">
        <h2 class="accordion-header" id="panelsStayOpen-headingOne">
            <button class="accordion-button nueva-seccion acordeon-fijo" type="button" data-bs-toggle="" data-bs-target="#panelsStayOpen-collapseOne" aria-expanded="false" aria-controls="panelsStayOpen-collapseOne">
                Trámites iniciados
            </button>
        </h2>
        <div id="panelsStayOpen-collapseOne" class="accordion-collapse collapse show" aria-labelledby="panelsStayOpen-headingOne">
            @* cuerpo del acordion *@
            @if (Model.Dto.TramitesIniciados.Any())
            {
                <div class="card shadow-sm">
                    <div class="card-body p-0">
                        <table class="table table-hover mb-0">
                            <thead class="table-light">
                                <tr>
                                    <th>Trámite</th>
                                    <th>Fecha inicio</th>
                                    <th>Tipo de Trámite</th>
                                    <th>Estado</th>
                                    <th>Acción</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var opc in Model.Dto.TramitesIniciados)
                                {
                                    string tipoTramiteDisplay = EnumHelper.GetDisplayNameByValue<TipoTramiteEnum>(opc.TipoTramiteId);
                                    string estadoTramiteDisplay = EnumHelper.GetDisplayNameByValue<EstadosTramiteEnum>(opc.EstadoActualId);

                                    if(opc.EstadoActualId != (int)EstadosTramiteEnum.Cancelado && opc.EstadoActualId != (int)EstadosTramiteEnum.Finalizado)
                                    {
                                        <tr>
                                            <td>@opc.Id</td>
                                            <td>@(opc.FechaCreacion.ToString("dd/MM/yyyy HH:mm"))</td>
                                            <td>@tipoTramiteDisplay</td>
                                            <td>@estadoTramiteDisplay</td>
                                            <td>
                                                <form asp-action="IrATramite" asp-controller="Tramite" target="_blank" method="get" style="display: inline-block;" data-skip-loader="true">
                                                    <input type="hidden" name="tramiteId" value="@opc.Id" />
                                                    <button type="submit" class="btn btn-secondary btn-sm" title="Ir al trámite">
                                                        <i class="bi bi-eye"></i>
                                                    </button>
                                                </form>
                                            </td>
                                        </tr>

                                    }
                                    
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            }
            else
            {
                <div class="alert alert-info" role="alert">
                    <i class="fas fa-info-circle"></i>
                    No hay trámites iniciados.
                </div>
            }
            @* Fin cuerpo del acordeon *@
        </div>
    </div>
</div>


<div class="cardConcesion my-4">
    <div class="cardConcesion-content">
        <h3>Cambio de titular (ambos titulares presentes)</h3>
        <textarea class="form-control mb-2" rows="3">@requisitosCambioTitularidad</textarea>

        <div class="d-flex flex-wrap justify-content-between align-items-center mt-3">
            <div>
                <button class="btn btn-outline-primary">Copiar</button>
            </div>

            <div class="text-end">
                @{
                    var tramiteEnProceso = Model.Dto.TramitesIniciados
                        .FirstOrDefault(t => t.TipoTramiteId == (int)TipoTramiteEnum.CambioTitular &&
                     t.EstadoActualId != (int)EstadosCambioTitularEnum.Finalizado &&
                     t.EstadoActualId != (int)EstadosCambioTitularEnum.Cancelado);
                }

                <form asp-action="IniciarCambioTitular" asp-controller="CambioTitular" method="post">
                    <input type="hidden" name="concesionId" value="@Model.Dto.ConcesionId" />
                    <input type="submit" value="Iniciar trámite" class="btn btn-success" />
                </form>
            </div>
        </div>
    </div>
</div>

<!--Aqui van a ir mas tramites-->

@* Renderizamos el manejador pasándole el DTO del modelo *@
<partial name="_SweetAlertHandler" model="Model.SweetAlert" />




    
