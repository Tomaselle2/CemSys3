@{
    ViewData["Title"] = "Configuración";
}
<h1 class="title-page">Configuración</h1>
<div class="container3">
    <a asp-action="AdminUsers" asp-controller="Usuario" class="btn-inicio">
        <i class="bi bi-person-gear mb-2"></i>
        <span>Usuarios</span>
    </a>
    <a asp-action="Index" asp-controller="Tarifaria" class="btn-inicio">
        <i class="bi bi-currency-dollar"></i>
        <span>Tarifaria</span>
    </a>
    <a asp-action="Index" asp-controller="EmpresaSepelio" class="btn-inicio">
        <i class="bi bi-buildings"></i>
        <span>Empresas de sepelio</span>
    </a>
       <a asp-action="Index" asp-controller="Imagenes" class="btn-inicio">
        <i class="bi bi-image-fill"></i>
        <span>Configuración de Imágenes</span>
    </a>
    <a asp-action="IndexPlantillas" asp-controller="PlantillaTramite" class="btn-inicio">
        <i class="bi bi-list-task"></i>
        <span>Plantillas de trámites</span>
    </a>
    <a asp-action="Index" asp-controller="Cementerio" class="btn-inicio">
        <i class="bi bi-prescription2" style="transform: rotate(180deg);"></i>
        <span>Cementerios</span>
    </a>
    <a asp-action="Index" asp-controller="ConceptoTarifaria" class="btn-inicio">
        <i class="bi bi-ui-radios"></i>
        <span>Conceptos de la tarifaria</span>
    </a>
    <a asp-action="DocumentacionSistema" asp-controller="Archivo" class="btn-inicio">
        <i class="bi bi-folder-fill"></i>
        <span>Documentación de CemSys</span>
    </a>
    <a asp-action="CargaIncialDatos" asp-controller="Configuracion" class="btn-inicio">
        <i class="bi bi-box-arrow-down"></i>
        <span>Carga incial de datos</span>
    </a>
    <a asp-action="Index" asp-controller="Backup" class="btn-inicio">
        <i class="bi bi-floppy"></i>
        <span>Backup</span>
    </a>
</div>