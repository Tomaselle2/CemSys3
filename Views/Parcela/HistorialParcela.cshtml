@using CemSys3.ViewModels.Parcela
@using CemSys3.Enumerables
@using CemSys3.Helpers.Enumerable
@model ParcelaHistorialVM

@{
    ViewData["Title"] = "Historial de parcela";

    string parcela = "";

    if (Model.Historial.TipoParcelaId == (int)TipoParcelaEnum.Nicho) //nicho
    {
        parcela = $"Nicho {Model.Historial.NroParcela.ToString()} Fila {Model.Historial.NroFila.ToString()}";
    }
    else if (Model.Historial.TipoParcelaId == (int)TipoParcelaEnum.Fosa)//fosa
    {
        parcela = $"Fosa {Model.Historial.NroParcela.ToString()}";
    }
    else if (Model.Historial.TipoParcelaId == (int)TipoParcelaEnum.Panteon) //panteon
    {
        parcela = $"Lote {Model.Historial.NroParcela.ToString()}";
    }

    string ocupacionParcela = (Model.Historial.CantidadDifuntosActuales > 0) ? "ocupado" : "disponible";

}

<div class="page-header-container">
    <h1 class="title-page">@parcela Sección @Model.Historial.NombreSeccion.ToUpper()</h1>
</div>

<div class="contenedor-resumen">
    <p>Estado: <span class="@ocupacionParcela">@ocupacionParcela</span></p>

    <form asp-action="Guardar" method="post">
        @if (Model.Historial.TipoParcelaId == (int)TipoParcelaEnum.Nicho)
        {
            <div class="mb-2">
                <label class="form-label">Tipo de nicho</label>
                <select class="form-control shadow-sm form-select" asp-for="Historial.TipoNichoId" asp-items="@(EnumHelper.GetSelectListItems<TipoNichoEnum>())"></select>
            </div>
        }

        @if (Model.Historial.TipoParcelaId == (int)TipoParcelaEnum.Panteon)
        {
            <div class="mb-2">
                <label class="form-label">Tipo de panteón</label>
                <select class="form-control shadow-sm form-select" asp-for="Historial.TipoPanteonId" asp-items="@(EnumHelper.GetSelectListItems<TipoPanteonEnum>())">
                </select>
            </div>

            <div class="mb-2">
                <label class="form-label">Nombre del panteón</label>
                <input class="form-control" type="text" asp-for="Historial.NombrePanteon" />
            </div>
        }

        <div>
            <label class="form-label">Información adicional</label>
            <textarea id="textareaInfoAdicional" style="overflow:hidden;" oninput="ajustarAltura(this)" class="form-control" asp-for="Historial.infoAdicional"></textarea>
        </div>

        <div class="mt-3">
            <input type="hidden" asp-for="Historial.Id" />
            <input type="submit" class="btn btn-success" value="Actualizar" />
        </div>
    </form>
</div>

<!-- Tabla de historial de difuntos actuales -->
<div class="accordion" id="accordionPanelsStayOpenExample">
    <div class="accordion-item">
        <h2 class="accordion-header" id="panelsStayOpen-headingOne">
            <button class="accordion-button nueva-seccion acordeon-fijo" type="button" data-bs-toggle="" data-bs-target="#panelsStayOpen-collapseOne" aria-expanded="false" aria-controls="panelsStayOpen-collapseOne">
                Difuntos actuales (@Model.Historial.CantidadDifuntosActuales)
            </button>
        </h2>
        <div id="panelsStayOpen-collapseOne" class="accordion-collapse collapse show" aria-labelledby="panelsStayOpen-headingOne">
            @* cuerpo del acordion *@
            @if (Model.Historial.DifuntosActuales.Any())
            {
                <div class="card shadow-sm">
                    <div class="card-body p-0">
                        <table class="table table-hover mb-0">
                            <thead class="table-light">
                                <tr>
                                    <th>Ingreso</th>
                                    <th>DNI</th>
                                    <th>Difunto</th>
                                    <th>Estado</th>
                                    <th>Acción</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var opc in Model.Historial.DifuntosActuales)
                                {
                                    <tr>
                                        <td>@(opc.FechaIngreso != null ? opc.FechaIngreso?.ToString("dd/MM/yyyy HH:mm") : "")</td>
                                        <td>@(opc.Dni != null ? opc.Dni : "")</td>
                                        <td>@($"{opc.Apellido?.ToUpper()}, {opc.Nombre?.ToUpper()}")</td>
                                        <td>@(opc.EstadoDifunto != null ? EnumHelper.GetDisplayNameByValue<EstadoDifuntoEnum>(opc.EstadoDifunto ?? 0) : "Sin asignar")</td>
                                        <td>
                                            <form asp-action="HistorialPersona" asp-controller="Persona" target="_blank" method="get" style="display: inline-block;" data-skip-loader="true">
                                                <input type="hidden" name="id" value="@opc.Id" />
                                                <button type="submit" class="btn btn-secondary btn-sm" title="Ir al historial">
                                                    <i class="bi bi-clock"></i>
                                                </button>
                                            </form>
                                        </td>
                                    </tr>

                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            }
            else
            {
                <div class="alert alert-info" role="alert">
                    <i class="fas fa-info-circle"></i>
                    No hay difuntos actuales en esta parcela.
                </div>
            }
            @* Fin cuerpo del acordeon *@
        </div>
    </div>
</div>

