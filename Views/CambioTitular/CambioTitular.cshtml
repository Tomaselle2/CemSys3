@* Renderizamos el manejador pasándole el DTO del modelo *@
<partial name="_SweetAlertHandler" model="Model.SweetAlert" />



@{
    var jsonOptions = new System.Text.Json.JsonSerializerOptions
    {
        PropertyNamingPolicy = System.Text.Json.JsonNamingPolicy.CamelCase,
        ReferenceHandler = System.Text.Json.Serialization.ReferenceHandler.IgnoreCycles,
        DefaultIgnoreCondition = System.Text.Json.Serialization.JsonIgnoreCondition.WhenWritingNull
    };

    var titularesProjection = Model.Dto.NuevosTitulares?
        .Select(t => new
        {
            Id = t.Id,
            Dni = t.Dni,
            Nombre = t.Nombre,
            Apellido = t.Apellido,
            Sexo = t.Sexo,
            Celular = t.Celular,
            CorreoElectronico = t.CorreoElectronico,
            Domicilio = t.Domicilio
        })
        .ToList();

    // Cast a object? para que el ?? compare objetos y devuelva un array vacío si es null
    var titularesJson = System.Text.Json.JsonSerializer.Serialize((object?)titularesProjection ?? System.Array.Empty<object>(), jsonOptions);
 }



<script src="~/tinymce/js/tinymce/tinymce.min.js" referrerpolicy="origin" crossorigin="anonymous"></script>
@section Scripts {

<script>
    // Pasar los datos del modelo a JavaScript
    var documentosData = @Html.Raw(Json.Serialize(Model.Documentos));
    
    document.addEventListener('DOMContentLoaded', function () {
    
        const tinyConfig = {
            license_key: 'gpl',
            language: 'es_MX',
            menu: {
                file: { title: 'Archivo', items: 'newdocument restoredraft | preview | importword exportpdf exportword | print | deleteallconversations' },
                edit: { title: 'Editar', items: 'undo redo | cut copy paste pastetext | selectall | searchreplace' },
                view: { title: 'Ver', items: 'code suggestededits revisionhistory | visualaid visualchars visualblocks | spellchecker | preview fullscreen | showcomments' },
                insert: { title: 'Insertar', items: 'image link media addcomment pageembed codesample inserttable | math | charmap emoticons hr | pagebreak nonbreaking anchor tableofcontents | insertdatetime' },
                format: { title: 'Formato', items: 'bold italic underline strikethrough superscript subscript codeformat | styles blocks fontfamily fontsize align lineheight | forecolor backcolor | language | removeformat' },
                tools: { title: 'Herramientas', items: 'spellchecker spellcheckerlanguage | a11ycheck code wordcount' },
                table: { title: 'Tabla', items: 'inserttable | cell row column | advtablesort | tableprops deletetable' }
            },
            toolbar: 'undo redo | styles forecolor | bold italic | alignleft aligncenter alignright alignjustify | outdent indent | image | code',
            statusbar: false,
            plugins: 'image code autoresize',
            autoresize_bottom_margin: 20,
            autoresize_min_height: 200,
            autoresize_max_height: 800,
            autoresize_overflow_padding: 10,

        };

        function inicializarEditor(elementId, formElement) {
            const textarea = document.querySelector('#' + elementId);
            if (!textarea) {
                console.error('No se encontró el textarea:', elementId);
                return;
            }

            tinymce.init({
                ...tinyConfig,
                selector: '#' + elementId,
                auto_focus: false,
                setup: function (editor) {
                    editor.on('init', function () {
                        // Guardar el scroll actual para evitar el salto
                        const scrollX = window.scrollX;
                        const scrollY = window.scrollY;

                        setTimeout(() => {
                                editor.getBody().blur();
                            // Restaurar scroll por si TinyMCE hizo scroll al foco
                            window.scrollTo(scrollX, scrollY);
                            document.activeElement?.blur();
                        }, 50);
                    });

                    if (formElement) {
                        formElement.addEventListener('submit', function () {
                            editor.save();
                        });
                    }
                }
            }).catch(error => {
                console.error('Error inicializando editor ' + elementId, error);
            });
        }
    
        
        // Verificar si hay documentos
        if (documentosData && documentosData.length > 0) {
            documentosData.forEach(function(documento) {
                var editorId = 'editor_' + documento.id;
                var formElement = document.querySelector('form[data-editor-id="' + editorId + '"]');
                setTimeout(function() {
                    inicializarEditor(editorId, formElement);
                }, 100);
            });
        } else {
            console.log('No hay documentos para inicializar');
        }
    
        window.addEventListener('beforeunload', function () {
            if (typeof tinymce !== 'undefined' && tinymce.editors) {
                var editors = tinymce.editors;
                for (var i = 0; i < editors.length; i++) {
                    tinymce.remove(editors[i]);
                }
            }
        });
    });
</script>



    <script>
