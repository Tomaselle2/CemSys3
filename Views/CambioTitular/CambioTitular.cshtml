@using CemSys3.Enumerables
@using CemSys3.Helpers.Enumerable
@using CemSys3.ViewModels.Archivo
@using CemSys3.ViewModels.Historial
@using CemSys3.ViewModels.TramiteConcesion
@model CambioTitularVM

@{
    ViewData["Title"] = "Cambio de Titular";
}

@{
    string nroConcesion = Model.Dto.NroConcesion.HasValue ? Model.Dto.NroConcesion.Value.ToString("D5") : "-----";
    string estadoTramite = EnumHelper.GetDisplayNameByValue<EstadosCambioTitularEnum>(Model.Dto.EstadoTramiteId);
    string tipoParcela = Model.Dto.TipoParcela ?? "N/A";
    string nombreSeccion = Model.Dto.NombreSeccion;
    var returnUrl = Context.Request.Path + Context.Request.QueryString;


    string parcela = "";
    if (Model.Dto.TipoParcela == "Nicho") //nicho
    {
        parcela = $"Nicho {Model.Dto.NroParcela.ToString()} Fila {Model.Dto.NroFila.ToString()}";
    }

    if (Model.Dto.TipoParcela == "Fosa")//fosa
    {
        parcela = $"Fosa {Model.Dto.NroParcela.ToString()}";
    }

    if (Model.Dto.TipoParcela == "Panteón")//panteon
    {
        parcela = $"Lote {Model.Dto.NroParcela.ToString()}";
    }
}

<!-- CSS adicional para múltiples titulares -->
<style>
    .titular-item {
        border: 1px solid #dee2e6;
        border-radius: 8px;
        margin-bottom: 15px;
    }

    .titular-header {
        background-color: #e9ecef;
        padding: 10px 15px;
        border-radius: 8px 8px 0 0;
        display: flex;
        justify-content: space-between;
        align-items: center;
    }

    .titular-number {
        font-weight: bold;
        color: #495057;
    }

    .btn-eliminar {
        padding: 5px 10px;
        font-size: 0.8rem;
    }
</style>

<!-- Panel lateral derecho del historial -->
@await Html.PartialAsync("HistorialPV/_HistorialOffcanvas",
new HistorialOffcanvasVM
{
    Historial = Model.Historial,
    EnumType = typeof(EstadosCambioTitularEnum),
    OffcanvasId = $"offcanvasHistorial_{Model.Dto.TramiteId}",
    Titulo = "Historial del cambio de titular"
})

<h1>Cambio de titular (ambos titulares presentes)</h1>

<div class="contenidoConcesion">
    <div class="cardsConcesion-row my-4">
        <div class="cardConcesion">
            <div class="cardConcesion-content">
                <span class="labelConcesion">NRO. CONCESIÓN</span>
                <h2>@nroConcesion</h2>
            </div>
        </div>

        <div class="cardConcesion estado-card">
            <div class="cardConcesion-content">
                <div class="d-flex justify-content-between align-items-center">
                    <span class="labelConcesion">ESTADO</span>
                    <!--Btn historial-->
                    <div>
                        <button class="btn btn-primary btn-sm" type="button" data-bs-toggle="offcanvas" title="Historial" data-bs-target="#offcanvasHistorial_@Model.Dto.TramiteId">
                            <i class="bi bi-clock-history"></i>
                        </button>
                    </div>
                </div>
                <span class="badgeConcesion px-3 py-2 text-bg-info">@estadoTramite</span>
            </div>
        </div>

        <div class="cardConcesion">
            <div class="cardConcesion-content">
                <span class="labelConcesion">NRO. TRÁMITE</span>
                <h2>@Model.Dto.TramiteId</h2>
            </div>
        </div>
    </div>




    <div class="gridConcesion">
        <div class="cardConcesion">

            <div class="cardConcesion-content">
                <div class="d-flex justify-content-between align-items-center">
                    <h3 class="mb-0">
                        <i class="bi bi-pin-map-fill text-primary"></i> Parcela
                    </h3>
                    <a asp-action="HistorialParcela"
                           asp-controller="Parcela"
                           asp-route-parcelaId="@Model.Dto.ParcelaId"
                           data-skip-loader="true"
                           target="_blank"
                           title="Historial parcela">
                        <i class="bi bi-arrow-up-right-square-fill fs-2"></i>
                    </a>
                </div>
                <p><strong>Tipo:</strong> @tipoParcela</p>
                <p><strong>Sección:</strong> @nombreSeccion.ToUpper()</p>
                <p><strong>Parcela:</strong> @parcela</p>
            </div>
        </div>
    
        @foreach (var titular in Model.Dto.TitularesActuales)
        {
            <div class="cardConcesion">
                <div class="cardConcesion-content">
                    <div class="d-flex justify-content-between align-items-center">
                        <h3 class="mb-0">
                            <i class="bi bi-person-fill text-primary"></i> Titular
                        </h3>
                        <a asp-action="HistorialPersona"
                               asp-controller="Persona"
                               asp-route-id="@titular.Id"
                               data-skip-loader="true"
                               target="_blank"
                               title="Historial titular">
                            <i class="bi bi-arrow-up-right-square-fill fs-2"></i>
                        </a>
                    </div>
                    <p><strong>Nombre:</strong> @titular.Apellido?.ToUpper(), @titular.Nombre?.ToUpper()</p>
                    <p><strong>DNI:</strong> @(!string.IsNullOrEmpty(titular.Dni) ? titular.Dni : "")</p>
                    <p><strong>Celular:</strong> @(!string.IsNullOrEmpty(titular.Celular) ? titular.Celular : "")</p>
                    <p><strong>E-mail:</strong> @(!string.IsNullOrEmpty(titular.CorreoElectronico) ? titular.CorreoElectronico : "")</p>
                    <p><strong>Domicilio:</strong> @(!string.IsNullOrEmpty(titular.Domicilio) ? titular.Domicilio : "")</p>
                </div>
            </div>
        }
    </div>

</div>


<!-- Modal contribuyente-->
<div class="modal fade" id="TitularModal" tabindex="-1" aria-labelledby="titularModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="titularModalLabel">Buscar/Registrar Titular</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <form id="formContribuyente" class="needs-validation" novalidate data-no-loader="true">
                    <div class="row">
                        <div class="col-md-6">
                            <label for="dniInput">DNI<span class="obligatorio"> * </span></label>
                            <input class="form-control" id="dniInput" type="text" pattern="[0-9]+" maxlength="8" autocomplete="off" oninput="this.value = this.value.replace(/[^0-9]/g, '')" required />
                            <div class="invalid-feedback">El DNI es obligatorio</div>
                        </div>
                        <div class="col-md-6">
                            <label for="sexoInput">Sexo<span class="obligatorio"> * </span></label>
                            <select class="form-select" id="sexoInput" required>
                                <option value="">--Elija una opción--</option>
                                <option value="masculino">Masculino</option>
                                <option value="femenino">Femenino</option>
                                <option value="otro">Otro</option>
                            </select>
                            <div class="invalid-feedback">El sexo es obligatorio</div>
                        </div>
                    </div>

                    <!-- Campos adicionales (inicialmente ocultos) -->
                    <div id="camposAdicionales" style="display: none;">
                        <div class="row mt-3">
                            <div class="col-md-6">
                                <label for="nombreInput">Nombre<span class="obligatorio"> * </span></label>
                                <input class="form-control" id="nombreInput" type="text" maxlength="60" minlength="2" />
                                <div class="invalid-feedback">El nombre es obligatorio</div>
                            </div>
                            <div class="col-md-6">
                                <label for="apellidoInput">Apellido<span class="obligatorio"> * </span></label>
                                <input class="form-control" type="text" id="apellidoInput" maxlength="60" minlength="2" />
                                <div class="invalid-feedback">El apellido es obligatorio</div>
                            </div>
                        </div>
                        <div class="row mt-3">
                            <div class="col-md-6">
                                <label for="celularInput">Celular</label>
                                <input class="form-control" type="text" id="celularInput" maxlength="25" pattern="[0-9]+" oninput="this.value = this.value.replace(/[^0-9]/g, '')" />
                                <div class="invalid-feedback">No puede tener más de 25 dígitos</div>
                            </div>
                            <div class="col-md-6">
                                <label for="correoInput">Correo electrónico</label>
                                <input class="form-control" type="email" maxlength="100" id="correoInput" />
                                <div class="invalid-feedback">Debe contener "@@" y "." </div>
                            </div>
                        </div>
                        <div class="mt-3">
                            <label for="domicilioInput">Domicilio<span class="obligatorio"> * </span></label>
                            <input class="form-control" type="text" maxlength="100" minlength="2" id="domicilioInput" />
                            <div class="invalid-feedback">El domicilio es obligatorio</div>
                        </div>
                    </div>

                    <!-- Mensaje de error -->
                    <div id="errorMessage" class="alert alert-danger mt-3" style="display: none;"></div>
                </form>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
                <button type="submit" form="formContribuyente" class="btn btn-primary" id="btnAccionContribuyente">Buscar</button>
            </div>
        </div>
    </div>
</div>


<!-- Modal Confirmación Quitar contribuyente -->
