                        </button>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <input type="hidden" asp-for="concesionId" value="@Model.Dto.ConcesionId" />
    <input type="hidden" asp-for="TramiteId" />
    <input type="hidden" asp-for="Dto.NroParcela" />
    <input type="hidden" asp-for="Dto.TipoParcela" />
    <input type="hidden" asp-for="Dto.NombreSeccion" />
    <input type="hidden" asp-for="Dto.NroFila" />

    @for (int i = 0; i < Model.Dto.TitularesActuales.Count; i++)
    {
        <input type="hidden" asp-for="Dto.TitularesActuales[i].Id" />
        <input type="hidden" asp-for="Dto.TitularesActuales[i].Dni" />
        <input type="hidden" asp-for="Dto.TitularesActuales[i].Nombre" />
        <input type="hidden" asp-for="Dto.TitularesActuales[i].Apellido" />
        <input type="hidden" asp-for="Dto.TitularesActuales[i].Celular" />
        <input type="hidden" asp-for="Dto.TitularesActuales[i].CorreoElectronico" />
        <input type="hidden" asp-for="Dto.TitularesActuales[i].Domicilio" />
        <input type="hidden" asp-for="Dto.TitularesActuales[i].Sexo" />
    }

    @for (int i = 0; i < Model.Dto.Difuntos.Count; i++)
    {
        <input type="hidden" asp-for="Dto.Difuntos[i].Id" />
        <input type="hidden" asp-for="Dto.Difuntos[i].Nombre" />
        <input type="hidden" asp-for="Dto.Difuntos[i].Apellido" />
    }

    @if (Model.Dto.EstadoTramiteId != (int)EstadosCambioTitularEnum.Finalizado &&
        Model.Dto.EstadoTramiteId != (int)EstadosCambioTitularEnum.Cancelado)
    {
        <input type="submit" class="btn btn-outline-primary" id="btnGenerarAutorizacion" value="Generar Autorización" />
    }
</form>

<!-- Visualiza para documento/autorizacion -->
@foreach (var documento in Model.Documentos)
{
    string editorId = $"editor_{documento.Id}";

    <div class="card mb-3">
        <div class="card-header">
            <h5>Autorización @documento.Parentesco?.ToUpper()</h5>
            <form asp-action="Eliminar" asp-controller="Documento" method="get" class="documento-form mb-4 js-confirm">
                <input type="hidden" name="documentoId" value="@documento.Id" />
                <input type="hidden" name="tramiteId" value="@documento.TramiteId" />
                <input type="hidden" name="returnUrl" value="@returnUrl" />

                <button type="submit" class="btn btn-outline-danger">
                    Eliminar Autorización
                </button>
            </form>
        </div>
        <form asp-action="Editar" asp-controller="Documento" method="post" class="documento-form mb-4" data-editor-id="@editorId">
                <div class="card-body">
                    <textarea id="@editorId" name="contenidoHtml">
                        @Html.Raw(documento.ContenidoHtml)
                    </textarea>
                </div>

                <div class="card-footer">
                    <input type="hidden" name="id" value="@documento.Id" />
                    <input type="hidden" name="tramiteId" value="@documento.TramiteId" />
                    <input type="hidden" name="returnUrl" value="@returnUrl" />

                    <button type="submit" class="btn btn-outline-primary">
                        Actualizar Autorización
                    </button>
            </div>
        </form>
    </div>

}



