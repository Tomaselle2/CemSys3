@using CemSys3.DTOs.Paginacion
@using CemSys3.Enumerables
@using CemSys3.Helpers.Enumerable
@using CemSys3.ViewModels.ConceptoTarifaria
@model ConceptoTarifariaVM

@{
    ViewData["Title"] = "Conceptos tarifaria";
}

<div class="page-header-container">
    <a asp-action="Index" asp-controller="Configuracion" class="btn btn-secondary me-3" title="Configuración">
        <i class="bi bi-arrow-left"></i>
    </a>
    <h1 class="title-page">Conceptos de la tarifaria</h1>
</div>


<!--Formulario-->
<div class="accordion" id="accordionPanelsStayOpenExample">
    <div class="accordion-item">
        <h2 class="accordion-header" id="panelsStayOpen-headingOne">
            <button class="accordion-button nueva-seccion acordeon-fijo" type="button" data-bs-toggle="" data-bs-target="#panelsStayOpen-collapseOne" aria-expanded="false" aria-controls="panelsStayOpen-collapseOne">
                @(Model.EsEdicion ? "Modificar concepto" : "Nuevo concepto")
            </button>
        </h2>
        <div id="panelsStayOpen-collapseOne" class="accordion-collapse collapse show" aria-labelledby="panelsStayOpen-headingOne">
            <div class="accordion-body">
                @* cuerpo del acordion *@
                <form asp-action="Guardar" method="post" class="form-box">
                    <input type="hidden" asp-for="Id" />
                    
                    <div class="form-columns-container3">
                        <div>
                            <label for="nombre" class="form-label">Nombre</label>
                            <input class="form-control" type="text" asp-for="Nombre" required maxlength="50" id="nombre" />
                            <span asp-validation-for="Nombre" class="text-danger"></span>
                        </div>

                        <div>
                            <label for="tipoNumeracion" class="form-label">Tema</label>
                            <select class="form-select" asp-for="TemaId" asp-items="@EnumHelper.GetSelectListItems<TemaTarifariaEnum>()" required>
                                <option value="">--Elija una opción--</option>
                            </select>
                            <span asp-validation-for="TemaId" class="text-danger"></span>
                        </div>
                    </div>
                    <div class="form-button-registrar">
                        <button class="btn @Model.ClaseBoton" type="submit">@Model.TextoBoton</button>
                    </div>
                </form>
                @* Fin cuerpo del acordeon *@
            </div>
        </div>
    </div>
</div>

<!-- Tabla -->
<div class="accordion" id="accordionPanelsStayOpenExample">
    <div class="accordion-item">
        <h2 class="accordion-header" id="panelsStayOpen-headingOne">
            <button class="accordion-button nueva-seccion acordeon-fijo" type="button" data-bs-toggle="" data-bs-target="#panelsStayOpen-collapseOne" aria-expanded="false" aria-controls="panelsStayOpen-collapseOne">
                Conceptos registrados
            </button>
        </h2>
        <div id="panelsStayOpen-collapseOne" class="accordion-collapse collapse show" aria-labelledby="panelsStayOpen-headingOne">
            @* cuerpo del acordion *@
            @if (Model.ListadoConceptos.Any())
            {
                <div class="card shadow-sm">
                    <div class="card-body p-0">
                        <table class="table table-hover mb-0">
                            <thead class="table-light">
                                <tr>
                                    <th>Nombre</th>
                                    <th>Tema</th>
                                    <th>Estado</th>
                                    <th>Acciones</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var opc in Model.ListadoConceptos)
                                {
                                    <tr>
                                        <td>@opc.Nombre.ToUpper()</td>
                                        <td>@(EnumHelper.GetDisplayNameByValue<TemaTarifariaEnum>(opc.TemaId))</td>
                                        <td>@(opc.Visibilidad == true ? "Activo" : "Inactivo")</td>
                                        <td>
                                            @if (opc.Visibilidad == true)
                                            {
                                                <form asp-action="Editar" asp-controller="ConceptoTarifaria" method="get" style="display: inline-block;">
                                                    <input type="hidden" asp-for="Id" value="@opc.Id" name="id" />

                                                    <button type="submit" class="btn btn-warning btn-sm btn-lista" title="Editar">
                                                        <i class="bi bi-pencil"></i>
                                                    </button>
                                                </form>
                                                
                                                <form asp-action="Eliminar" asp-controller="ConceptoTarifaria" class="js-confirm"
                                                      method="get" style="display: inline-block;" id="formularioEliminar"
                                                      data-confirm-title="Confirmar eliminación"
                                                      data-confirm-message="¿Está seguro de eliminar el concepto @opc.Nombre.ToUpper()?"
                                                      data-confirm-icon="warning">

                                                    <input type="hidden" asp-for="Id" name="id" value="@opc.Id" />


                                                    <button type="submit" class="btn btn-danger btn-sm btn-lista" title="Eliminar">
                                                        <i class="bi bi-trash"></i>
                                                    </button>
                                                </form>
                                            }
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            }
            else
            {
                <div class="alert alert-info mt-3" role="alert">
                    <i class="bi bi-info-circle me-2"></i> No se encontraron registros de conceptos de la tarifaria.
                </div>
            }
            @* Fin cuerpo del acordeon *@

            @* Paginador *@
            @if (Model.Paginacion.TotalPaginas > 0)
            {
                @await Html.PartialAsync("_Paginador", new PaginacionDTO
                {
                    PaginaActual = Model.Paginacion.PaginaActual,
                        TotalPaginas = Model.Paginacion.TotalPaginas,
                        TotalRegistros = Model.Paginacion.TotalRegistros,
                        RegistrosPorPagina = Model.Paginacion.RegistrosPorPagina,
                        Accion = "Index",
                        Controlador = "ConceptoTarifaria",
                        Parametros = Model.Paginacion.Parametros
                    })
                }
        </div>
    </div>
</div>

@* Renderizamos el manejador pasándole el DTO del modelo *@
<partial name="_SweetAlertHandler" model="Model.SweetAlert" />

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
