@using CemSys3.DTOs.Tarifaria
@using CemSys3.Enumerables
@using CemSys3.Helpers.Enumerable
@model IEnumerable<PrecioIngresoDTO>
@{
    ViewData["Title"] = "Precios de Ingreso";
    Layout = null;
}

<style>
    .contenedor-principal {
        display: grid;
        grid-template-columns: repeat(2, 1fr);
        gap: 30px;
        width: 100%;
        margin: 0 auto;
    }

    .grupo-tabla {
        break-inside: avoid;
        page-break-inside: avoid;
        margin-bottom: 30px;
    }

    table {
        border-collapse: collapse;
        width: 100%;
        font-family: Arial, sans-serif;
        font-size: 13px;
        margin-bottom: 0;
    }

    th, td {
        border: 1px solid #000;
        padding: 5px 8px;
        vertical-align: top;
    }

    th {
        text-align: center;
        font-weight: bold;
        background-color: #f2f2f2;
        font-size: 14px;
    }

    .right {
        text-align: right;
    }

    .bold {
        font-weight: bold;
    }

    /* Primera columna sin líneas internas */
    .grupo {
        border-bottom: none;
        width: 35%;
    }

    .grupo-cont {
        border-top: none;
        border-bottom: none;
    }

    .grupo-fin {
        border-top: none;
    }

    /* Renglón separador */
    .espacio td {
        height: 12px;
        border: none;
    }

    .titulo-regla {
        font-size: 14px;
        font-weight: bold;
        margin: 0;
        background-color: #f9f9f9;
    }

    .total-ingreso {
        background-color: #e8e8e8;
        font-size: 14px;
    }

    /* Para separar las tablas dentro de un grupo */
    .separador-tabla {
        height: 20px;
    }

    .td-contenido {
        width: 45%;
    }

    .td-importe {
        width: 30%;
    }
</style>

<div class="contenedor-principal">
    @{
        int contador = 0;
        foreach (var regla in Model)
        {
            <div class="grupo-tabla">
                <table>
                    <!-- Encabezado principal -->
                    <tr>
                        <th colspan="2" style="font-size: 16px; padding: 8px;">
                            @(EnumHelper.GetDisplayNameByValue<TipoParcelaEnum>(regla.TipoParcelaId).ToUpper())
                        </th>
                        <th style="font-size: 16px; padding: 8px;">
                            @DateTime.Now.Year.ToString()
                        </th>
                    </tr>

                    <!-- Título de la regla -->
                    <tr class="titulo-regla">
                        <td colspan="3" class="bold" style="padding: 8px;">
                            @regla.NombreRegla
                        </td>
                    </tr>

                    @foreach (var tema in regla.Temas)
                    {
                        var totalTema = tema.Conceptos.Sum(c => c.PrecioBase);

                        <!-- Encabezado del tema -->
                        <tr>
                            <th colspan="2">Tema</th>
                            <th>Importe</th>
                        </tr>

                        <!-- Conceptos del tema -->
                        @for (int i = 0; i < tema.Conceptos.Count; i++)
                        {
                            var concepto = tema.Conceptos[i];

                            <tr>
                                @if (i == 0)
                                {
                                    <td class="bold grupo">@tema.Tema</td>
                                }
                                else if (i == tema.Conceptos.Count - 1)
                                {
                                    <td class="grupo-fin"></td>
                                }
                                else
                                {
                                    <td class="grupo-cont"></td>
                                }

                                <td class="td-contenido">@concepto.Nombre</td>
                                <td class="right td-importe">
                                    @concepto.PrecioBase.ToString("C")
                                </td>
                            </tr>
                        }

                        <!-- TOTAL POR TEMA -->
                        <tr>
                            <td></td>
                            <td class="bold">Total</td>
                            <td class="right bold">
                                @totalTema.ToString("C")
                            </td>
                        </tr>

                        <!-- Espacio entre temas -->
                        <tr class="espacio">
                            <td colspan="3"></td>
                        </tr>
                    }

                    <!-- TOTAL POR REGLA -->
                    <tr class="total-ingreso">
                        <td colspan="2" class="bold">TOTAL INGRESO</td>
                        <td class="right bold">
                            @regla.Temas.Sum(t => t.Conceptos.Sum(c => c.PrecioBase)).ToString("C")
                        </td>
                    </tr>
                </table>
            </div>

            contador++;

            <!-- Si queremos controlar cuántas tablas por columna, podemos agregar un break -->
            @if (contador % 4 == 0)
            {
                <!-- Esto ayuda en algunos navegadores a forzar un nuevo flujo -->
                <div style="break-before: column;"></div>
            }
        }
    }
</div>