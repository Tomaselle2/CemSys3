@using CemSys3.DTOs.Tarifaria
@using CemSys3.Enumerables
@using CemSys3.Helpers.Enumerable
@model IEnumerable<PrecioIngresoDTO>
@{
    ViewData["Title"] = "Precios de Ingreso";
}


<style>
    table {
        border-collapse: collapse;
        width: 40%;
        font-family: Arial, sans-serif;
        font-size: 14px;
    }

    th, td {
        border: 1px solid #000;
        padding: 6px 8px;
        vertical-align: top;
    }

    th {
        text-align: center;
        font-weight: bold;
    }

    .right {
        text-align: right;
    }

    .bold {
        font-weight: bold;
    }

    /* ❌ quita bordes internos de la primera columna */
    .grupo {
        border-bottom: none;
    }

    .grupo-cont {
        border-top: none;
        border-bottom: none;
    }

    .grupo-fin {
        border-top: none;
    }

    /* 🧘 renglón vacío */
    .espacio td {
        height: 14px;
        border: none;
    }
</style>
@foreach(var tipo in Model)
{
    <div>
    <table>
        <tr>
            <th colspan="2">@(EnumHelper.GetDisplayNameByValue<TipoParcelaEnum>(tipo.TipoParcelaId).ToUpper())</th>
            <th>@DateTime.Now.Year.ToString()</th>
        </tr>

        <tr>
            <td colspan="3" class="bold">@tipo.NombreRegla</td>
        </tr>
    @foreach (var tema in tipo.Temas)
    {
        foreach(var concepto in tema.Conceptos)
        {
            <!-- CONTRIB -->
            if(concepto.ConceptoId == (int)ConceptosTarifariaEnum.PorcentajeAumentoInhumacionOtrasLocalidades && concepto.PrecioCalculado > 0)
            {
                decimal precioInhumacion = concepto.PrecioCalculado;
                        <!-- CONTRIB -->
                <tr>
                    <td class="bold grupo">Contrib:</td>
                    <td>Inhumac.</td>
                    <td class="right">$ 21,421.00</td>
                </tr>
                <tr>
                    <td class="grupo-cont"></td>
                    <td>Cierre de nicho</td>
                    <td class="right">$ 39,670.00</td>
                </tr>
                <tr>
                    <td class="grupo-cont"></td>
                    <td class="bold">Subtotal</td>
                    <td class="right bold">$ 61,091.00</td>
                </tr>
                <tr>
                    <td class="grupo-cont"></td>
                    <td>Fondo 5%</td>
                    <td class="right">$ 3,054.55</td>
                </tr>
                <tr>
                    <td class="grupo-fin"></td>
                    <td class="bold">Total</td>
                    <td class="right bold">$ 64,145.55</td>
                </tr>
            }
        }
    }

    </table>
</div>

}
<div>
    <table>
        <tr>
            <th colspan="2">NICHO</th>
            <th>2026</th>
        </tr>

        <tr>
            <td colspan="3" class="bold">Fallecidos en C. Tirolesa</td>
        </tr>

        <!-- CONTRIB -->
        <tr>
            <td class="bold grupo">Contrib:</td>
            <td>Inhumac.</td>
            <td class="right">$ 21,421.00</td>
        </tr>
        <tr>
            <td class="grupo-cont"></td>
            <td>Cierre de nicho</td>
            <td class="right">$ 39,670.00</td>
        </tr>
        <tr>
            <td class="grupo-cont"></td>
            <td class="bold">Subtotal</td>
            <td class="right bold">$ 61,091.00</td>
        </tr>
        <tr>
            <td class="grupo-cont"></td>
            <td>Fondo 5%</td>
            <td class="right">$ 3,054.55</td>
        </tr>
        <tr>
            <td class="grupo-fin"></td>
            <td class="bold">Total</td>
            <td class="right bold">$ 64,145.55</td>
        </tr>

        <tr class="espacio"><td colspan="3"></td></tr>

        <!-- REG CIVIL -->
        <tr>
            <td class="bold grupo">Reg. Civil</td>
            <td>defunc.</td>
            <td class="right">$ 4,100.00</td>
        </tr>
        <tr>
            <td class="grupo-cont"></td>
            <td>Fondo 5%</td>
            <td class="right">$ 1,000.00</td>
        </tr>
        <tr>
            <td class="grupo-fin"></td>
            <td class="bold">Total</td>
            <td class="right bold">$ 5,100.00</td>
        </tr>

        <tr class="espacio"><td colspan="3"></td></tr>

        <!-- DER DE OF -->
        <tr>
            <td class="bold grupo">Der. De Of.</td>
            <td>Introd. de cadáver</td>
