                                <form id="formPreciosContribucion" class="form-box">
                                    <input type="hidden" id="tarifarioIdContribucion" value="@((int)TemaTarifariaEnum.Inhumacion)" />

                                    @if (Model.ListadoPrecios != null && Model.ListadoPrecios.Any())
                                    {
                                        <div class="card shadow-sm">
                                            <div class="card-body p-0">
                                                <table class="table table-hover mb-0">
                                                    <thead class="table-light">
                                                        <tr>
                                                            <th>Concepto</th>
                                                            <th>Precio</th>
                                                        </tr>
                                                    </thead>
                                                    <tbody>
                                                        @{
                                                            //concepto Contribucion
                                                            var conceptosContribucion = Model.ListadoPrecios
                                                            .Where(p => p.TemaId == (int)TemaTarifariaEnum.Inhumacion)
                                                            .OrderBy(p => p.NombreConcepto)
                                                            .ToList();
                                                        }

                                                        @foreach (var precio in conceptosContribucion)
                                                        {
                                                            <tr>
                                                                <td>@precio.NombreConcepto.ToUpper()</td>
                                                                <td>
                                                                    <div class="input-group">
                                                                        <span class="input-group-text">$</span>
                                                                        <input type="number"
                                                                               class="form-control precio-input"
                                                                               data-precio-id="@precio.Id"
                                                                               data-concepto-id="@precio.ConceptoTarifariaId"
                                                                               value="@precio.Precio.ToString(System.Globalization.CultureInfo.InvariantCulture)"
                                                                               step="0.01"
                                                                               min="0"
                                                                               placeholder="0.00" />
                                                                    </div>
                                                                </td>
                                                            </tr>
                                                        }

                                                        @if (!conceptosContribucion.Any())
                                                        {
                                                            <tr>
                                                                <td colspan="2" class="text-center text-muted py-4">
                                                                    <i class="fas fa-info-circle"></i>
                                                                    No hay conceptos de inhumación configurados para esta tarifaria.
                                                                </td>
                                                            </tr>
                                                        }
                                                    </tbody>
                                                </table>
                                            </div>

                                            @if (conceptosContribucion.Any())
                                            {
                                                <div class="card-footer">
                                                    <div class="d-flex justify-content-end">
                                                        <button type="button" class="btn btn-success btn-guardar-precios" data-form-id="formPreciosContribucion">
