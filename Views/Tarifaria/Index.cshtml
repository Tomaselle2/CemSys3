<!-- Formulario precios de fosas-->
<div class="accordion" id="accordionFosa">
    @* ID único para el acordeón principal *@
    <div class="accordion-item">
        <h2 class="accordion-header" id="panelsFosa-headingOne">
            <button class="accordion-button nueva-seccion" type="button" data-bs-toggle="collapse" data-bs-target="#panelsFosa-collapseOne" aria-expanded="false" aria-controls="panelsFosa-collapseOne">
                Precios concesión fosa
            </button>
        </h2>
        <div id="panelsFosa-collapseOne" class="accordion-collapse collapse" aria-labelledby="panelsFosa-headingOne" data-bs-parent="#accordionFosa">
            @* Agregado data-bs-parent y 'show' para que inicie abierto si lo deseas *@
            <div class="accordion-body" style="padding: 0">
                <form id="formFosa" class="form-box">
                    @* ID único para el formulario *@
                    <input type="hidden" id="tarifarioIdGenerales" value="@((int)TemaTarifariaEnum.ConcesionFosa)" /> @* ID único para el campo oculto *@

                    @if (Model.ListadoPrecios != null && Model.ListadoPrecios.Any())
                    {
                        <div class="card shadow-sm">
                            <div class="card-body p-0">
                                <table class="table table-hover mb-0">
                                    <thead class="table-light">
                                        <tr>
                                            <th>Concepto</th>
                                            <th>Precio</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @{
                                            var conceptosFosa = Model.ListadoPrecios
                                            .Where(p => p.TemaId == (int)TemaTarifariaEnum.ConcesionFosa)
                                            .OrderBy(p => p.NombreConcepto)
                                            .ToList();
                                        }

                                        @foreach (var precio in conceptosFosa)
                                        {
                                            <tr>
                                                <td>
                                                    @(precio.AniosConcesionId.HasValue
                                                        ? EnumHelper.GetDisplayNameByValue<AniosConcesionEnum>(precio.AniosConcesionId.Value)
                                                    : "")
