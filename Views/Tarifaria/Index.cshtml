                                                               step="0.01"
                                                               min="0"
                                                               placeholder="0.00" />
                                                    </div>
                                                </td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>

                            @if (conceptosFosa.Any())
                            {
                                <div class="card-footer">
                                    <div class="d-flex justify-content-end">
                                        <button type="button" class="btn btn-success btn-guardar-precios" data-form-id="formFosa">
                                            @* Clase común y data-form-id *@
                                            <i class="fas fa-save"></i> Guardar Cambios
                                        </button>
                                    </div>
                                </div>
                            }
                        </div>
                    }
                    else
                    {
                        <div class="alert alert-info" role="alert">
                            <i class="fas fa-info-circle"></i>
                            No hay precios configurados para esta tarifaria.
                        </div>
                    }
                </form>
            </div>
        </div>
    </div>
</div>


<!-- Formulario precios nichos especiales -->
<div class="accordion" id="accordionNichoEspecial">
    <div class="accordion-item">
        <h2 class="accordion-header" id="panelsNichoEspecial-headingOne">
            <button class="accordion-button nueva-seccion" type="button" data-bs-toggle="collapse"
                    data-bs-target="#panelsNichoEspecial-collapseOne" aria-expanded="false">
                Nichos Especiales
            </button>
        </h2>
        <div id="panelsNichoEspecial-collapseOne" class="accordion-collapse collapse"
             aria-labelledby="panelsNichoEspecial-headingOne" data-bs-parent="#accordionNichoEspecial">
            <div class="accordion-body" style="padding:0">
                <form id="formNichoEspecial" class="form-box">
                    @Html.AntiForgeryToken()
                    @{
                        var aniosEspeciales = new[] { 25, 15, 10, 5 };
                        var preciosEspeciales = Model.ListadoPrecios
                            .Where(p => p.ConceptoTarifariaId == (int)ConceptosTarifariaEnum.ConcesionNicho
                                     && p.SeccionId == null)
                            .ToList();
                    }
                    <table class="table table-bordered mb-0">
                        <thead>
                            <tr>
                                <th style="width:120px;"></th>
                                @foreach (var anio in aniosEspeciales)
                                {
                                    <th class="text-center">@anio años</th>
                                }
                            </tr>
                        </thead>
                        <tbody>
