                                                               data-precio-id="@precio.Id"
                                                               data-concepto-id="@precio.ConceptoTarifariaId"
                                                               value="@precio.Precio.ToString(System.Globalization.CultureInfo.InvariantCulture)"
                                                               step="0.01"
                                                               min="0"
                                                               placeholder="0.00" />
                                                    </div>
                                                </td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>

                            @if (conceptosFosa.Any())
                            {
                                <div class="card-footer">
                                    <div class="d-flex justify-content-end">
                                        <button type="button" class="btn btn-success btn-guardar-precios" data-form-id="formFosa">
                                            @* Clase común y data-form-id *@
                                            <i class="fas fa-save"></i> Guardar Cambios
                                        </button>
                                    </div>
                                </div>
                            }
                        </div>
                    }
                    else
                    {
                        <div class="alert alert-info" role="alert">
                            <i class="fas fa-info-circle"></i>
                            No hay precios configurados para esta tarifaria.
                        </div>
                    }
                </form>
            </div>
        </div>
    </div>
</div>




<!-- Formulario precios nichos -->
<div class="accordion" id="accordionNichosPrincipal">
    <div class="accordion-item">

        <h2 class="accordion-header" id="headingNichos">
            <button class="accordion-button nueva-seccion"
                    type="button"
                    data-bs-toggle="collapse"
                    data-bs-target="#collapseNichosPrincipal"
                    aria-expanded="false">
                Secciones – Nichos
            </button>
        </h2>

        <div id="collapseNichosPrincipal" class="accordion-collapse collapse" aria-labelledby="headingNichos"
             data-bs-parent="#accordionNichosPrincipal">
            <div class="accordion-body p-0">

                <div class="accordion" id="accordionSubNichos">
                @foreach (var seccion in Model.ListadoSeccionesNicho)
                {
                    var filas = seccion.Filas;

                    var preciosSeccion = Model.ListadoPrecios
                        .Where(p => p.SeccionId == seccion.Id &&
                                    p.TemaId == (int)TemaTarifariaEnum.ConcesionNicho)
                        .ToList();

                    <div class="d-flex align-items-stretch mb-2">

                    <input type="checkbox"
                           class="form-check-input me-2 mt-3"
                           name="seccionesSeleccionadas"
                           data-id-seccion="@seccion.Id"
                           data-filas-seccion="@filas" />

                    <div class="accordion w-100">
                        <div class="accordion-item">

                            <h2 class="accordion-header">
                                <button class="accordion-button collapsed"
                                        type="button"
                                        data-bs-toggle="collapse"
                                        data-bs-target="#seccion-@seccion.Id">
                                    @seccion.Nombre (@filas filas) 
                                </button>
                            </h2>
                            <div id="seccion-@seccion.Id" class="accordion-collapse collapse">
                                <div class="accordion-body p-0">
                                <form id="formSeccion-@seccion.Id" class="form-box">
                                    @Html.AntiForgeryToken()
                                    <table class="table table-bordered mb-0">

                                        <thead>
                                            <tr>
                                                <th style="width:120px;"></th>
                                                @foreach (var anio in aniosOrdenados)
                                                {
                                                    <th class="text-center">@anio años</th>
                                                }
                                            </tr>
                                        </thead>

                                        <tbody>
                                            @for (int fila = filas; fila >= 1; fila--)
                                            {
                                                <tr>
                                                    <td class="fw-bold text-center">Fila @fila</td>

                                                    @foreach (var anio in aniosOrdenados)
                                                    {
                                                        var precio = preciosSeccion.FirstOrDefault(p =>
                                                        p.NroFila == fila &&
                                                        p.AniosConcesionId == mapaAnios[anio]);

                                                        <td>
                                                            <div class="input-group input-group-sm">
                                                                <span class="input-group-text">$</span>
                                                                <input type="number"
                                                                        class="form-control precio-input text-center"
                                                                        data-precio-id="@(precio?.Id ?? 0)"
                                                                        data-seccion-id="@seccion.Id"
                                                                        data-nro-fila="@fila"
                                                                        data-anios-concesion="@anio"
                                                                        data-concepto-id="@(precio?.ConceptoTarifariaId ?? 0)"
                                                                        value="@(precio?.Precio.ToString("0.00"))"
                                                                        step="0.01"
                                                                        min="0" 
                                                                        placeholder="0.00" />
                                                            </div>
                                                        </td>
                                                    }
                                                </tr>
                                            }
                                        </tbody>
                                    </table>
                                                <div class="card-footer p-3">
                                                    <div class="d-flex justify-content-end">
                                                        <button type="button" class="btn btn-success btn-guardar-precios" data-form-id="formSeccion-@seccion.Id">
                                                            <i class="fas fa-save"></i> Guardar Cambios
                                                        </button>
                                                    </div>
                                                </div>
                                </form>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            }
                    <div class="d-flex justify-content-end p-3">
                        <button type="button"
                                class="btn btn-outline-dark"
                                id="btnCombinarPrecios"
                                disabled>
                            <i class="fas fa-save"></i> Combinar precios
                        </button>
                    </div>
                </div>
            </div>
        </div>

    </div>
</div>




