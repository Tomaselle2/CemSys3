@* Renderizamos el manejador pasándole el DTO del modelo *@
<partial name="_SweetAlertHandler" model="Model.SweetAlert" />

@section Scripts{
   <script>

       // ── MAPA de años → AniosConcesionId (igual al enum en C#) ──────────────
        const mapaAniosAConcesionId = {
            25: 5,   // AniosConcesionEnum.anio25 = 5
            15: 4,   // AniosConcesionEnum.anio15 = 4
            10: 3,   // AniosConcesionEnum.anio10 = 3
             5: 2,   //  AniosConcesionEnum.anio5 = 2
             1: 1    // AniosConcesionEnum.anio1  = 1
        };

        // Ejecutar al cargar para validar estado inicial del botón
        actualizarEstadoBotonCombinar();

        // Función para combinar los precios
        document.addEventListener('DOMContentLoaded', function () {
            const btnCombinar = document.getElementById('btnCombinarPrecios');

            if (btnCombinar) {
                btnCombinar.addEventListener('click', function (event) {
                    event.stopImmediatePropagation();
                    event.preventDefault();
                    console.log('Botón Combinar precios presionado');

                    var listaSeccionesSeleccionadas = obtenerSeccionesSeleccionadas();
                    console.log(listaSeccionesSeleccionadas);


                    if (todasLasFilasSonIguales(listaSeccionesSeleccionadas)) {
                        console.log("todas son iguales");

                        // Generar la tabla y mostrar el modal
                        generarTablaModalPrecios(listaSeccionesSeleccionadas);
                        var modal = new bootstrap.Modal(document.getElementById('modalCombinarPrecios'));
                        modal.show();

                        // AGREGAR EL EVENT LISTENER DESPUÉS DE MOSTRAR EL MODAL
                        const btnGuardar = document.getElementById('btnGuardarPreciosCombinados');
                        if (btnGuardar) {
                            btnGuardar.replaceWith(btnGuardar.cloneNode(true));
                            document.getElementById('btnGuardarPreciosCombinados').addEventListener('click', guardarPreciosCombinados);
                        }
                    } else {
                        // Mostrar el mensaje con la vista
                        AlertService.show('Error', 'Las secciones deben tener la misma cantidad de filas para combinar precios', 'error');
                    }
                });
            }
        });

        // Verifica que todas las filas sean iguales
        function todasLasFilasSonIguales(listaSecciones) {
            if (listaSecciones.length === 0) return false;

            const filasReferencia = listaSecciones[0].filas;

            return listaSecciones.every(seccion => seccion.filas === filasReferencia);
        }

        // Función para obtener las secciones seleccionadas
        function obtenerSeccionesSeleccionadas() {
            var seccionesSeleccionadas = document.querySelectorAll('input[name="seccionesSeleccionadas"]:checked');
            var datosSeccion = Array.from(seccionesSeleccionadas).map(cb => {
                return {
                    id: parseInt(cb.dataset.idSeccion),
                    filas: parseInt(cb.dataset.filasSeccion)
                }
            });
            return datosSeccion;
        }

        // Habilita o deshabilita el botón según la cantidad de secciones seleccionadas
        function actualizarEstadoBotonCombinar() {
            const btnCombinar = document.getElementById('btnCombinarPrecios');
            const lista = obtenerSeccionesSeleccionadas();

            if (btnCombinar) {
                btnCombinar.disabled = (lista.length < 2);
            }
        }

        // Agregar el evento a todos los checkboxes
        document.querySelectorAll('input[name="seccionesSeleccionadas"]').forEach(function (checkbox) {
            checkbox.addEventListener('change', actualizarEstadoBotonCombinar)
        });

        function generarTablaModalPrecios(seccionesSeleccionadas) {
            // Todas las secciones tienen la misma cantidad de filas
            let filas = seccionesSeleccionadas[0].filas;
            let anios = [25, 15, 10, 5];
            let inputOriginal = document.querySelector(`.precio-input[data-seccion-id="${seccionesSeleccionadas[0].id}"]`);
            let conceptoTarifariaId = inputOriginal ? inputOriginal.dataset.conceptoId : 0;

            // Construye la tabla
            let html = `<table class="table table-hover mb-0">
                        <thead class="table-light">
                            <tr>
                                <th>Fila</th>`;
            anios.forEach(anio => html += `<th>${anio} años</th>`);
            html += `</tr></thead><tbody>`;

            for (let fila = filas; fila >= 1; fila--) {
                html += `<tr>
                            <td>Fila ${fila}</td>`;
                anios.forEach(anio => {
                    html += `<td>
                                <div class="input-group input-group-sm">
                                    <span class="input-group-text">$</span>
                                    <input type="number"
                                        class="form-control precio-input-modal text-center"
                                        data-nro-fila="${fila}"
                                        data-anios-concesion="${anio}"
                                        data-concepto-id="${conceptoTarifariaId}"
                                        value="0.00"
                                        step="0.01"
                                        min="0"
                                        placeholder="0.00"
                                        style="font-size: 0.875rem;" />
                                </div>
                            </td>`;
                });
                html += `</tr>`;
            }

            html += `</tbody></table>`;

            document.getElementById('contenedorTablaCombinarPrecios').innerHTML = html;
        }

        // Función para guardar los precios combinados
                function guardarPreciosCombinados() {
            let precios = [];
            let seccionesSeleccionadas = obtenerSeccionesSeleccionadas();

            document.querySelectorAll('.precio-input-modal').forEach(input => {
                const rawValue = input.value.replace(',', '.');
                const precio   = parseFloat(rawValue) || 0;

                const nroFila           = parseInt(input.dataset.nroFila);
                const aniosRaw          = parseInt(input.dataset.aniosConcesion);
                const aniosConcesionId  = mapaAniosAConcesionId[aniosRaw] ?? null;
                const conceptoId        = parseInt(input.dataset.conceptoId || 0);

                seccionesSeleccionadas.forEach(seccion => {
                    const inputOriginal = document.querySelector(
                        `.precio-input[data-seccion-id="${seccion.id}"][data-nro-fila="${nroFila}"][data-anios-concesion="${aniosRaw}"]`
                    );
                    const idPrecio = inputOriginal ? parseInt(inputOriginal.dataset.precioId) : 0;

                    precios.push({
                        Id:                  idPrecio,
                        SeccionId:           seccion.id,
                        NroFila:             nroFila,
                        AniosConcesionId:    aniosConcesionId,
                        Precio:              precio,
                        ConceptoTarifariaId: conceptoId
                    });
                });
            });

            fetch('@Url.Action("ActualizarPreciosTarifaria", "Tarifaria")', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json',
                    'RequestVerificationToken': document.querySelector('input[name="__RequestVerificationToken"]')?.value || ''
                },
                body: JSON.stringify(precios)
            })
            .then(r => r.json())
            .then(result => {
                if (result.success) {
                    AlertService.show('Éxito', result.message, 'success');
                    actualizarInputsOriginales(precios);

                    var modal = bootstrap.Modal.getInstance(document.getElementById('modalCombinarPrecios'));
                    modal.hide();

                    document.querySelectorAll('input[name="seccionesSeleccionadas"]:checked')
                        .forEach(cb => cb.checked = false);
                    actualizarEstadoBotonCombinar();
                } else {
                    AlertService.show('Error', result.message, 'error');
                }
            })
            .catch(() => AlertService.show('Error de conexión', 'Por favor, intente nuevamente.', 'error'));
        }

        // Actualizar los inputs originales en la página
        function actualizarInputsOriginales(preciosActualizados) {
            preciosActualizados.forEach(precio => {
                // Buscar el input original correspondiente
                let inputOriginal = document.querySelector(
                    `.precio-input[data-seccion-id="${precio.SeccionId}"][data-nro-fila="${precio.NroFila}"][data-anios-concesion="${precio.AniosConcesion}"]`
                );

                if (inputOriginal) {
                    // Actualizar el valor del input
                    inputOriginal.value = precio.Precio.toFixed(2);

                    // Opcional: Agregar un efecto visual para indicar que se actualizó
                    inputOriginal.classList.add('border-success');
                    setTimeout(() => {
                        inputOriginal.classList.remove('border-success');
                    }, 2000);
                }
            });
        }

        // Script para guardar precios individuales
        document.addEventListener('DOMContentLoaded', function () {
            // Selecciona todos los botones con la clase 'btn-guardar-precios'
            const btnsGuardar = document.querySelectorAll('.btn-guardar-precios');

            // Itera sobre cada botón y agrega un event listener
            btnsGuardar.forEach(btn => {
                btn.addEventListener('click', function (event) {
                    // 'this' se refiere al botón clickeado
                    const formId = this.dataset.formId;
                    const formElement = document.getElementById(formId);

                    if (formElement) {
                        actualizarPrecios(formElement, this);
                    } else {
                        console.error('No se encontró el formulario con ID:', formId);
                    }
                });
            });
        });

        // La función ahora recibe el formulario específico y el botón que la llamó
                async function actualizarPrecios(formElement, clickedButton) {
            const precios = [];
            let todosValidos = true;

            formElement.querySelectorAll('.precio-input').forEach(input => {
                // Leer el valor como string y normalizar: reemplazar coma por punto
                const rawValue = input.value.replace(',', '.');
                const precio = parseFloat(rawValue) || 0;

                if (precio < 0) {
                    todosValidos = false;
                    input.classList.add('is-invalid');
                } else {
                    input.classList.remove('is-invalid');
                }

                // Leer los datos del input
                const precioId          = parseInt(input.dataset.precioId)   || 0;
                const conceptoId        = parseInt(input.dataset.conceptoId) || 0;
                const seccionId         = input.dataset.seccionId   ? parseInt(input.dataset.seccionId)   : null;
                const nroFila           = input.dataset.nroFila     ? parseInt(input.dataset.nroFila)     : null;
                // data-anios-concesion tiene los AÑOS (25, 15, 10, 5)
                // hay que convertirlos al ID del enum antes de mandar
                const aniosRaw          = input.dataset.aniosConcesion ? parseInt(input.dataset.aniosConcesion) : null;
                const aniosConcesionId  = aniosRaw != null ? (mapaAniosAConcesionId[aniosRaw] ?? null) : null;

                precios.push({
                    Id:                  precioId,
                    ConceptoTarifariaId: conceptoId,
                    Precio:              precio,
                    SeccionId:           seccionId,
                    NroFila:             nroFila,
                    AniosConcesionId:    aniosConcesionId
                });
            });

            if (!todosValidos) {
                AlertService.show('Error de validación', 'Por favor, ingrese valores válidos para todos los precios.', 'error');
                return;
            }

            const requestVerificationToken =
                formElement.querySelector('input[name="__RequestVerificationToken"]')?.value || '';

            clickedButton.disabled = true;
            clickedButton.innerHTML = '<i class="fas fa-spinner fa-spin"></i> Guardando...';

            try {
                const response = await fetch('@Url.Action("ActualizarPreciosTarifaria", "Tarifaria")', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                        'RequestVerificationToken': requestVerificationToken
                    },
                    body: JSON.stringify(precios)
                });

                if (!response.ok) throw new Error(`HTTP error! status: ${response.status}`);

                const result = await response.json();

                if (result.success) {
                    AlertService.show('Éxito', result.message, 'success');

                    // ── Actualizar data-precio-id si el server devuelve los nuevos IDs ──
                    // Si tu endpoint devuelve result.nuevosIds (ver abajo), actualizamos
                    // los inputs para que la próxima vez sean UPDATE y no INSERT
                    if (result.nuevosIds && Array.isArray(result.nuevosIds)) {
                        result.nuevosIds.forEach(item => {
                            const selector = [
                                `.precio-input[data-seccion-id="${item.seccionId}"]`,
                                `[data-nro-fila="${item.nroFila}"]`,
                                `[data-anios-concesion="${item.aniosRaw}"]`
                            ].join('');
                            const inp = formElement.querySelector(selector);
                            if (inp) inp.dataset.precioId = item.id;
                        });
                    }
                } else {
                    AlertService.show('Error', result.message, 'error');
                }

            } catch (error) {
                AlertService.show('Error de conexión', 'Por favor, intente nuevamente.', 'error');
                console.error('Error:', error);
            } finally {
                clickedButton.disabled = false;
                clickedButton.innerHTML = '<i class="fas fa-save"></i> Guardar Cambios';
            }
        }


   </script>

   <script>

               document.addEventListener('DOMContentLoaded', function () {
            // Selecciona todos los botones con la clase 'btn-guardar-precios'
            const btnsGuardar = document.querySelectorAll('.btn-guardar-precios');

            // Itera sobre cada botón y agrega un event listener
            btnsGuardar.forEach(btn => {
                btn.addEventListener('click', function (event) {
                    // 'this' se refiere al botón clickeado
                    const formId = this.dataset.formId; // Obtiene el ID del formulario desde el atributo data-form-id
                    const formElement = document.getElementById(formId); // Obtiene el elemento del formulario

                    if (formElement) {
                        // Llamamos a actualizarPrecios pasando el formulario y el botón clickeado
                        // para que pueda extraer los datos relevantes de ESE formulario
                        actualizarPrecios(formElement, this);
                    } else {
                        console.error('No se encontró el formulario con ID:', formId);
                    }
                });
            });
        });

        // La función ahora recibe el formulario específico y el botón que la llamó
        async function actualizarPrecios(formElement, clickedButton) {
            const precios = [];
            let todosValidos = true;


            // Recopilar solo los precios de los inputs dentro de ESTE formulario
            const inputsPrecios = formElement.querySelectorAll('.precio-input');
            inputsPrecios.forEach(input => {
                const precio = parseFloat(input.value) || 0;

                if (precio < 0) {
                    todosValidos = false;
                    input.classList.add('is-invalid');
                } else {
                    input.classList.remove('is-invalid');
                }

                precios.push({
                    Id: parseInt(input.dataset.precioId),
                    ConceptoTarifariaId: parseInt(input.dataset.conceptoId),
                    Precio: precio
                });
            });

            if (!todosValidos) {
                AlertService.show('Error de validación', 'Por favor, ingrese valores válidos para todos los precios.', 'error');
                return;
            }


            const requestVerificationToken = formElement.querySelector('input[name="__RequestVerificationToken"]')?.value || '';

            // Mostrar loading en el botón específico que fue clickeado
            clickedButton.disabled = true;
            clickedButton.innerHTML = '<i class="fas fa-spinner fa-spin"></i> Guardando...';

            try {
                // Realizar la llamada con fetch
                const response = await fetch('@Url.Action("ActualizarPreciosTarifaria", "Tarifaria")', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                        'RequestVerificationToken': requestVerificationToken
                    },
                    // ¡Importante! Aquí enviamos directamente el array de precios,
                    // sin envolverlo en un objeto con 'tarifarioId'.
                    body: JSON.stringify(precios)
                });

                if (!response.ok) {
                    throw new Error(`HTTP error! status: ${response.status}`);
                }

                const result = await response.json();

                if (result.success) {
                    AlertService.show('Éxito', result.message, 'success');
                } else {
                    AlertService.show('Error', result.message, 'error');
                }

            } catch (error) {
                AlertService.show('Error de conexión', 'Por favor, intente nuevamente.', 'error');
                console.error('Error:', error);
            } finally {
                // Restaurar el botón clickeado
                clickedButton.disabled = false;
                clickedButton.innerHTML = '<i class="fas fa-save"></i> Guardar Cambios';
            }
        }
   </script>

   <script>
               // ====== AUMENTO TARIFARIA ======
        let preciosParaAumentar = [];

        document.getElementById('btnPreviewAumento').addEventListener('click', async function () {
            const pct = parseFloat(document.getElementById('inputPorcentaje').value);
            const dec = parseInt(document.getElementById('selectDecimales').value);

            if (!pct || pct <= 0) {
                AlertService.show('Error', 'Ingresá un porcentaje mayor a 0.', 'error');
                return;
            }

            this.disabled = true;
            this.innerHTML = '<i class="bi bi-hourglass-split"></i> Calculando...';

            try {
                const res = await fetch(`@Url.Action("PreviewAumento", "Tarifaria")?porcentaje=${pct}&decimales=${dec}`);
                const result = await res.json();

                if (!result.success) {
                    AlertService.show('Error', result.message, 'error');
                    return;
                }

                preciosParaAumentar = result.data;
                renderPreviewAumento(result.data, pct);
                document.getElementById('previewAumentoContainer').style.display = 'block';
                document.getElementById('btnAplicarAumento').classList.remove('d-none');

            } catch (e) {
                AlertService.show('Error', 'No se pudo obtener el preview.', 'error');
            } finally {
                this.disabled = false;
                this.innerHTML = '<i class="bi bi-eye"></i> Previsualizar';
            }
        });

        function renderPreviewAumento(data, pct) {
            // Summary cards
            const totalAumento = data.reduce((s, p) => s + (p.precioNuevo - p.precioActual), 0);
            document.getElementById('summaryAumento').innerHTML = `
                <div class="col-6 col-md-3">
                    <div class="card text-center py-2">
                        <div class="text-muted small">Porcentaje</div>
                        <div class="fs-5 fw-semibold">${pct.toFixed(2)}%</div>
                    </div>
                </div>
                <div class="col-6 col-md-3">
                    <div class="card text-center py-2">
                        <div class="text-muted small">Conceptos</div>
                        <div class="fs-5 fw-semibold">${data.length}</div>
                    </div>
                </div>
                <div class="col-6 col-md-3">
                    <div class="card text-center py-2">
                        <div class="text-muted small">Aumento total</div>
                        <div class="fs-5 fw-semibold text-success">+$${totalAumento.toLocaleString('es-AR', {minimumFractionDigits:2})}</div>
                    </div>
                </div>
            `;

            // Agrupar por tema
            const grupos = {};
            data.forEach(p => {
                if (!grupos[p.temaId]) grupos[p.temaId] = { nombre: p.nombreConcepto, items: [] };
                grupos[p.temaId].items.push(p);
            });

            // Agrupar por TemaId (usamos el primer nombre para la sección — mejor usar temaNombre del DTO)
            const porTema = {};
            data.forEach(p => {
                const key = p.temaId;
                if (!porTema[key]) porTema[key] = [];
                porTema[key].push(p);
            });

            const temasNombres = {
                1: 'General', 2: 'Inhumación', 3: 'Concesión nicho',
                4: 'Concesión fosa', 5: 'Registro civil', 6: 'Derecho de oficina'
            };

            let html = '';
            Object.entries(porTema).forEach(([temaId, items]) => {
                html += `
                <h6 class="mt-3 mb-1 text-muted text-uppercase" style="font-size:11px;letter-spacing:.05em">
                    ${temasNombres[temaId] ?? 'Otros'} <span class="badge bg-secondary">${items.length}</span>
                </h6>
                <table class="table table-sm table-hover table-bordered mb-2">
                    <thead class="table-light">
                        <tr>
                            <th>Concepto</th>
                            <th class="text-end">Precio actual</th>
                            <th class="text-end text-success">Precio nuevo</th>
                            <th class="text-end">Aumento</th>
                        </tr>
                    </thead>
                    <tbody>`;

                items.forEach(p => {
                    const diff = p.precioNuevo - p.precioActual;
                    html += `<tr>
                        <td>${p.nombreConcepto}</td>
                        <td class="text-end text-muted">$${p.precioActual.toLocaleString('es-AR',{minimumFractionDigits:2})}</td>
                        <td class="text-end text-success fw-semibold">$${p.precioNuevo.toLocaleString('es-AR',{minimumFractionDigits:2})}</td>
                        <td class="text-end text-success">+$${diff.toLocaleString('es-AR',{minimumFractionDigits:2})}</td>
                    </tr>`;
                });

                html += `</tbody></table>`;
            });

            document.getElementById('tablaAumentoContenido').innerHTML = html;
        }

        document.getElementById('btnAplicarAumento').addEventListener('click', async function () {
            const pct = parseFloat(document.getElementById('inputPorcentaje').value);
            const dec = parseInt(document.getElementById('selectDecimales').value);

            this.disabled = true;
            this.innerHTML = '<i class="bi bi-hourglass-split"></i> Guardando...';

            try {
                const res = await fetch('@Url.Action("AplicarAumentoPorcentual", "Tarifaria")', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ porcentaje: pct, decimales: dec })
                });

                const result = await res.json();

                if (result.success) {
                    // Cerrar modal y recargar la página para reflejar nuevos precios
                    bootstrap.Modal.getInstance(document.getElementById('modalAumentoTarifaria')).hide();
                    AlertService.show('Éxito', result.message, 'success');
                    setTimeout(() => location.reload(), 1500);
                } else {
                    AlertService.show('Error', result.message, 'error');
                }
            } catch (e) {
                AlertService.show('Error de conexión', 'Intentá nuevamente.', 'error');
            } finally {
                this.disabled = false;
                this.innerHTML = '<i class="bi bi-check-lg"></i> Confirmar y guardar';
            }
        });

        // Limpiar preview al cambiar porcentaje o decimales
        ['inputPorcentaje','selectDecimales'].forEach(id => {
            document.getElementById(id).addEventListener('change', () => {
                document.getElementById('previewAumentoContainer').style.display = 'none';
                document.getElementById('btnAplicarAumento').classList.add('d-none');
                preciosParaAumentar = [];
            });
        });

   </script>
}