@using CemSys3.ViewModels.Tarifaria
@using CemSys3.Enumerables
@using CemSys3.Helpers.Enumerable
@model TarifariaVM

@{
    ViewData["Title"] = "Tarifaria";

    var aniosOrdenados = new[] { 25, 15, 10, 5 };

    var mapaAnios = new Dictionary<int, int>
    {
        { 25, (int)AniosConcesionEnum.anio25 },
        { 15, (int)AniosConcesionEnum.anio15 },
        { 10, (int)AniosConcesionEnum.anio10 },
        { 5,  (int)AniosConcesionEnum.anio5  }
    };
}
<div class="page-header-container">
    <a asp-action="Index" asp-controller="Configuracion" class="btn btn-secondary m-3" title="Configuración"><i class="bi bi-arrow-left"></i></a>
    <h1 class="title-page">Tarifaria</h1>
</div>
<div class="container3">

    <div class="mb-3">
        <a asp-action="GetAllPreciosIngreso" asp-controller="Tarifaria" data-no-loader class="btn btn-outline-danger" title="Descargar precios de ingreso">Ingresos <i class="bi bi-filetype-pdf"></i></a>
    </div>

    <div class="mb-3">
        <a asp-action="GetPdfPreciosNichosFosas" asp-controller="Tarifaria"
           data-no-loader class="btn btn-outline-danger" title="Descargar precios nichos y fosas">
            Nichos y Fosas <i class="bi bi-filetype-pdf"></i>
        </a>
    </div>

    <!-- Botón de aumento anual -->
    <div class="mb-3">
        <button type="button" class="btn btn-outline-primary" data-bs-toggle="modal" data-bs-target="#modalAumentoTarifaria">
            <i class="bi bi-graph-up-arrow"></i> Aplicar aumento anual
        </button>
    </div>
</div>






<p class="obligatorio">F5 para refrescar los cambios de precios</p>
<!-- Modal Aumento Tarifaria -->
<div class="modal fade" id="modalAumentoTarifaria" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-xl modal-dialog-scrollable">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title"><i class="bi bi-graph-up-arrow me-2"></i>Aumento anual de tarifaria</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <!-- Controles -->
                <div class="row g-3 mb-3 align-items-end">
                    <div class="col-md-4">
                        <label class="form-label fw-semibold">Porcentaje de aumento (%)</label>
                        <div class="input-group">
                            <input type="number" id="inputPorcentaje" class="form-control" min="0.01" max="9999" step="0.01" placeholder="Ej: 35.5">
                            <span class="input-group-text">%</span>
                        </div>
                    </div>
                    <div class="col-md-4">
                        <label class="form-label fw-semibold">Redondear precios a</label>
                        <select id="selectDecimales" class="form-select">
                            <option value="2">Centavos ($0,01)</option>
                            <option value="1">Décimos ($0,10)</option>
                            <option value="0" selected>Pesos ($1,00)</option>
                            <option value="-1">Decenas ($10,00)</option>
                            <option value="-2">Centenas ($100,00)</option>
                        </select>
                    </div>
                    <div class="col-md-4">
                        <button type="button" class="btn btn-outline-secondary w-100" id="btnPreviewAumento">
                            <i class="bi bi-eye"></i> Previsualizar
                        </button>
                    </div>
                </div>

                <!-- Nota exclusión fondo -->
                <div class="alert alert-info py-2 small">
                    <i class="bi bi-info-circle me-1"></i>
                    Los conceptos de <strong>Fondo de ayuda</strong> (porcentajes y montos mínimos)
                    <strong>no se modifican</strong> — los gestionás manualmente.
                </div>

                <!-- Tabla de preview -->
                <div id="previewAumentoContainer" style="display:none">
                    <div class="row g-2 mb-3" id="summaryAumento"></div>
                    <div id="tablaAumentoContenido"></div>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
                <button type="button" class="btn btn-success d-none" id="btnAplicarAumento">
                    <i class="bi bi-check-lg"></i> Confirmar y guardar
                </button>
            </div>
        </div>
    </div>
</div>











<!-- Formulario precios generales-->
<div class="accordion" id="accordionGenerales">
    @* ID único para el acordeón principal *@
    <div class="accordion-item">
        <h2 class="accordion-header" id="panelsGenerales-headingOne">
            <button class="accordion-button nueva-seccion" type="button" data-bs-toggle="collapse" data-bs-target="#panelsGenerales-collapseOne" aria-expanded="false" aria-controls="panelsGenerales-collapseOne">
                Generales
            </button>
        </h2>
        <div id="panelsGenerales-collapseOne" class="accordion-collapse collapse" aria-labelledby="panelsGenerales-headingOne" data-bs-parent="#accordionGenerales">
            @* Agregado data-bs-parent y 'show' para que inicie abierto si lo deseas *@
            <div class="accordion-body" style="padding: 0">
                <form id="formPreciosGenerales" class="form-box">
                    @* ID único para el formulario *@
                    <input type="hidden" id="tarifarioIdGenerales" value="@((int)TemaTarifariaEnum.General)" /> @* ID único para el campo oculto *@

                    @if (Model.ListadoPrecios != null && Model.ListadoPrecios.Any())
                    {
                        <div class="card shadow-sm">
                            <div class="card-body p-0">
                                <table class="table table-hover mb-0">
                                    <thead class="table-light">
                                        <tr>
                                            <th>Concepto</th>
                                            <th>Precio</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @{
                                            var conceptosGenerales = Model.ListadoPrecios
                                            .Where(p => p.TemaId == (int)TemaTarifariaEnum.General)
                                            .OrderBy(p => p.NombreConcepto)
                                            .ToList();
                                        }

                                        @foreach (var precio in conceptosGenerales)
                                        {
                                            <tr>
                                                <td>@precio.NombreConcepto.ToUpper()</td>
                                                <td>
                                                    <div class="input-group">
                                                        <span class="input-group-text">$</span>
                                                        <input type="number"
                                                               class="form-control precio-input" @* Clase común *@
                                                               data-precio-id="@precio.Id"
                                                               data-concepto-id="@precio.ConceptoTarifariaId"
                                                               value="@precio.Precio.ToString(System.Globalization.CultureInfo.InvariantCulture)"
                                                               step="0.01"
                                                               min="0"
                                                               placeholder="0.00" />
                                                    </div>
                                                </td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>

                            @if (conceptosGenerales.Any())
                            {
                                <div class="card-footer">
                                    <div class="d-flex justify-content-end">
                                        <button type="button" class="btn btn-success btn-guardar-precios" data-form-id="formPreciosGenerales">
                                            @* Clase común y data-form-id *@
                                            <i class="fas fa-save"></i> Guardar Cambios
                                        </button>
                                    </div>
                                </div>
                            }
                        </div>
                    }
                    else
                    {
                        <div class="alert alert-info" role="alert">
                            <i class="fas fa-info-circle"></i>
                            No hay precios configurados para esta tarifaria.
                        </div>
                    }
                </form>
            </div>
        </div>
    </div>
</div>



<!-- Formulario precios ingreso-->
<div class="accordion" id="accordionPrincipal">
    @* Cambiamos el ID del acordeón principal a algo más genérico *@
    <div class="accordion-item">
        <h2 class="accordion-header" id="panelsIntroduccion-headingOne">
            <button class="accordion-button nueva-seccion" type="button" data-bs-toggle="collapse" data-bs-target="#panelsIntroduccion-collapseOne" aria-expanded="false" aria-controls="panelsIntroduccion-collapseOne">
                Ingreso
            </button>
        </h2>
        <div id="panelsIntroduccion-collapseOne" class="accordion-collapse collapse " aria-labelledby="panelsIntroduccion-headingOne" data-bs-parent="#accordionPrincipal">
            @* Este es el padre del acordeón de Introducción *@
            <div class="accordion-body" style="padding: 0">
                @* **CONTENEDOR DE SUB-ACORDEONES** *@
                <div class="accordion" id="accordionSubconjuntosIntroduccion">
                    @* Nuevo acordeón padre para los subconjuntos *@

                    <div class="accordion-item">
                        <h2 class="accordion-header" id="panelsContribucion-headingOne">
                            <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#panelsContribucion-collapseOne" aria-expanded="false" aria-controls="panelsContribucion-collapseOne">
                                Inhumación
                            </button>
                        </h2>
                        <div id="panelsContribucion-collapseOne" class="accordion-collapse collapse" aria-labelledby="panelsContribucion-headingOne" data-bs-parent="#accordionSubconjuntosIntroduccion">
                            @* Apunta al nuevo padre *@
                            <div class="accordion-body" style="padding: 0">
                                <form id="formPreciosContribucion" class="form-box">
                                    <input type="hidden" id="tarifarioIdContribucion" value="@((int)TemaTarifariaEnum.Inhumacion)" />

                                    @if (Model.ListadoPrecios != null && Model.ListadoPrecios.Any())
                                    {
                                        <div class="card shadow-sm">
                                            <div class="card-body p-0">
                                                <table class="table table-hover mb-0">
                                                    <thead class="table-light">
                                                        <tr>
                                                            <th>Concepto</th>
                                                            <th>Precio</th>
                                                        </tr>
                                                    </thead>
                                                    <tbody>
                                                        @{
                                                            //concepto Contribucion
                                                            var conceptosContribucion = Model.ListadoPrecios
                                                            .Where(p => p.TemaId == (int)TemaTarifariaEnum.Inhumacion)
                                                            .OrderBy(p => p.NombreConcepto)
                                                            .ToList();
                                                        }

                                                        @foreach (var precio in conceptosContribucion)
                                                        {
                                                            <tr>
                                                                <td>@precio.NombreConcepto.ToUpper()</td>
                                                                <td>
                                                                    <div class="input-group">
                                                                        <span class="input-group-text">$</span>
                                                                        <input type="number"
                                                                               class="form-control precio-input"
                                                                               data-precio-id="@precio.Id"
                                                                               data-concepto-id="@precio.ConceptoTarifariaId"
                                                                               value="@precio.Precio.ToString(System.Globalization.CultureInfo.InvariantCulture)"
                                                                               step="0.01"
                                                                               min="0"
                                                                               placeholder="0.00" />
                                                                    </div>
                                                                </td>
                                                            </tr>
                                                        }

                                                        @if (!conceptosContribucion.Any())
                                                        {
                                                            <tr>
                                                                <td colspan="2" class="text-center text-muted py-4">
                                                                    <i class="fas fa-info-circle"></i>
                                                                    No hay conceptos de inhumación configurados para esta tarifaria.
                                                                </td>
                                                            </tr>
                                                        }
                                                    </tbody>
                                                </table>
                                            </div>

                                            @if (conceptosContribucion.Any())
                                            {
                                                <div class="card-footer">
                                                    <div class="d-flex justify-content-end">
                                                        <button type="button" class="btn btn-success btn-guardar-precios" data-form-id="formPreciosContribucion">
                                                            <i class="fas fa-save"></i> Guardar Cambios
                                                        </button>
                                                    </div>
                                                </div>
                                            }
                                        </div>
                                    }
                                    else
                                    {
                                        <div class="alert alert-info" role="alert">
                                            <i class="fas fa-info-circle"></i>
                                            No hay precios configurados para esta tarifaria.
                                        </div>
                                    }
                                </form>
                            </div>
                        </div>
                    </div>

                    <div class="accordion-item">
