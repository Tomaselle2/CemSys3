@using CemSys3.Enumerables
@using CemSys3.Helpers.Enumerable
@using CemSys3.ViewModels.Tramite
@model TramiteVM

@{
    ViewData["Title"] = "Trámites";
}
<div class="page-header-container">
    <h2 class="title-page">Buscar trámite</h2>
</div>
@{
    var tiposTramite = Html.GetEnumSelectList<TipoTramiteEnum>()
        .Where(t => t.Value != ((int)TipoTramiteEnum.Nota).ToString()
                 && t.Value != ((int)TipoTramiteEnum.WordConcesiones).ToString()
        && t.Value != ((int)TipoTramiteEnum.ContratoConcesion).ToString());
}

<div class="card shadow-sm mb-3">
    <div class="card-body">
        <form asp-action="Tramites" asp-controller="Tramite" method="get" class="row g-3 align-items-end">
            <div class="col-md-3">
                <label asp-for="Filtro.TramiteId" class="form-label">Nro. Trámite</label>
                <input asp-for="Filtro.TramiteId" class="form-control" placeholder="Ej: 1024" />
            </div>
            <div class="col-md-3">
                <label asp-for="Filtro.TipoTramiteId" class="form-label">Tipo de trámite</label>
                <select asp-for="Filtro.TipoTramiteId" class="form-select" asp-items="tiposTramite">
                    <option value="">-- Todos --</option>
                </select>
            </div>
            <div class="col-md-3">
                <label asp-for="Filtro.EstadoActualId" class="form-label">Estado</label>
                <select asp-for="Filtro.EstadoActualId" class="form-select" asp-items="Html.GetEnumSelectList<EstadosTramiteEnum>()">
                    <option value="">-- Todos --</option>
                </select>
            </div>
            <div class="col-md-3">
                <label asp-for="Filtro.FechaDesde" class="form-label">Fecha desde</label>
                <input asp-for="Filtro.FechaDesde" class="form-control" type="date" />
            </div>
            <div class="col-md-3">
                <label asp-for="Filtro.FechaHasta" class="form-label">Fecha hasta</label>
                <input asp-for="Filtro.FechaHasta" class="form-control" type="date" />
            </div>

            <div class="col-12 d-flex gap-2">
                <button type="submit" class="btn btn-primary">
                    <i class="bi bi-search"></i> Buscar
                </button>
                <a asp-action="Tramites" asp-controller="Tramite" class="btn btn-outline-secondary">
                    Limpiar
                </a>
            </div>
        </form>
    </div>
</div>


<!-- Tabla de historial de tramites -->
<div class="accordion" id="accordionPanelsStayOpenExample">
    <div class="accordion-item">
        <h2 class="accordion-header" id="panelsStayOpen-headingOne">
            <button class="accordion-button nueva-seccion acordeon-fijo" type="button" data-bs-toggle="" data-bs-target="#panelsStayOpen-collapseOne" aria-expanded="false" aria-controls="panelsStayOpen-collapseOne">
                Trámites (@Model.Tramites.Count())
            </button>
        </h2>
        <div id="panelsStayOpen-collapseOne" class="accordion-collapse collapse show" aria-labelledby="panelsStayOpen-headingOne">
            @if (!string.IsNullOrEmpty(Model.MensajeTipoNoDisponible))
            {
                <div class="alert alert-warning" role="alert">
                    <i class="bi bi-exclamation-triangle"></i>
                    @Model.MensajeTipoNoDisponible
                </div>
            }
            else if (Model.Tramites.Any())
            {
                <div class="card shadow-sm">
                    <div class="card-body p-0">
                        <table class="table table-hover mb-0">
                            <thead class="table-light">
                                <tr>
                                    <th>Trámite</th>
                                    <th>Fecha inicio</th>
                                    <th>Tipo trámite</th>
                                    <th>Estado</th>
                                    <th>Nro Concesión</th>
                                    <th>Acción</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var opc in Model.Tramites)
                                {
                                    string tipoTramiteDisplay = EnumHelper.GetDisplayNameByValue<TipoTramiteEnum>(opc.TipoTramiteId);
                                    string estadoTramiteDisplay = EnumHelper.GetDisplayNameByValue<EstadosTramiteEnum>(opc.EstadoActualId);

                                    <tr>
                                        <td>@opc.Id</td>
                                        <td>@(opc.FechaCreacion.ToString("dd/MM/yyyy HH:mm"))</td>
                                        <td>@tipoTramiteDisplay</td>
                                        <td>@estadoTramiteDisplay</td>
                                        <td>@opc.NroConcesion.ToString("D5")</td>
                                        <td>
                                            <form asp-action="IrATramite" asp-controller="Tramite" target="_blank" method="get" style="display: inline-block;" data-skip-loader="true">
                                                <input type="hidden" name="tramiteId" value="@opc.Id" />
                                                <button type="submit" class="btn btn-secondary btn-sm" title="Ir al trámite">
                                                    <i class="bi bi-eye"></i>
                                                </button>
                                            </form>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            }
            else
            {
                <div class="alert alert-info" role="alert">
                    <i class="fas fa-info-circle"></i>
                    No hay trámites que coincidan con la búsqueda.
                </div>
            }
        </div>
    </div>
</div>

<partial name="_SweetAlertHandler" model="Model.SweetAlert" />