@using CemSys3.ViewModels.Usuario
@model CambiarContraseniaUsuarioVM

@{
    ViewData["Title"] = "Cambiar Contraseña";
}

<div class="page-header-container">
    <h1 class="title-page">Perfil</h1>
</div>

<h2 class="title-page">Cambiar contraseña</h2>

<div class="contenedor-resumen">
    <form asp-action="CambiarContraseniaUsuario" method="post" id="userForm" class="form-box">
        <input type="hidden" asp-for="Id" />
        <div class="mb-3">
            <label class="form-label" for="nombre">Clave actual</label>
            <div class="input-group">
                <input class="form-control" type="password" asp-for="ClaveAnterior" id="passwordA" required maxlength="300" />
                <button class="btn btn-outline-secondary" type="button" id="togglePasswordA">
                    <i class="bi bi-eye" id="iconPasswordA"></i>
                </button>
            </div>
            <span asp-validation-for="ClaveAnterior" class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label class="form-label" for="nombre">Clave nueva <span class="obligatorio">*(Mínimo 6 caracteres, 1 mayúscula, 1 símbolo)</span></label>
            <div class="input-group">
                <input class="form-control" type="password" id="password" asp-for="ClaveNueva" required maxlength="300" />
                <button class="btn btn-outline-secondary" type="button" id="togglePassword">
                    <i class="bi bi-eye" id="iconPassword"></i>
                </button>
            </div>
            
            <span asp-validation-for="ClaveNueva" class="text-danger"></span>
        </div>

        <div class="text-center mt-4">
            <input type="submit" class="btn btn-success px-4" value="Modificar" />
        </div>
    </form>
</div>

@* Renderizamos el manejador pasándole el DTO del modelo *@
<partial name="_SweetAlertHandler" model="Model.SweetAlert" />

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        // Mostrar SweetAlert cuando la página se carga
        document.addEventListener('DOMContentLoaded', function() {
            document.getElementById('togglePassword').addEventListener('click', function () {
                const passwordInput = document.getElementById('password');
                const icon = document.getElementById('iconPassword');

                const isPassword = passwordInput.type === 'password';
                passwordInput.type = isPassword ? 'text' : 'password';

                // Cambiar ícono
                icon.classList.toggle('bi-eye');
                icon.classList.toggle('bi-eye-slash');
            });

            document.getElementById('togglePasswordA').addEventListener('click', function () {
                const passwordInput = document.getElementById('passwordA');
                const icon = document.getElementById('iconPasswordA');

                const isPassword = passwordInput.type === 'password';
                passwordInput.type = isPassword ? 'text' : 'password';

                // Cambiar ícono
                icon.classList.toggle('bi-eye');
                icon.classList.toggle('bi-eye-slash');
            });
        });
    </script>
}



