@using CemSys3.ViewModels.Usuario
@using CemSys3.Enumerables
@model UsuarioAdministradorVM

@{
    ViewData["Title"] = "Administrar Usuarios";
}

<div class="page-header-container">
    <a asp-action="Index" asp-controller="Configuracion" class="btn btn-secondary m-3" title="Configuración"><i class="bi bi-arrow-left"></i></a>
    <h1 class="title-page">Administrar usuarios</h1>
</div>

<!--Formulario de registro-->
<div class="accordion" id="accordionPanelsStayOpenExample">
    <div class="accordion-item">
        <h2 class="accordion-header" id="panelsStayOpen-headingOne">
            <button class="accordion-button nueva-seccion acordeon-fijo" type="button" data-bs-toggle="" data-bs-target="#panelsStayOpen-collapseOne" aria-expanded="false" aria-controls="panelsStayOpen-collapseOne">
                 @(Model.EsEdicion ? "Modificar usuario" : "Nuevo usuario") 
            </button>
        </h2>
        <div id="panelsStayOpen-collapseOne" class="accordion-collapse collapse show" aria-labelledby="panelsStayOpen-headingOne">
            <div class="accordion-body">
                @* cuerpo del acordion *@
                <form asp-action="Guardar" method="post" class="form-box">
                    <input type="hidden" asp-for="Id" />
                    <div class="form-columns-container3">
                        <div>
                            <label class="form-label" for="nombre">Nombre<span class="obligatorio"> * </span></label>
                            <input class="form-control" type="text" asp-for="NombreEmpleado" required maxlength="50" id="nombre" />
                            <span asp-validation-for="NombreEmpleado" class="text-danger"></span>
                        </div>

                        <div>
                            <label class="form-label" for="apellido">Apellido<span class="obligatorio"> * </span></label>
                            <input class="form-control" type="text" asp-for="ApellidoEmpleado" required maxlength="50" id="apellido" />
                            <span asp-validation-for="ApellidoEmpleado" class="text-danger"></span>
                        </div>

                        <div>
                            <label class="form-label" for="nombreUsuario">Usuario<span class="obligatorio"> * </span></label>
                            <input class="form-control" type="text" asp-for="NombreUsuario" required maxlength="50" id="nombreUsuario" />
                            <span asp-validation-for="NombreUsuario" class="text-danger"></span>
                        </div>

                        <div>
                            <label class="form-label" for="correo">Correo<span class="obligatorio"> * </span></label>
                            <input class="form-control" type="email" asp-for="Correo" required maxlength="50" id="correo" />
                            <span asp-validation-for="Correo" class="text-danger"></span>
                        </div>

                        <div>
                            <label for="rol" class="form-label">Rol del usuario<span class="obligatorio"> * </span></label>
                            <select class="form-select" asp-for="IdRol" id="rol" asp-items="@(new SelectList(Model.Roles, "Id", "Rol"))" required>
                                <option value="">--Elija una opción--</option>
                            </select>
                            <span asp-validation-for="IdRol" class="text-danger"></span>
                        </div>
                    </div>
                    <div class="form-button-registrar">
                        <input class="btn @Model.ClaseBoton" type="submit" value="@Model.TextoBoton" />
                    </div>
                </form>
                @* Fin cuerpo del acordeon *@
            </div>
        </div>
    </div>
</div>

<!-- Tabla -->
<div class="accordion" id="accordionPanelsStayOpenExample">
    <div class="accordion-item">
        <h2 class="accordion-header" id="panelsStayOpen-headingOne">
            <button class="accordion-button nueva-seccion acordeon-fijo" type="button" data-bs-toggle="" data-bs-target="#panelsStayOpen-collapseOne" aria-expanded="false" aria-controls="panelsStayOpen-collapseOne">
                Usuarios registrados
            </button>
        </h2>
        <div id="panelsStayOpen-collapseOne" class="accordion-collapse collapse show" aria-labelledby="panelsStayOpen-headingOne">
            @* cuerpo del acordion *@
            @if (Model.Usuarios.Any())
            {
                <div class="card shadow-sm">
                    <div class="card-body p-0">
                        <table class="table table-hover mb-0">
                            <thead class="table-light">
                                <tr>
                                    <th>Nombre</th>
                                    <th>Apellido</th>
                                    <th>Usuario</th>
                                    <th>Correo</th>
                                    <th>Rol</th>
                                    <th>Acciones</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var opc in Model.Usuarios)
                                {
                                    <tr>
                                        <td>@opc.NombreEmpleado.ToUpper()</td>
                                        <td>@opc.ApellidoEmpleado.ToUpper()</td>
                                        <td>@opc.NombreUsuario</td>
                                        <td>@opc.Correo.ToLower()</td>
                                        <td>@((RolUsuario)opc.IdRol)</td>
                                        <td>
                                            <form asp-action="Editar" asp-controller="Usuario" method="get" style="display: inline-block;">
                                                <input type="hidden" asp-for="Id" value="@opc.Id" name="Id" />
                                                <button type="submit" class="btn btn-warning btn-sm btn-lista" title="Editar">
                                                    <i class="bi bi-pencil"></i>
                                                </button>
                                            </form>
                                            <form asp-action="Eliminar" method="get" style="display: inline-block;" id="formularioEliminar" class="js-confirm"
                                                  data-confirm-title="Confirmar eliminación"
                                                  data-confirm-message="¿Está seguro de eliminar el usuario @opc.NombreEmpleado @opc.ApellidoEmpleado?"
                                                  data-confirm-icon="warning">

                                                <input type="hidden" asp-for="Id" name="Id" value="@opc.Id" />

                                                <button type="submit" class="btn btn-danger btn-sm btn-lista" title="Eliminar">
                                                    <i class="bi bi-trash"></i>
                                                </button>
                                            </form>

                                            <form asp-action="Resetear" method="post" style="display: inline-block;" id="formularioResetear" class="js-confirm"
                                                  data-confirm-title="Confirmar reseteo"
                                                  data-confirm-message="¿Está seguro de resetear la contraseña del usuario @opc.NombreEmpleado @opc.ApellidoEmpleado?"
                                                  data-confirm-icon="warning">

                                                <input type="hidden" asp-for="Id" name="Id" value="@opc.Id" />

                                                <button type="submit" class="btn btn-danger btn-sm btn-lista" title="Resetear contraseña">
                                                    <i class="bi bi-arrow-counterclockwise"></i>
                                                </button>
                                            </form>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            }
            @* Fin cuerpo del acordeon *@
        </div>
    </div>
</div>

@* Renderizamos el manejador pasándole el DTO del modelo *@
<partial name="_SweetAlertHandler" model="Model.SweetAlert" />

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}

