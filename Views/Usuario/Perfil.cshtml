@using CemSys3.DTOs.Paginacion
@using CemSys3.ViewModels.Usuario
@model PerfilUsuarioVM

@{
    ViewData["Title"] = "Perfil";
}

<div class="page-header-container">
    <h1 class="title-page">Perfil</h1>
</div>

<h2 class="title-page">Rol: @Model.Rol</h2>

<div class="contenedor-resumen">
    <form asp-action="ModificarPerfil" method="post" id="userForm" class="form-box">
        <input type="hidden" asp-for="Id" />
        <div class="mb-3">
            <label class="form-label" for="nombre">Nombre</label>
            <input class="form-control" type="text" asp-for="Nombre" required maxlength="60" id="nombre" />
            <span asp-validation-for="Nombre" class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label class="form-label" for="apellido">Apellido</label>
            <input class="form-control" type="text" asp-for="Apellido" required maxlength="60" id="apellido" />
            <span asp-validation-for="Apellido" class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label class="form-label" for="nombre">Usuario</label>
            <input class="form-control" type="text" asp-for="NombreUsuario" required maxlength="60" id="nombre" />
            <span asp-validation-for="NombreUsuario" class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label class="form-label" for="correo">Correo</label>
            <input class="form-control" type="email" asp-for="Correo" required maxlength="60" id="correo" />
            <span asp-validation-for="Correo" class="text-danger"></span>
        </div>

        <div class="text-center mt-4">
            <input type="hidden" asp-for="Rol" value="@Model.Rol" />
            <input type="submit" class="btn btn-success px-4" value="Modificar" />
        </div>
    </form>
</div>

<form asp-action="CambiarContraseniaUsuario" method="get" class="my-4">
    <input type="hidden" name="usuarioId" value="@Model.Id" />
    <div class="text-center mt-4">
        <input type="submit" class="btn btn-outline-success px-4" value="Cambiar contraseña" />
    </div>
</form>

@* Renderizamos el manejador pasándole el DTO del modelo *@
<partial name="_SweetAlertHandler" model="Model.SweetAlert" />

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}


