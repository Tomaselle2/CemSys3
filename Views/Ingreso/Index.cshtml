@using CemSys3.Enumerables
@using CemSys3.Helpers.Enumerable
@using CemSys3.ViewModels.Ingreso
@model IngresoVM

@{
    ViewData["Title"] = "Ingreso";
    string fecha = DateOnly.FromDateTime(DateTime.Now).ToString("yyyy-MM-dd"); //para input fecha
    DateOnly fechaActual = DateOnly.FromDateTime(DateTime.Now); //año maximo de acta
    string fechaMax = DateTime.Now.ToString("yyyy-MM-ddTHH:mm"); //para input datetime-local
}

<div class="page-header-container">
    <h1 class="title-page">Ingreso</h1>
</div>

<!-- Nota de ingreso -->
<div class="container-fluid">
    <div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 g-2">
        <div class="col">
            <div class="card h-100 cursor-pointer"
                 style="background-color:@Model.NotaIngreso.Color;"
                 hx-get="@Url.Action(action: "visualizar", controller: "Nota", values: new { id = @Model.NotaIngreso.Id, controlador = "Ingreso" })"
                 hx-target="#modal-container"
                 hx-swap="innerHTML"
                 role="button"
                 tabindex="0">

                <div class="card-header d-flex justify-content-between align-items-center">
                    <span class="badge bg-primary">
                        @(EnumHelper.GetDisplayNameByValue<TipoNotaEnum>(@Model.NotaIngreso.TipoNotaId))
                    </span>
                    <span class="badge bg-black">
                        @(EnumHelper.GetDisplayNameByValue<EstadosNotaEnum>(@Model.NotaIngreso.EstadoId))
                    </span>
                </div>

                <div class="card-body">
                    <h5 class="card-title">@Model.NotaIngreso.Nombre</h5>
                    <p class="card-text" style="white-space:pre-wrap;">
                        <!-- Aquí debería ir la descripción o contenido -->
@Model.NotaIngreso.Descripcion
                    </p>
                </div>
            </div>
        </div>
    </div>
</div>

<div id="modal-container"></div>

<form asp-action="Ingreso" asp-controller="Ingreso" class="form-box" method="post" id="formularioRegistrar">
    <input type="hidden" asp-for="NotaIngreso.Id" />

    <!-- Formulario datos del difunto-->
    <div class="accordion" id="accordionDatosDifunto">
        @* ID único para el acordeón principal *@
        <div class="accordion-item">
            <h2 class="accordion-header" id="panelsDatosDifunto-headingOne">
                <button class="accordion-button nueva-seccion" type="button" data-bs-toggle="collapse" data-bs-target="#panelsDatosDifunto-collapseOne" aria-expanded="false" aria-controls="panelsDatosDifunto-collapseOne">
                    Datos del difunto
                </button>
            </h2>
            <div id="panelsDatosDifunto-collapseOne" class="accordion-collapse collapse" aria-labelledby="panelsDatosDifunto-headingOne" data-bs-parent="#accordionDatosDifunto">
                @* Agregado data-bs-parent y 'show' para que inicie abierto si lo deseas *@
                <div class="accordion-body">
                    <div class="form-box">
                        <div class="form-columns-container3">

                            <div>
                                <label for="dni">DNI</label>
                                <input class="form-control" id="dniInput" type="text" autocomplete="off" asp-for="Dni" maxlength="8" pattern="[0-9]+" oninput="this.value = this.value.replace(/[^0-9]/g, '')" />
                                <span asp-validation-for="Dni" class="text-danger"></span>
                            </div>

                            <div>
                                <label for="nombreDifunto">Nombre<span class="obligatorio" id="nombreObligatorio"> * </span></label>
                                <input class="form-control" id="nombreInput" type="text" autocomplete="off" asp-for="Nombre" maxlength="60" minlength="2" required />
                                <span asp-validation-for="Nombre" class="text-danger"></span>
                            </div>

                            <div>
                                <label for="apellidoDifunto">Apellido<span class="obligatorio"> * </span></label>
                                <input class="form-control" type="text" id="apellidoInput" autocomplete="off" asp-for="Apellido" required maxlength="60" minlength="2" />
                                <span asp-validation-for="Apellido" class="text-danger"></span>
                            </div>

                            <div>
                                <label for="fechaNacimiento">Nacimiento</label>
                                <input class="form-control" type="date" id="inputFechaNacimiento" asp-for="FechaNacimiento" max="@fecha" />
                                <span asp-validation-for="FechaNacimiento" class="text-danger"></span>
                            </div>


                            <div>
                                <label for="fechaDefuncion">Defunción</label>
                                <input class="form-control" type="date" autocomplete="off" asp-for="FechaDefuncion" max="@fecha" />
                                <span asp-validation-for="FechaDefuncion" class="text-danger"></span>
                            </div>

                            
                            <div>
                                <label for="sexoDifunto">Sexo<span class="obligatorio"> * </span></label>
                                <select class="form-select" asp-for="Sexo" required>
                                    <option value="">--Elija una opción--</option>
                                    <option value="masculino">Masculino</option>
                                    <option value="femenino">Femenino</option>
                                    <option value="otro">Otro</option>
                                </select>
                                <span asp-validation-for="Sexo" class="text-danger"></span>
                            </div>

                            <div>
                                <label>Estado del difunto<span class="obligatorio"> * </span></label>
                                <select class="form-select" asp-for="EstadoDifuntoId" id="estadoDelDifunto" asp-items="@EnumHelper.GetSelectListItems<EstadoDifuntoEnum>()" required>
                                    <option value="">--Elija una opción--</option>
                                </select>
                            </div>
                        </div>



                        <h5>Datos acta de defunción</h5>
                        <div class="form-columns-container5">
                            <div>
                                <label for="acta">Acta</label>
                                <input type="number" class="form-control" autocomplete="off" asp-for="NroActa" min="1" />
                            </div>
                            <div>
                                <label>Tomo</label>
                                <input type="number" class="form-control" autocomplete="off" asp-for="NroTomo" min="1" />
                            </div>
                            <div>
                                <label>Folio</label>
                                <input type="number" class="form-control" autocomplete="off" asp-for="NroFolio" min="1" />
                            </div>
                            <div>
                                <label>Serie</label>
                                <input type="text" class="form-control" autocomplete="off" asp-for="NroSerie" />
                            </div>
                            <div>
                                <label>Año</label>
                                <input type="number" class="form-control" autocomplete="off" asp-for="NroAge" min="1800" max="@fechaActual.Year" />
                            </div>
                        </div>
                        <!-- Datos adicionales -->
                        <div class="full-width">
                            <label for="datosAdicionales">Datos adicionales</label>
                            <textarea class="form-control" autocomplete="off" asp-for="InformacionAdicional"></textarea>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>


    <!-- Formulario datos de ubicacion-->
    <div class="accordion" id="accordionUbicacion">
        @* ID único para el acordeón principal *@
        <div class="accordion-item">
            <h2 class="accordion-header" id="panelsUbicacion-headingOne">
                <button class="accordion-button nueva-seccion" type="button" data-bs-toggle="collapse" data-bs-target="#panelsUbicacion-collapseOne" aria-expanded="false" aria-controls="panelsUbicacion-collapseOne">
                    Ubicación <span class="obligatorio"> * </span>
                </button>
            </h2>
            <div id="panelsUbicacion-collapseOne" class="accordion-collapse collapse" aria-labelledby="panelsUbicacion-headingOne" data-bs-parent="#accordionUbicacion">
                @* Agregado data-bs-parent y 'show' para que inicie abierto si lo deseas *@
                <div class="accordion-body">
                    <div class="form-box">
                        <!--parcelas-->
                        @await Html.PartialAsync("IngresoPV/_SelectorUbicacion",
                        new SelectorUbicacionVM
                        {
                            TipoParcelaID = Model.TipoParcelaID,
                            SeccionID = Model.SeccionID,
                            ParcelaID = Model.ParcelaID,

                            TipoParcelaName = "TipoParcelaID",
                            SeccionName = "SeccionID",
                            ParcelaName = "ParcelaID",

                            UrlSecciones = Url.Action("ObtenerSeccionesPorTipo", "Seccion") ?? "",
                            UrlParcelas = Url.Action("ObtenerParcelasPorSeccion", "Parcela") ?? "",
                        })
                    </div>
                </div>
            </div>
        </div>

    </div>


    <!-- Formulario Detalle del ingreso-->
    <div class="accordion" id="accordionIngreso">
        @* ID único para el acordeón principal *@
        <div class="accordion-item">
            <h2 class="accordion-header" id="panelsIngreso-headingOne">
                <button class="accordion-button nueva-seccion" type="button" data-bs-toggle="collapse" data-bs-target="#panelsIngreso-collapseOne" aria-expanded="false" aria-controls="panelsIngreso-collapseOne">
                    Detalle del ingreso
                </button>
            </h2>
            <div id="panelsIngreso-collapseOne" class="accordion-collapse collapse" aria-labelledby="panelsIngreso-headingOne" data-bs-parent="#accordionIngreso">
                <div class="accordion-body">
                    <div class="form-box">
                        <div class="form-columns-container3">
                            <div>
                                <label>Empleado responsable<span class="obligatorio"> * </span></label>
                                <select id="" class="form-select" asp-for="EmpleadoID" asp-items="@(new SelectList(Model.ListaEmpleados, "Id", "NombreCompleto"))" required>
                                    <option value="">--Elija una opción--</option>
                                </select>
                                <span asp-validation-for="EmpleadoID" class="text-danger"></span>

                            </div>

                            <div>
                                <label>Empresa de sepelio responsable</label>
                                <select id="empresaSepelio" class="form-select" asp-for="EmpresaFunebreID" asp-items="@(new SelectList(Model.ListaEmpresasSepelio, "Id", "Nombre"))">
                                    <option value="">--Elija una opción--</option>
                                </select>
                                <span asp-validation-for="EmpresaFunebreID" class="text-danger"></span>
                            </div>

                            <div class="d-flex align-items-end">
                                <button id="agregarEmpresaButton" data-bs-toggle="modal" data-bs-target="#EmpresaModal" class="btn btn-outline-primary">Agregar empresa</button>
                            </div>

                            <div>
                                <label>Fecha y hora<span class="obligatorio"> * </span></label>
                                <input type="datetime-local" asp-for="FechaHoraIngreso" class="form-control" required max="@fechaMax" />
                                <span asp-validation-for="FechaHoraIngreso" class="text-danger"></span>
                            </div>

                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div style="display: flex; justify-content: center;">
        <input type="button" class="btn btn-success" onclick="confirmarEnvio()" value="Ingresar difunto" />
    </div>
</form>

<!-- Modal de confirmacion de ingreso del difunto -->
<div class="modal fade" tabindex="-1" id="modalConfirmacion">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Confirmación</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <p>¿Desea ingresar el difunto <strong id="apellidoModal"></strong> <strong id="nombreModal"></strong>?</p>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal" onclick="cerrarModal()">Cancelar</button>
                <button type="button" class="btn btn-primary" id="btnConfirmarIngreso" onclick="enviarFormulario()">Ingresar</button>
            </div>
        </div>
    </div>
</div>

<!-- Modal de agregar empresa -->
<div class="modal fade" id="EmpresaModal" tabindex="-1" aria-labelledby="exampleModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="exampleModalLabel">Nueva empresa de sepelio</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <form id="formEmpresa" class="needs-validation" novalidate>
                    <label for="nombreEmpresa">Nombre<span class="obligatorio"> * </span></label>
                    <input id="nombreEmpresa" class="form-control" type="text" required />
                    <div class="invalid-feedback">
                        El nombre es obligatorio.
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
                        <button type="submit" class="btn btn-primary" id="registrarEmpresaBtn">Registrar</button>
                    </div>
                </form>
            </div>

        </div>
    </div>
</div>

@* Renderizamos el manejador pasándole el DTO del modelo *@
<partial name="_SweetAlertHandler" model="Model.SweetAlert" />

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script src="~/js/ubicacion-selector.js"></script>

    <script>
        //logica de agregar empresa
        const agregarEmpresaButton = document.getElementById('agregarEmpresaButton');
        const formEmpresa = document.getElementById('formEmpresa');
        const nombreEmpresaInput = document.getElementById('nombreEmpresa');
        const empresaSepelioSelect = document.getElementById('empresaSepelio');

        // Abre el modal y limpia el formulario
        agregarEmpresaButton.addEventListener('click', function (event) {
            event.preventDefault();
            formEmpresa.reset();
            formEmpresa.classList.remove('was-validated');
            $('#EmpresaModal').modal('show');
        });

        // Validación y envío con fetch
        formEmpresa.addEventListener('submit', async function (event) {
            event.preventDefault();
            event.stopPropagation();

            if (!formEmpresa.checkValidity()) {
                formEmpresa.classList.add('was-validated');
                return;
            }

            const nombre = nombreEmpresaInput.value.trim();

            function mostrarAlertaExito(mensaje) {
                AlertService.show('Éxito', mensaje, 'success');
            }

            try {
                const response = await fetch(`/EmpresaSepelio/AgregarEmpresa?nombreEmpresa=${encodeURIComponent(nombre)}`);
                const result = await response.json();

                if (result.success) {
                    mostrarAlertaExito(result.message);
                    $('#EmpresaModal').modal('hide');

                    if (empresaSepelioSelect) {
                        const option = document.createElement('option');
                        option.value = result.idEmpresa;
                        option.text = nombre;
                        option.selected = true;
                        empresaSepelioSelect.appendChild(option);
                    }
                } else {
                    AlertService.show('Error', result.message, 'error');

                }
            } catch (error) {
                AlertService.show('Error', "Error al enviar la solicitud", 'error');
            }
        });


        //logica de modal de confirmacion
        function confirmarEnvio() {
               const form = document.getElementById("formularioRegistrar");

               if (form.checkValidity()) {
                   const modal = new bootstrap.Modal(document.getElementById("modalConfirmacion"));

                   const nombre = document.getElementById("nombreInput").value;
                   const apellido = document.getElementById("apellidoInput").value;

                   //se inserta en el modal
                   document.getElementById("nombreModal").textContent = nombre;
                   document.getElementById("apellidoModal").textContent = apellido;

                   modal.show();
               } else {
                   form.reportValidity();
               }
           }

           function cerrarModal() {
               document.getElementById("modalConfirmacion").style.display = "none";
           }

           function enviarFormulario() {
               const form = document.getElementById("formularioRegistrar");
               const btnConfirmarIngreso = document.getElementById("btnConfirmarIngreso");
               if (form.checkValidity()) {
                    // Deshabilitar el botón
                     btnConfirmarIngreso.disabled = true;

                   //colocar un spinner al btn
                   btnConfirmarIngreso.innerHTML = `
                        <span class="spinner-border spinner-border-sm" role="status" aria-hidden="true"></span>
                        Ingresando...
                    `;
                   form.submit(); // Sólo se envía si el formulario es válido
               } else {
                   form.reportValidity(); // Muestra los mensajes de error del navegador
                   cerrarModal(); // Opcional: cerrá el modal si querés forzar al usuario a revisar
               }
           }


    </script>
}



