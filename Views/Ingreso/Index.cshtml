@using CemSys3.Enumerables
@using CemSys3.Helpers.Enumerable
@using CemSys3.ViewModels.Ingreso
@model IngresoVM

@{
    ViewData["Title"] = "Ingreso";
    string fecha = DateOnly.FromDateTime(DateTime.Now).ToString("yyyy-MM-dd"); //para input fecha
    DateOnly fechaActual = DateOnly.FromDateTime(DateTime.Now); //año maximo de acta
    var fechaMax = DateTime.Now.ToString("yyyy-MM-ddTHH:mm"); //para input datetime-local
}

<div class="page-header-container">
    <h1 class="title-page">Ingreso</h1>
</div>

<!-- Nota de ingreso -->
<div class="container-fluid">
    <div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 g-2">
        <div class="col">
            <div class="card h-100 cursor-pointer"
                 style="background-color:@Model.NotaIngreso.Color;"
                 hx-get="@Url.Action(action: "visualizar", controller: "Nota", values: new { id = @Model.NotaIngreso.Id, controlador = "Ingreso" })"
                 hx-target="#modal-container"
                 hx-swap="innerHTML"
                 role="button"
                 tabindex="0">

                <div class="card-header d-flex justify-content-between align-items-center">
                    <span class="badge bg-primary">
                        @(EnumHelper.GetDisplayNameByValue<TipoNotaEnum>(@Model.NotaIngreso.TipoNotaId))
                    </span>
                    <span class="badge bg-black">
                        @(EnumHelper.GetDisplayNameByValue<EstadosNotaEnum>(@Model.NotaIngreso.EstadoId))
                    </span>
                </div>

                <div class="card-body">
                    <h5 class="card-title">@Model.NotaIngreso.Nombre</h5>
                    <p class="card-text" style="white-space:pre-wrap;">
                        <!-- Aquí debería ir la descripción o contenido -->
@Model.NotaIngreso.Descripcion
                    </p>
                </div>
            </div>
        </div>
    </div>
</div>

<div id="modal-container"></div>

<form asp-action="/" class="form-box" method="post">


    <!-- Formulario datos del difunto-->
    <div class="accordion" id="accordionDatosDifunto">
        @* ID único para el acordeón principal *@
        <div class="accordion-item">
            <h2 class="accordion-header" id="panelsDatosDifunto-headingOne">
                <button class="accordion-button nueva-seccion" type="button" data-bs-toggle="collapse" data-bs-target="#panelsDatosDifunto-collapseOne" aria-expanded="false" aria-controls="panelsDatosDifunto-collapseOne">
                    Datos del difunto
                </button>
            </h2>
            <div id="panelsDatosDifunto-collapseOne" class="accordion-collapse collapse" aria-labelledby="panelsDatosDifunto-headingOne" data-bs-parent="#accordionDatosDifunto">
                @* Agregado data-bs-parent y 'show' para que inicie abierto si lo deseas *@
                <div class="accordion-body">
                    <div class="form-box">
                        <div class="form-columns-container3">

                            <div>
                                <label for="dni">DNI</label>
                                <input class="form-control" id="dniInput" type="text" asp-for="Dni" maxlength="8" pattern="[0-9]+" oninput="this.value = this.value.replace(/[^0-9]/g, '')" />
                                <span asp-validation-for="Dni" class="text-danger"></span>
                            </div>

                            <div>
                                <label for="nombreDifunto">Nombre<span class="obligatorio" id="nombreObligatorio"> * </span></label>
                                <input class="form-control" id="nombreInput" type="text" asp-for="Nombre" maxlength="60" minlength="2" required />
                                <span asp-validation-for="Nombre" class="text-danger"></span>
                            </div>

                            <div>
                                <label for="apellidoDifunto">Apellido<span class="obligatorio"> * </span></label>
                                <input class="form-control" type="text" id="apellidoInput" asp-for="Apellido" required maxlength="60" minlength="2" />
                                <span asp-validation-for="Apellido" class="text-danger"></span>
                            </div>

                            <div>
                                <label for="fechaNacimiento">Nacimiento</label>
                                <input class="form-control" type="date" id="inputFechaNacimiento" asp-for="FechaNacimiento" max="@fecha" />
                                <span asp-validation-for="FechaNacimiento" class="text-danger"></span>
                            </div>


                            <div>
                                <label for="fechaDefuncion">Defunción</label>
                                <input class="form-control" type="date" asp-for="FechaDefuncion" max="@fecha" />
                                <span asp-validation-for="FechaDefuncion" class="text-danger"></span>
                            </div>

                            
                            <div>
                                <label for="sexoDifunto">Sexo<span class="obligatorio"> * </span></label>
                                <select class="form-select" asp-for="Sexo" required>
                                    <option value="">--Elija una opción--</option>
                                    <option value="masculino">Masculino</option>
                                    <option value="femenino">Femenino</option>
                                    <option value="otro">Otro</option>
                                </select>
                                <span asp-validation-for="Sexo" class="text-danger"></span>
                            </div>

                            <div>
                                <label>Estado del difunto<span class="obligatorio"> * </span></label>
                                <select class="form-select" asp-for="EstadoDifuntoId" id="estadoDelDifunto" asp-items="@EnumHelper.GetSelectListItems<EstadoDifuntoEnum>()" required>
                                    <option value="">--Elija una opción--</option>
                                </select>
                            </div>
                        </div>



                        <h5>Datos acta de defunción</h5>
                        <div class="form-columns-container5">
                            <div>
                                <label for="acta">Acta</label>
                                <input type="number" class="form-control" asp-for="NroActa" min="1" />
                            </div>
                            <div>
                                <label>Tomo</label>
                                <input type="number" class="form-control" asp-for="NroTomo" min="1" />
                            </div>
                            <div>
                                <label>Folio</label>
                                <input type="number" class="form-control" asp-for="NroFolio" min="1" />
                            </div>
                            <div>
                                <label>Serie</label>
                                <input type="text" class="form-control" asp-for="NroSerie" />
                            </div>
                            <div>
                                <label>Año</label>
                                <input type="number" class="form-control" asp-for="NroAge" min="1800" max="@fechaActual.Year" />
                            </div>
                        </div>
                        <!-- Datos adicionales -->
                        <div class="full-width">
                            <label for="datosAdicionales">Datos adicionales</label>
                            <textarea class="form-control" asp-for="InformacionAdicional"></textarea>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>


    <!-- Formulario datos de ubicacion-->
    <div class="accordion" id="accordionUbicacion">
        @* ID único para el acordeón principal *@
        <div class="accordion-item">
            <h2 class="accordion-header" id="panelsUbicacion-headingOne">
                <button class="accordion-button nueva-seccion" type="button" data-bs-toggle="collapse" data-bs-target="#panelsUbicacion-collapseOne" aria-expanded="false" aria-controls="panelsUbicacion-collapseOne">
                    Ubicación
                </button>
            </h2>
            <div id="panelsUbicacion-collapseOne" class="accordion-collapse collapse" aria-labelledby="panelsUbicacion-headingOne" data-bs-parent="#accordionUbicacion">
                @* Agregado data-bs-parent y 'show' para que inicie abierto si lo deseas *@
                <div class="accordion-body">
                    <div class="form-box">
                        <!--parcelas-->
                        @await Html.PartialAsync("IngresoPV/_SelectorUbicacion",
                        new SelectorUbicacionVM
                        {
                            TipoParcelaID = Model.TipoParcelaID,
                            SeccionID = Model.SeccionID,
                            ParcelaID = Model.ParcelaID,

                            TipoParcelaName = "TipoParcelaID",
                            SeccionName = "SeccionID",
                            ParcelaName = "ParcelaID",

                            UrlSecciones = Url.Action("ObtenerSeccionesPorTipo") ?? "",
                            UrlParcelas = Url.Action("ObtenerParcelasPorSeccion") ?? "",
                        })
                    </div>
                </div>
            </div>
        </div>

    </div>



</form>

@* Renderizamos el manejador pasándole el DTO del modelo *@
<partial name="_SweetAlertHandler" model="Model.SweetAlert" />

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/htmx.org@2.0.8/dist/htmx.min.js"></script>
    <partial name="_ValidationScriptsPartial" />
    <script src="~/js/ubicacion-selector.js"></script>
}



