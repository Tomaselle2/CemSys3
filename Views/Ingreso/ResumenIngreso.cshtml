    <div class="separador"></div>

    <div class="form-columns-container5">
        <div>
            <p><strong>Acta:</strong> @(Model.Resumen.Difunto.NroActa != null ? Model.Resumen.Difunto.NroActa : "")</p>
        </div>
        <div>
            <p><strong>Tomo:</strong> @(Model.Resumen.Difunto.NroTomo != null ? Model.Resumen.Difunto.NroTomo : "")</p>
        </div>
        <div>
            <p><strong>Folio:</strong> @(Model.Resumen.Difunto.NroFolio != null ? Model.Resumen.Difunto.NroFolio : "")</p>
        </div>
        <div>
            <p><strong>Serie:</strong> @(Model.Resumen.Difunto.NroSerie != null ? Model.Resumen.Difunto.NroSerie : "")</p>
        </div>
        <div>
            <p><strong>Año:</strong> @(Model.Resumen.Difunto.NroAge != null ? Model.Resumen.Difunto.NroAge : "")</p>
        </div>
