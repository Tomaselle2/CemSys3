@using CemSys3.ViewModels.Historial
@using CemSys3.ViewModels.Ingreso
@using CemSys3.Helpers.Enumerable
@using CemSys3.Enumerables
@using CemSys3.ViewModels.Archivo
@model ResumenIngresoVM

@{
    ViewData["Title"] = "Resumen de ingreso";

    string ubicacion = string.Empty;

    if (Model.Resumen.TipoParcelaId == (int)TipoParcelaEnum.Nicho)
    {
        ubicacion = $"Nicho {Model.Resumen.NroParcela} Fila {Model.Resumen.NroFila}";
    }
    else if (Model.Resumen.TipoParcelaId == (int)TipoParcelaEnum.Fosa)
    {
        ubicacion = $"Fosa {Model.Resumen.NroParcela}";
    }
    else if (Model.Resumen.TipoParcelaId == (int)TipoParcelaEnum.Panteon)
    {
        ubicacion = $"Lote {Model.Resumen.NroParcela}";
    }
    else
    {
        ubicacion = "Sin asignar";
    }
}

<!--Estilos de tabla de ingreso-->
<style>
    .contenedor-principal {
        display: grid;
        grid-template-columns: repeat(2, 1fr);
        gap: 30px;
        width: 100%;
        margin: 0 auto;
    }

    .grupo-tabla {
        break-inside: avoid;
        page-break-inside: avoid;
        margin-bottom: 30px;
        cursor: pointer;
        transition: all 0.2s ease;
        border: 3px solid transparent;
        border-radius: 8px;
        padding: 10px;
    }

        .grupo-tabla:hover {
            box-shadow: 0 4px 8px rgba(0,0,0,0.1);
        }

        .grupo-tabla.seleccionada {
            border-color: #0d6efd;
            background-color: #f8f9ff;
            box-shadow: 0 6px 12px rgba(13,110,253,0.2);
        }

        .grupo-tabla.no-seleccionada {
            opacity: 0.5;
        }

    table {
        border-collapse: collapse;
        width: 100%;
        font-family: Arial, sans-serif;
        font-size: 15px;
        margin-bottom: 0;
    }

    th, td {
        border: 1px solid #000;
        padding: 5px 8px;
        vertical-align: top;
    }

    th {
        text-align: center;
        font-weight: bold;
        background-color: #f2f2f2;
        font-size: 14px;
    }

    .right {
        text-align: right;
    }

    .bold {
        font-weight: bold;
    }

    /* Primera columna sin líneas internas */
    .grupo {
        border-bottom: none;
        width: 35%;
    }

    .grupo-cont {
        border-top: none;
        border-bottom: none;
    }

    .grupo-fin {
        border-top: none;
    }

    /* Renglón separador */
    .espacio td {
        height: 12px;
        border: none;
    }

    .titulo-regla {
        font-size: 14px;
        font-weight: bold;
        margin: 0;
        background-color: #f9f9f9;
    }

    .total-ingreso {
        background-color: #e8e8e8;
        font-size: 14px;
    }

    /* Para separar las tablas dentro de un grupo */
    .separador-tabla {
        height: 20px;
    }

    .td-contenido {
        width: 45%;
    }

    .td-importe {
        width: 30%;
    }

    /* Estilos para el control de cobro */
    .control-cobro {
        background-color: #f8f9fa;
        border: 2px solid #dee2e6;
        border-radius: 8px;
        padding: 20px;
        margin: 20px 0;
    }

    .switch-container {
        display: flex;
        align-items: center;
        gap: 15px;
        margin-bottom: 15px;
    }

    .switch {
        position: relative;
        display: inline-block;
        width: 60px;
        height: 34px;
    }

        .switch input {
            opacity: 0;
            width: 0;
            height: 0;
        }

    .slider {
        position: absolute;
        cursor: pointer;
        top: 0;
        left: 0;
        right: 0;
        bottom: 0;
        background-color: #ccc;
        transition: .4s;
        border-radius: 34px;
    }

        .slider:before {
            position: absolute;
            content: "";
            height: 26px;
            width: 26px;
            left: 4px;
            bottom: 4px;
            background-color: white;
            transition: .4s;
            border-radius: 50%;
        }

    input:checked + .slider {
        background-color: #198754;
    }

        input:checked + .slider:before {
            transform: translateX(26px);
        }

    .selector-tabla-container {
        display: none;
        margin-top: 15px;
        padding: 15px;
        background-color: #fff;
        border-radius: 6px;
        border: 1px solid #dee2e6;
    }

        .selector-tabla-container.active {
            display: block;
        }

    .badge-seleccion {
        position: absolute;
        top: -15px;
        right: 5px;
        background-color: #0d6efd;
        color: white;
        padding: 5px 25px;
        border-radius: 5px;
        font-size: 12px;
        font-weight: bold;
    }

    .grupo-tabla {
        position: relative;
    }
</style>


