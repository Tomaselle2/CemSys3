@* Renderizamos el manejador pasándole el DTO del modelo *@
<partial name="_SweetAlertHandler" model="Model.SweetAlert" />



@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        function autoResize(textarea) {
            textarea.style.height = 'auto';
            textarea.style.height = textarea.scrollHeight + 'px';
        }

        document.addEventListener('DOMContentLoaded', () => {
            document.querySelectorAll('.auto-resize').forEach(t => autoResize(t));

            // Control del switch de cobro
            const switchCobro = document.getElementById('switchCobro');
            const labelCobro = document.getElementById('labelCobro');
            const selectorContainer = document.getElementById('selectorTablaContainer');
            const contenedorTablas = document.getElementById('contenedorTablas');
            const selectTabla = document.getElementById('selectTabla');
            const tablaSeleccionadaInput = document.getElementById('tablaSeleccionadaId');
            const cobroIngresoInput = document.getElementById('cobroIngreso');


            // Función para actualizar el valor del input hidden de cobro de ingreso
            function actualizarCobroIngreso() {
                if(switchCobro){
                    if (!switchCobro.checked) {
                    // Si el switch está desactivado
                    cobroIngresoInput.value = 'No se cobra ingreso';
                    } else {
                        // Si el switch está activado, tomar el texto del select
                        const selectedOption = selectTabla.options[selectTabla.selectedIndex];
                        if (selectedOption && selectedOption.value !== '') {
                            cobroIngresoInput.value = selectedOption.text;
                        } else {
                            cobroIngresoInput.value = '-- Seleccione una opción --';
                        }
                    }
                }
            }

            // Inicializar el valor al cargar la página
            actualizarCobroIngreso();

            if (switchCobro) {
                switchCobro.addEventListener('change', function() {
                    if (this.checked) {
                        labelCobro.textContent = 'Cobrar ingreso';
                        selectorContainer.classList.add('active');
                        // Mostrar la tabla seleccionada si existe
                        if (selectTabla.value !== '') {
                            mostrarTablaSeleccionada(selectTabla.value);
                        }
                    } else {
                        labelCobro.textContent = 'No cobrar ingreso';
                        selectorContainer.classList.remove('active');
                        contenedorTablas.style.display = 'none';
                        selectTabla.value = '';
                        tablaSeleccionadaInput.value = '';
                        ocultarTodasLasTablas();
                    }

                    // Actualizar el valor del input hidden
                    actualizarCobroIngreso();
                });
            }

            // Control del selector de tabla
            if (selectTabla) {
                selectTabla.addEventListener('change', function() {
                    const indexSeleccionado = this.value;
                    tablaSeleccionadaInput.value = indexSeleccionado;

                    if (indexSeleccionado !== '') {
                        mostrarTablaSeleccionada(indexSeleccionado);
                    } else {
                        ocultarTodasLasTablas();
                        contenedorTablas.style.display = 'none';
                    }

                    // Actualizar el valor del input hidden
                    actualizarCobroIngreso();
                });
            }

            function mostrarTablaSeleccionada(index) {
                const todasLasTablas = document.querySelectorAll('.grupo-tabla');

                todasLasTablas.forEach((tabla, i) => {
                    if (i.toString() === index) {
                        tabla.style.display = 'block';
                        tabla.classList.add('seleccionada');
                        tabla.classList.remove('no-seleccionada');

                        // Agregar badge si no existe
                        if (!tabla.querySelector('.badge-seleccion')) {
                            const badge = document.createElement('div');
                            badge.className = 'badge-seleccion';
                            badge.innerHTML = '✓ SELECCIONADO';
                            tabla.appendChild(badge);
                        }
                    } else {
                        tabla.style.display = 'none';
                        tabla.classList.remove('seleccionada');

                        // Remover badge
                        const badge = tabla.querySelector('.badge-seleccion');
                        if (badge) {
                            badge.remove();
                        }
                    }
                });

                contenedorTablas.style.display = 'grid';
            }

            function ocultarTodasLasTablas() {
                const todasLasTablas = document.querySelectorAll('.grupo-tabla');
                todasLasTablas.forEach(tabla => {
                    tabla.style.display = 'none';
                    tabla.classList.remove('seleccionada', 'no-seleccionada');

                    const badge = tabla.querySelector('.badge-seleccion');
                    if (badge) {
                        badge.remove();
                    }
                });
            }



            // ===== CONTROL APERTURA =====

            const switchApertura = document.getElementById('switchApertura');
            const labelApertura = document.getElementById('labelApertura');
            const selectorAperturaContainer = document.getElementById('selectorAperturaContainer');
            const selectApertura = document.getElementById('selectApertura');
            const contenedorTablaApertura = document.getElementById('contenedorTablaApertura');
            const cobroAperturaInput = document.getElementById('cobroApertura');

            // Inicializar
            if(cobroAperturaInput){
                cobroAperturaInput.value = "No se cobra apertura";
            }

            if (switchApertura) {
                switchApertura.addEventListener('change', function () {

                    if (this.checked) {
                        labelApertura.textContent = "Se cobra apertura";
                        selectorAperturaContainer.classList.add('active');
                    }
                    else {
                        labelApertura.textContent = "No se cobra apertura";
                        selectorAperturaContainer.classList.remove('active');
                        contenedorTablaApertura.style.display = 'none';
                        selectApertura.value = '';
                        cobroAperturaInput.value = "No se cobra apertura";
                    }
                });
            }

                           if (selectApertura) {
            selectApertura.addEventListener('change', function () {

                const option = this.options[this.selectedIndex];

                if (!option.value) {
                    contenedorTablaApertura.style.display = 'none';
                    if (cobroAperturaInput) cobroAperturaInput.value = "No se cobra apertura";
                    return;
                }

                // Forzamos el parseo y aseguramos un valor por defecto (0) si falla
                const nombre = option.text.split(' (')[0];
                const precioBase = parseFloat(option.dataset.base) || 0;
                let porcentaje = parseFloat(option.dataset.porcentaje) || 0;

                // REGLA DE VALIDACIÓN: Si el porcentaje viene como entero (ej: 10 en vez de 0.10), lo convertimos a coeficiente
                if (porcentaje > 1) {
                    porcentaje = porcentaje / 100;
                }

                // Calculamos el monto real del fondo y el total definitivo
                const montoFondo = precioBase * porcentaje;
                const total = precioBase + montoFondo;

                // Multiplicamos por 100 para mostrar de forma amigable en la tabla (ej: 10%)
                const porcentajeMostrar = (porcentaje * 100).toLocaleString('es-AR', { maximumFractionDigits: 2 });

                contenedorTablaApertura.innerHTML = `
                    <table>
                        <tr>
                            <th colspan="2" style="font-size:16px;">APERTURA</th>
                            <th>${new Date().getFullYear()}</th>
                        </tr>

                        <tr>
                            <th>Concepto</th>
                            <th></th>
                            <th>Importe</th>
                        </tr>

                        <tr>
                            <td class="bold">${nombre}</td>
                            <td></td>
                            <td class="right">${precioBase.toLocaleString('es-AR', { style: 'currency', currency: 'ARS' })}</td>
                        </tr>

                        <tr>
                            <td>% Fondo ayuda centro salud (${porcentajeMostrar}%)</td>
                            <td></td>
                            <td class="right">${montoFondo.toLocaleString('es-AR', { style: 'currency', currency: 'ARS' })}</td>
                        </tr>

                        <tr class="total-ingreso">
                            <td colspan="2" class="bold">TOTAL APERTURA</td>
                            <td class="right bold">
                                ${total.toLocaleString('es-AR', { style: 'currency', currency: 'ARS' })}
                            </td>
                        </tr>
                    </table>
                `;

                contenedorTablaApertura.style.display = 'block';

                // Guardar valor formateado para enviar al controller
                if (cobroAperturaInput) {
                    cobroAperturaInput.value = `${nombre} (${total.toLocaleString('es-AR', { style: 'currency', currency: 'ARS' })})`;
                }
            });
        }






            // Inicializar: ocultar todas las tablas al cargar
            ocultarTodasLasTablas();
        });
    </script>
}
