<!-- Control de cobro de apertura -->
@if (Model.Resumen.EstadoActualId == (int)EstadosIngresoEnum.IngresoRegistrado)
{
    <div class="control-cobro mt-4">

        <div class="switch-container">
            <label class="switch">
                <input type="checkbox" id="switchApertura">
                <span class="slider"></span>
            </label>
            <label for="switchApertura" style="font-weight: bold; font-size: 16px; margin: 0;">
                <span id="labelApertura">No se cobra apertura</span>
            </label>
        </div>

        <div id="selectorAperturaContainer" class="selector-tabla-container">
            <label style="font-weight: bold; margin-bottom: 10px; display: block;">
                Seleccione la apertura:
            </label>

            <select id="selectApertura" class="form-select" style="max-width: 600px;">
                <option value="">-- Seleccione una opción --</option>

                @{
                    // 1. Extraemos el objeto del fondo de salud
                    var itemPorcentaje = Model.PreciosAperturas
                        .FirstOrDefault(x => x.ConceptoId == (int)ConceptosTarifariaEnum.PorcentajeFondoAyudaCentroSalud);

                    // 2. Nos aseguramos de tener el valor numérico puro en una variable C# local
                    decimal valorPorcentajeCapa = itemPorcentaje != null ? itemPorcentaje.PrecioBase : 0m;

                    // 3. Si el porcentaje guardado en BD es un entero (ej: 10 para 10%), lo normalizamos a coeficiente (0.10)
                    if (valorPorcentajeCapa > 1)
                    {
                        valorPorcentajeCapa = valorPorcentajeCapa / 100;
                    }

                    // 4. Filtramos las aperturas reales
                    var aperturas = Model.PreciosAperturas
                        .Where(x => x.ConceptoId != (int)ConceptosTarifariaEnum.PorcentajeFondoAyudaCentroSalud);

                    foreach (var apertura in aperturas)
                    {
                        // Calculamos el total para mostrarlo en el texto del select usando el coeficiente normalizado
                        decimal montoFondo = apertura.PrecioBase * valorPorcentajeCapa;
                        decimal total = apertura.PrecioBase + montoFondo;

                        // Formateamos los atributos con cultura invariante para evitar problemas de comas/puntos en JS
                        string strBase = apertura.PrecioBase.ToString(System.Globalization.CultureInfo.InvariantCulture);
                        string strPorcentaje = valorPorcentajeCapa.ToString(System.Globalization.CultureInfo.InvariantCulture);

                        <option value="@apertura.ConceptoId" data-base="@strBase" data-porcentaje="@strPorcentaje">
                            @apertura.Nombre (@total.ToString("C"))
                        </option>
                    }
                }
            </select>
        </div>

        <div id="contenedorTablaApertura" style="display:none; margin-top:20px;"></div>

    </div>
}


<!--Control de cobro de ingreso-->
@if (Model.Resumen.EstadoActualId == (int)EstadosIngresoEnum.IngresoRegistrado)
{
    <div class="control-cobro">
        <div class="switch-container">
            <label class="switch">
                <input type="checkbox" id="switchCobro" checked>
                <span class="slider"></span>
            </label>
            <label for="switchCobro" style="font-weight: bold; font-size: 16px; margin: 0;">
                <span id="labelCobro">Cobrar ingreso</span>
            </label>
        </div>

        <div id="selectorTablaContainer" class="selector-tabla-container active">
            <label style="font-weight: bold; margin-bottom: 10px; display: block;">
                Seleccione la tabla de precios a aplicar:
            </label>
            <select id="selectTabla" class="form-select" style="max-width: 600px;">
                <option value="">-- Seleccione una opción --</option>
                @{
                    int indexRegla = 0;
                    foreach (var regla in Model.PreciosIngresos)
                    {
                        var totalRegla = regla.Temas.Sum(t => t.Conceptos.Sum(c => c.PrecioBase));
                        var tipoParcelaNombre = EnumHelper.GetDisplayNameByValue<TipoParcelaEnum>(regla.TipoParcelaId);
                        <option value="@indexRegla" class="form-control form-select">
                            @regla.NombreRegla (@totalRegla.ToString("C"))
                        </option>
                        indexRegla++;
                    }
                }
            </select>
            <input type="hidden" id="tablaSeleccionadaId" name="tablaSeleccionadaId" value="" />
        </div>
    </div>

    <!--Tablas de precios de ingreso-->
    <div class="contenedor-principal" id="contenedorTablas" style="display: grid;">
        @{
            int contador = 0;
            foreach (var regla in Model.PreciosIngresos)
            {
                <div class="grupo-tabla" data-index="@contador" style="display: none;">
                    <table>
                        <!-- Encabezado principal -->
                        <tr>
                            <th colspan="2" style="font-size: 16px; padding: 8px;">
                                @(EnumHelper.GetDisplayNameByValue<TipoParcelaEnum>(regla.TipoParcelaId).ToUpper())
                            </th>
                            <th style="font-size: 16px; padding: 8px;">
                                @DateTime.Now.Year.ToString()
                            </th>
                        </tr>

                        <!-- Título de la regla -->
                        <tr class="titulo-regla">
                            <td colspan="3" class="bold" style="padding: 8px;">
                                @regla.NombreRegla
                            </td>
                        </tr>

                        @foreach (var tema in regla.Temas)
                        {
                            var totalTema = tema.Conceptos.Sum(c => c.PrecioBase);

                            <!-- Encabezado del tema -->
                            <tr>
                                <th colspan="2">Tema</th>
                                <th>Importe</th>
                            </tr>

                            <!-- Conceptos del tema -->
                            @for (int i = 0; i < tema.Conceptos.Count; i++)
                            {
                                var concepto = tema.Conceptos[i];

                                <tr>
                                    @if (i == 0)
                                    {
                                        <td class="bold grupo">@tema.Tema</td>
                                    }
                                    else if (i == tema.Conceptos.Count - 1)
                                    {
                                        <td class="grupo-fin"></td>
                                    }
                                    else
                                    {
                                        <td class="grupo-cont"></td>
                                    }

                                    <td class="td-contenido">@concepto.Nombre</td>
                                    <td class="right td-importe">
                                        @concepto.PrecioBase.ToString("C")
                                    </td>
                                </tr>
                            }

                            <!-- TOTAL POR TEMA -->
                            <tr>
                                <td></td>
                                <td class="bold">Total</td>
                                <td class="right bold">
                                    @totalTema.ToString("C")
                                </td>
                            </tr>

                            <!-- Espacio entre temas -->
                            <tr class="espacio">
                                <td colspan="3"></td>
                            </tr>
                        }

                        <!-- TOTAL POR REGLA -->
                        <tr class="total-ingreso">
                            <td colspan="2" class="bold">TOTAL INGRESO</td>
                            <td class="right bold">
                                @regla.Temas.Sum(t => t.Conceptos.Sum(c => c.PrecioBase)).ToString("C")
                            </td>
                        </tr>
                    </table>
                </div>

                contador++;
            }
        }
    </div>
}


