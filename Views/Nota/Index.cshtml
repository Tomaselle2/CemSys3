@using CemSys3.DTOs.Paginacion
@using CemSys3.Helpers.Enumerable
@using CemSys3.Enumerables  
@using CemSys3.ViewModels.Nota
@model NotaVM

@{
    ViewData["Title"] = "Notas";
}

<div class="page-header-container">
    <h1 class="title-page">Notas</h1>
</div>

<div class="dropdown m-lg-2">
    <button class="btn btn-success dropdown-toggle" type="button" data-bs-toggle="dropdown" aria-expanded="false">
       <i class="bi bi-plus"></i> Nota
    </button>
    <ul class="dropdown-menu">
        <li>
            <a class="dropdown-item" style="cursor: pointer"
               hx-get="@Url.Action("ModalIngreso", "Nota")"
               hx-target="#modal-container"
               hx-swap="innerHTML">
                Ingreso
            </a>
        </li>
        <li>
            <a class="dropdown-item" style="cursor: pointer"
               hx-get="@Url.Action("ModalRecordatorio", "Nota")"
               hx-target="#modal-container"
               hx-swap="innerHTML">
                Recordatorio
            </a>
        </li>
    </ul>
</div>

<!--Filtro-->
<div class="d-flex justify-content-start p-2">
    <form method="get"
          asp-action="Index"
          asp-controller="Nota"
          class="d-flex align-items-center gap-2">

        @* Mantener contexto *@
           <input type="hidden" name="pagina" value="1" />
           <input type="hidden" name="porPagina" value="@Model.Paginacion.RegistrosPorPagina" />


        @{
            int filtroSeleccionado = 0;
            int estadoSeleccionado = 0;

            if (Model.Paginacion.Parametros != null)
            {
                if (Model.Paginacion.Parametros.TryGetValue("filtro", out var filtro))
                {
                    int.TryParse(filtro, out filtroSeleccionado);
                }
                if (Model.Paginacion.Parametros.TryGetValue("estadoId", out var estado))
                {
                    int.TryParse(estado, out estadoSeleccionado);
                }
            }
        }
        

        <div class="d-flex justify-content-center align-items-end gap-4 p-3 flex-wrap">
            <label class="small text-muted fw-semibold">Mostrar:</label>

            <!-- Select de TipoNota -->
            <select name="filtro"
                    class="form-control shadow-sm form-select"
                    style="width: 160px"
                    onchange="this.form.submit()">
                @foreach (var item in EnumHelper.GetSelectListItems<TipoNotaEnum>())
                {
                    <option value="@item.Value" selected="@(item.Value == filtroSeleccionado.ToString())">
                        @item.Text
                    </option>
                }
            </select>

            <!-- Select de EstadosNota -->
            <select name="estadoId"
                    class="form-control shadow-sm form-select"
                    style="width: 160px"
                    onchange="this.form.submit()">
                @foreach (var item in EnumHelper.GetSelectListItems<EstadosNotaEnum>())
                {
                    <option value="@item.Value" selected="@(item.Value == estadoSeleccionado.ToString())">
                        @item.Text
                    </option>
                }
            </select>

            <div>
                <label class="form-label fw-semibold">Desde</label>
                <input type="date"
                       class="form-control shadow-sm"
                       name="fechaDesde"
                       style="width: 200px;"
                       value="@(Model.Paginacion.Parametros.TryGetValue("fechaDesde", out var fd) ? fd : "")" />
            </div>
            <div>
                <label class="form-label fw-semibold">Hasta</label>
                <input type="date"
                       class="form-control shadow-sm"
                       name="fechaHasta"
                       style="width: 200px;"
                       value="@(Model.Paginacion.Parametros.TryGetValue("fechaHasta", out var fh) ? fh : "")" />
            </div>
            <div class="text-center mt-3">
                <button type="submit" class="btn btn-success me-2" id="btnBuscar">Filtrar</button>
                <a asp-action="Index" asp-controller="Nota" class="btn btn-primary">Limpiar fechas</a>
            </div>
        </div>
    </form>
</div>

<!--Grilla de notas-->
@if (Model.ListaNotas != null && Model.ListaNotas.Any())
{
    <div class="container-fluid">
        <div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 g-2">
            @foreach (var nota in Model.ListaNotas)
            {
                <div class="col">
                    <div class="card h-100 cursor-pointer @(nota.TipoNotaId == (int)TipoNotaEnum.Recordatorio && nota.EstadoId == (int)EstadosNotaEnum.NotaPendiente && nota.FechaFinRecordatorio.HasValue && nota.FechaFinRecordatorio.Value < DateTime.Now ? "card-vencida" : "")"
                         style="background-color: @nota.Color;"
                         hx-get="@Url.Action(action: "Visualizar", controller: "Nota", values: new { id = nota.Id})"
                         hx-target="#modal-container"
                         hx-swap="innerHTML"
                         role="button"
                         tabindex="0">

                        <div class="card-header d-flex justify-content-between align-items-center">
                            <span class="badge bg-primary">
                                @(EnumHelper.GetDisplayNameByValue<TipoNotaEnum>(nota.TipoNotaId))
                            </span>
                            <span class="badge bg-black">
                                @(EnumHelper.GetDisplayNameByValue<EstadosNotaEnum>(nota.EstadoId))
                            </span>
                        </div>

                        <div class="card-body">
                            <h5 class="card-title">@nota.Nombre</h5>
                            <p class="card-text" style="white-space: pre-wrap;">
@(nota.Descripcion ?? "Sin descripción")
                            </p>
                        </div>
                        @if(nota.TipoNotaId == (int)TipoNotaEnum.Recordatorio)
                        {
                            <div>
                                <p class="text-center">Fecha límite: @nota.FechaFinRecordatorio?.ToString("dd/MM/yyyy HH:mm")</p>
                            </div>
                        }
                    </div>
                </div>
            }
        </div>
        @* Paginador *@
        @if (Model.Paginacion.TotalPaginas > 0)
        {
            @await Html.PartialAsync("_Paginador", new PaginacionDTO
            {
                PaginaActual = Model.Paginacion.PaginaActual,
                TotalPaginas = Model.Paginacion.TotalPaginas,
                TotalRegistros = Model.Paginacion.TotalRegistros,
                RegistrosPorPagina = Model.Paginacion.RegistrosPorPagina,
                Accion = "Index",
                Controlador = "Nota",
                Parametros = Model.Paginacion.Parametros
                })
        }
    </div>
}
else
{
    <div class="alert alert-info text-center mt-4" role="alert">
        <i class="bi bi-info-circle me-2"></i>
        No hay notas para mostrar con los filtros seleccionados.
    </div>
}

<div id="modal-container"></div>





@* Renderizamos el manejador pasándole el DTO del modelo *@
<partial name="_SweetAlertHandler" model="Model.SweetAlert" />

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/htmx.org@2.0.8/dist/htmx.min.js"></script>
    <partial name="_ValidationScriptsPartial" />
}


