@using CemSys3.DTOs.Paginacion
@using CemSys3.Helpers.Enumerable
@using CemSys3.Enumerables  
@using CemSys3.ViewModels.Nota
@model NotaVM

@{
    ViewData["Title"] = "Notas";
}

<div class="page-header-container">
    <h1 class="title-page">Notas</h1>
</div>

<!--Filtro-->
<div class="d-flex justify-content-start p-2">
    <form method="get"
          asp-action="Index"
          asp-controller="Nota"
          class="d-flex align-items-center gap-2">

        @* Mantener contexto *@
           <input type="hidden" name="pagina" value="1" />
           <input type="hidden" name="porPagina" value="@Model.Paginacion.RegistrosPorPagina" />

        <label class="small text-muted">Mostrar:</label>

        @{
            int filtroSeleccionado = 0;
            int estadoSeleccionado = 0;

            if (Model.Paginacion.Parametros != null)
            {
                if (Model.Paginacion.Parametros.TryGetValue("filtro", out var filtro))
                {
                    int.TryParse(filtro, out filtroSeleccionado);
                }
                if (Model.Paginacion.Parametros.TryGetValue("estadoId", out var estado))
                {
                    int.TryParse(estado, out estadoSeleccionado);
                }
            }
        }
        <!-- Select de TipoNota -->
        <select name="filtro"
                class="form-select form-select-sm"
                style="width: 160px"
                onchange="this.form.submit()">
            @foreach (var item in EnumHelper.GetSelectListItems<TipoNotaEnum>())
            {
                <option value="@item.Value" selected="@(item.Value == filtroSeleccionado.ToString())">
                    @item.Text
                </option>
            }
        </select>

        <!-- Select de EstadosNota -->
        <select name="estadoId"
                class="form-select form-select-sm"
                style="width: 160px"
                onchange="this.form.submit()">
            @foreach (var item in EnumHelper.GetSelectListItems<EstadosNotaEnum>())
            {
                <option value="@item.Value" selected="@(item.Value == estadoSeleccionado.ToString())">
                    @item.Text
                </option>
            }
        </select>
    </form>
</div>
<!--Grilla de notas-->
@if (Model.ListaNotas != null && Model.ListaNotas.Any())
{
    <div class="container-fluid">
        <div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 g-4">
            @foreach (var nota in Model.ListaNotas)
            {
                <div class="col">
                    <div class="card h-100 @GetCardColorClass(nota.Color)" style="border-left: 5px solid @GetColorHex(nota.Color);">
                        <div class="card-header d-flex justify-content-between align-items-center">
                            <span class="badge @GetEstadoBadgeClass(nota.EstadoId)">@GetEstadoNombre(nota.EstadoId)</span>
                            <small class="text-muted">@nota.FechaCreacion.ToString("dd/MM/yyyy HH:mm")</small>
                        </div>
                        <div class="card-body">
                            <h5 class="card-title">@nota.Nombre</h5>
                            <p class="card-text">@nota.Descripcion</p>

                            <!-- Información adicional -->
                            <div class="mt-3">
                                <div class="d-flex justify-content-between">
                                    <span class="badge bg-secondary">
                                        @GetTipoNotaNombre(nota.TipoNotaId)
                                    </span>
                                    <span class="badge @GetVisibilidadBadgeClass(nota.Visibilidad ? "activa" : "inactiva")">
                                        @nota.Visibilidad
                                    </span>
                                </div>
                            </div>
                        </div>
                        <div class="card-footer bg-transparent">
                            <div class="d-flex justify-content-end gap-2">
                                <!-- Botones de acción -->
                                <button class="btn btn-sm btn-outline-secondary"
                                        onclick="editarNota(@nota.Id)">
                                    <i class="bi bi-pencil"></i>
                                </button>
                                <button class="btn btn-sm btn-outline-danger"
                                        onclick="eliminarNota(@nota.Id, '@nota.Nombre')">
                                    <i class="bi bi-trash"></i>
                                </button>
                                @if (nota.EstadoId == (int)EstadosNotaEnum.NotaPendiente)
                                {
                                    <button class="btn btn-sm btn-success"
                                            onclick="marcarFinalizada(@nota.Id)">
                                        <i class="bi bi-check-circle"></i> Finalizar
                                    </button>
                                }
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
        @* Paginador *@
        @if (Model.Paginacion.TotalPaginas > 0)
        {
            @await Html.PartialAsync("_Paginador", new PaginacionDTO
            {
                PaginaActual = Model.Paginacion.PaginaActual,
                TotalPaginas = Model.Paginacion.TotalPaginas,
                TotalRegistros = Model.Paginacion.TotalRegistros,
                RegistrosPorPagina = Model.Paginacion.RegistrosPorPagina,
                Accion = "Index",
                Controlador = "Nota",
                Parametros = Model.Paginacion.Parametros
                })
        }
    </div>
}
else
{
    <div class="alert alert-info text-center mt-4" role="alert">
        <i class="bi bi-info-circle me-2"></i>
        No hay notas para mostrar con los filtros seleccionados.
    </div>
}

@{
    // Funciones helper para estilos
    string GetCardColorClass(string color)
    {
        return color?.ToLower() switch
        {
            "primary" => "text-bg-primary",
            "secondary" => "text-bg-secondary",
            "success" => "text-bg-success",
            "danger" => "text-bg-danger",
            "warning" => "text-bg-warning",
            "info" => "text-bg-info",
            "light" => "text-bg-light",
            "dark" => "text-bg-dark",
            _ => "text-bg-primary"
        };
    }

    string GetColorHex(string color)
    {
        return color?.ToLower() switch
        {
            "primary" => "#0d6efd",
            "secondary" => "#6c757d",
            "success" => "#198754",
            "danger" => "#dc3545",
            "warning" => "#ffc107",
            "info" => "#0dcaf0",
            "light" => "#f8f9fa",
            "dark" => "#212529",
            _ => "#0d6efd"
        };
    }

    string GetEstadoBadgeClass(int estadoId)
    {
        return estadoId switch
        {
            (int)EstadosNotaEnum.NotaPendiente => "bg-warning",
            (int)EstadosNotaEnum.NotaFinalizado => "bg-success",
            _ => "bg-secondary"
        };
    }

    string GetEstadoNombre(int estadoId)
    {
        return estadoId switch
        {
            (int)EstadosNotaEnum.NotaPendiente => "Pendiente",
            (int)EstadosNotaEnum.NotaFinalizado => "Finalizado",
            _ => "Desconocido"
        };
    }

    string GetTipoNotaNombre(int tipoNotaId)
    {
        return tipoNotaId switch
        {
            (int)TipoNotaEnum.Ingreso => "Ingreso",
            (int)TipoNotaEnum.Recordatorio => "Recordatorio",
            _ => "Desconocido"
        };
    }

    string GetVisibilidadBadgeClass(string visibilidad)
    {
        return visibilidad?.ToLower() switch
        {
            "publica" => "bg-success",
            "privada" => "bg-info",
            _ => "bg-secondary"
        };
    }
}

<!-- Scripts para las acciones -->
<script>
    function editarNota(id) {
        // Redirigir a la página de edición
        window.location.href = '@Url.Action("Edit", "Nota")' + '/' + id;
    }

    function eliminarNota(id, nombre) {
        if (confirm(`¿Está seguro que desea eliminar la nota "${nombre}"?`)) {
            $.post('@Url.Action("Delete", "Nota")', { id: id })
                .done(function(response) {
                    location.reload();
                })
                .fail(function() {
                    alert('Error al eliminar la nota');
                });
        }
    }

    function marcarFinalizada(id) {
        $.post('@Url.Action("MarcarFinalizada", "Nota")', { id: id })
            .done(function(response) {
                location.reload();
            })
            .fail(function() {
                alert('Error al marcar como finalizada');
            });
    }
</script>

@* Renderizamos el manejador pasándole el DTO del modelo *@
<partial name="_SweetAlertHandler" model="Model.SweetAlert" />

