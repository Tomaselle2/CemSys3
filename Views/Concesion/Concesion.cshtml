@using CemSys3.ViewModels.Concesion
@using CemSys3.Enumerables
@using CemSys3.Helpers.Enumerable
@using CemSys3.ViewModels.Historial
@model ConcesionVM

@{
    ViewData["Title"] = $"Concesion {Model.Dto.NroConcesion?.ToString("D5") }";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@await Html.PartialAsync("Concesion/_menuConcesion", Model.Dto.TramiteId)

<style>
    
</style>

@{
    string nroConcesion = Model.Dto.NroConcesion.HasValue ? Model.Dto.NroConcesion.Value.ToString("D5") : "-----";
    string estadoTramite = EnumHelper.GetDisplayNameByValue<EstadosConcesionEnum>(Model.Dto.EstadoTramiteId);
    string claseEstado = Enum.GetName(typeof(EstadosConcesionEnum), Model.Dto.EstadoTramiteId); string fechaVencimiento = Model.Dto.Vencimiento != null ? Model.Dto.Vencimiento.Value.ToString("dd/MM/yyyy") : "--/--/----";
    string tipoParcela = Model.Dto.TipoParcela ?? "N/A";
    string nombreSeccion = Model.Dto.NombreSeccion;

    string parcela = "";
    if (Model.Dto.TipoParcela == "Nicho") //nicho
    {
        parcela = $"Nicho {Model.Dto.NroParcela.ToString()} Fila {Model.Dto.NroFila.ToString()}";
    }

    if (Model.Dto.TipoParcela == "Fosa")//fosa
    {
        parcela = $"Fosa {Model.Dto.NroParcela.ToString()}";
    }

    if (Model.Dto.TipoParcela == "Panteón")//panteon
    {
        parcela = $"Lote {Model.Dto.NroParcela.ToString()}";
    }
}

<!-- Contenedor para alerta de htmx de informacion adicional -->
<div id="htmx-alert-container" style="display:none;"></div>

<!-- Panel lateral derecho del historial -->
@await Html.PartialAsync("HistorialPV/_HistorialOffcanvas",
new HistorialOffcanvasVM
{
    Historial = Model.historial,
    EnumType = typeof(EstadosConcesionEnum),
    OffcanvasId = $"offcanvasHistorial_{Model.Dto.TramiteId}",
    Titulo = "Historial de la concesión"
})

<div class="contenidoConcesion">
    <div class="cardsConcesion-row my-4">
        <div class="cardConcesion">
            <div class="cardConcesion-content">
                <span class="labelConcesion">NRO. CONCESIÓN</span>
                <h2>@nroConcesion</h2>
            </div>
        </div>

        <div class="cardConcesion estado-card">
            <div class="cardConcesion-content">
                <div class="d-flex justify-content-between align-items-center">
                    <span class="labelConcesion">ESTADO</span>
                    <!--Btn historial-->
                    <div>
                        <button class="btn btn-primary btn-sm" type="button" data-bs-toggle="offcanvas" title="Historial" data-bs-target="#offcanvasHistorial_@Model.Dto.TramiteId">
                            <i class="bi bi-clock-history"></i>
                        </button>
                    </div>
                </div>
                <span class="badgeConcesion @claseEstado px-3 py-2">@estadoTramite</span>

                @if (Model.Dto.EstadoTramiteId == (int)EstadosConcesionEnum.SinContrato)
                {
                    <div class="btn-container">
                        <form asp-action="GenerarContrato" asp-controller="Concesion" method="get" class="mt-2">
                            <input type="hidden" name="idTramite" value="@Model.Dto.TramiteId" />
                            <button type="submit" class="btn btn-danger btn-sm">Generar contrato</button>
                        </form>
                    </div>
                }else if(Model.Dto.PuedeRenovar)
                {
                    <div class="btn-container">
                        <form asp-action="GenerarContrato" asp-controller="Concesion" method="get" class="mt-2">
                            <input type="hidden" name="idTramite" value="@Model.Dto.TramiteId" />
                            <input type="hidden" name="EsRenovacion" value="true" />
                            <button type="submit" class="btn btn-danger btn-sm">Renovar contrato</button>
                        </form>
                    </div>
                }
            </div>
        </div>

        <div class="cardConcesion">
            <div class="cardConcesion-content">
                <span class="labelConcesion">VENCIMIENTO</span>
                <h2>@fechaVencimiento</h2>
            </div>
        </div>
    </div>

    <div class="gridConcesion">
        <div class="cardConcesion">

            <div class="cardConcesion-content">
                <div class="d-flex justify-content-between align-items-center">
                    <h3 class="mb-0">
                            <i class="bi bi-pin-map-fill text-primary"></i> Parcela
                    </h3>
                        <a asp-action="HistorialParcela"
                            asp-controller="Parcela"
                               asp-route-parcelaId="@Model.Dto.ParcelaId"
                            data-skip-loader="true"
                            target="_blank"
                            title="Historial parcela">
                        <i class="bi bi-arrow-up-right-square-fill fs-2"></i>
                    </a>
                </div>
                <p><strong>Tipo:</strong> @tipoParcela</p>
                <p><strong>Sección:</strong> @nombreSeccion.ToUpper()</p>
                <p><strong>Parcela:</strong> @parcela</p>
            </div>
        </div>
    
    @foreach (var titular in Model.Dto.Titulares)
    {
        <div class="cardConcesion">
            <div class="cardConcesion-content">
                <div class="d-flex justify-content-between align-items-center">
                    <h3 class="mb-0">
                        <i class="bi bi-person-fill text-primary"></i> Titular
                    </h3>
                    <a asp-action="HistorialPersona"
                        asp-controller="Persona"
                        asp-route-id="@titular.Id"
                        data-skip-loader="true"
                        target="_blank"
                        title="Historial titular">
                        <i class="bi bi-arrow-up-right-square-fill fs-2"></i>
                    </a>
                </div>
                <p><strong>Nombre:</strong> @titular.Apellido?.ToUpper(), @titular.Nombre?.ToUpper()</p>
                <p><strong>DNI:</strong> @(!string.IsNullOrEmpty(titular.Dni) ? titular.Dni : "")</p>
                <p><strong>Celular:</strong> @(!string.IsNullOrEmpty(titular.Celular) ? titular.Celular : "")</p>
                <p><strong>E-mail:</strong> @(!string.IsNullOrEmpty(titular.CorreoElectronico) ? titular.CorreoElectronico : "")</p>
                <p><strong>Domicilio:</strong> @(!string.IsNullOrEmpty(titular.Domicilio) ? titular.Domicilio : "")</p>
            </div>
        </div>
    }
</div>

@foreach (var difunto in Model.Dto.Difuntos)
{
    <div class="cardConcesion mb-3 my-3">
        <div class="cardConcesion-content">
            <div class="d-flex justify-content-between align-items-center">
                <h3 class="mb-0">
                    <i class="bi bi-person-fill-x text-primary"></i> Difunto
                </h3>
                <a asp-action="HistorialPersona"
                   asp-controller="Persona"
                   asp-route-id="@difunto.Id"
                   data-skip-loader="true"
                   target="_blank"
                   title="Historial difunto">
                    <i class="bi bi-arrow-up-right-square-fill fs-2"></i>
                </a>
            </div>
            <p><strong>Nombre:</strong> @difunto.Apellido?.ToUpper(), @difunto.Nombre?.ToUpper()</p>
            <p><strong>DNI:</strong> @(!string.IsNullOrEmpty(difunto.DNI) ? difunto.DNI : "")</p>
            <p><strong>Ingreso:</strong> @(!string.IsNullOrEmpty(difunto.FechaIngreso.ToString()) ? difunto.FechaIngreso?.ToString("dd/MM/yyyy HH:mm") : "")</p>
            <p>
                <strong>Estado:</strong> @(EnumHelper.GetDisplayNameByValue<EstadoDifuntoEnum>(difunto.EstadoDifuntoId ?? 0))
            </p>
        </div>
    </div>
}

    <div class="cardConcesion mb-3 my-3">
        <div class="cardConcesion-content">
            <div class="d-flex justify-content-between align-items-center">
                <h3 class="mb-0">
                    <i class="bi bi-info-circle-fill text-primary"></i> Informacion adicional
                </h3>
            </div>
            <div>
                <textarea id="textareaInfoAdicional" name="informacionAdicionaTramite" style="overflow:hidden;" 
                oninput="document.getElementById('btnActualizar').disabled = false; autoResize(this)" class="form-control auto-resize" 
                asp-for="Dto.InfoAdicional"></textarea>
            </div>
            <div class="my-2">
                <input type="hidden" name="tramiteId" value="@Model.Dto.TramiteId" id="tramiteIdHidden" />
                <input type="submit" id="btnActualizar" class="btn btn-success" value="Actualizar" disabled
                       hx-post="/Tramite/ActualizarInfoAdicionalTramite"
                       hx-include="#textareaInfoAdicional, #tramiteIdHidden"
                       hx-target="#htmx-alert-container"
                       hx-swap="innerHTML" />
            </div>
        </div>
    </div>
</div>

@* Renderizamos el manejador pasándole el DTO del modelo *@
<partial name="_SweetAlertHandler" model="Model.SweetAlert" />
@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/htmx.org@2.0.8/dist/htmx.min.js"></script>
     <partial name="_ValidationScriptsPartial" />
     <script>
        function autoResize(textarea) {
            textarea.style.height = 'auto';
            textarea.style.height = textarea.scrollHeight + 'px';
        }


        window.addEventListener('DOMContentLoaded', () => {
                document.querySelectorAll('.auto-resize').forEach(t => autoResize(t));
        });
    </script>
}