@using CemSys3.DTOs.Paginacion
@using CemSys3.Enumerables
@using CemSys3.Helpers.Enumerable
@using CemSys3.ViewModels.Concesion
@using CemSys3.ViewModels.Ingreso
@model TablaGeneralVM

@{
    ViewData["Title"] = "Tabla concesiones";
}

<!-- Tabla General de concesiones -->
<div class="accordion" id="accordionConcesiones">
    <div class="accordion-item">
        <h2 class="accordion-header" id="panelsStayOpen-headingConcesiones">
            <button class="accordion-button nueva-seccion acordeon-fijo">
                <i class="bi bi-table me-2"></i>
                Tabla General de Concesiones
            </button>
        </h2>
        <div>
            <form asp-action="TablaGeneral" method="get">

                <input type="hidden" id="estadoDelDifunto" value="2" />

                <div class="card shadow-sm border-0 mb-4">
                    <div class="card-body">

                        <!-- Concesión - Nombre - Apellido -->
                        <div class="row g-3 mb-3">

                            <div class="col-md-4">
                                <label for="concesionInput" class="form-label fw-semibold">
                                    Nro. Concesión
                                </label>
                                <input class="form-control"
                                       id="concesionInput"
                                       name="concesion"
                                       value="@(Model.Concesion == 0 ? "" : Model.Concesion?.ToString("D5"))" />
                            </div>

                            <div class="col-md-4">
                                <label for="nombreInput" class="form-label fw-semibold">
                                    Nombre
                                </label>
                                <input class="form-control"
                                       id="nombreInput"
                                       name="nombre"
                                       type="text"
                                       asp-for="Nombre"
                                       maxlength="60"
                                       minlength="2"
                                       autocomplete="off" />
                            </div>

                            <div class="col-md-4">
                                <label for="apellidoInput" class="form-label fw-semibold">
                                    Apellido
                                </label>
                                <input class="form-control"
                                       id="apellidoInput"
                                       name="apellido"
                                       type="text"
                                       asp-for="Apellido"
                                       maxlength="60"
                                       minlength="2"
                                       autocomplete="off" />
                            </div>

                        </div>

                        @{
                            int filtroSeleccionado = 0;

                            if (Model.Paginacion.Parametros != null &&
                                Model.Paginacion.Parametros.ContainsKey("filtroEstado"))
                            {
                                int.TryParse(
                                    Model.Paginacion.Parametros["filtroEstado"],
                                    out filtroSeleccionado
                                );
                            }
                        }

                        <!-- Estado -->
                        <div class="row g-3 mb-4">

                            <div class="col-md-3">
                                <label class="form-label fw-semibold">
                                    Estado
                                </label>

                                <select name="filtroEstado"
                                        class="form-select"
                                        asp-items="EnumHelper.GetSelectListItems<EstadosConcesionEnum>(filtroSeleccionado)">
                                </select>
                            </div>

                        </div>

                        <!-- Ubicación -->
                        <div class="mb-4">

                            @await Html.PartialAsync(
                            "IngresoPV/_SelectorUbicacion",
                            new SelectorUbicacionVM
                            {
                                TipoParcelaID = Model.TipoParcelaID,
                                SeccionID = Model.SeccionID,
                                ParcelaID = Model.ParcelaID,

                                TipoParcelaName = "TipoParcelaID",
                                SeccionName = "SeccionID",
                                ParcelaName = "ParcelaID",

                                UrlSecciones = Url.Action("ObtenerSeccionesPorTipo", "Seccion") ?? "",
                                UrlParcelas = Url.Action("ObtenerParcelasPorSeccion", "Parcela") ?? "",
                            })

                        </div>

                        <!-- Fechas -->
                        <div class="row g-3 mb-4">

                            <div class="col-md-3">
                                <label class="form-label fw-semibold">
                                    Vencimiento Desde
                                </label>

                                <input type="date"
                                       class="form-control"
                                       asp-for="FechaDesde"
                                       name="fechaDesde" />
                            </div>

                            <div class="col-md-3">
                                <label class="form-label fw-semibold">
                                    Vencimiento Hasta
                                </label>

                                <input type="date"
                                       class="form-control"
                                       asp-for="FechaHasta"
                                       name="fechaHasta" />
                            </div>

                        </div>

                        <!-- Hidden -->
                        <input type="hidden"
                               id="tipoParcelaID"
                               name="tipoParcelaID"
                               asp-for="TipoParcelaID" />

                        <input type="hidden"
                               id="seccionID"
                               name="seccionID"
                               asp-for="SeccionID" />

                        <input type="hidden"
                               id="parcelaID"
                               name="parcelaID"
                               asp-for="ParcelaID" />

                        <!-- Botones -->
                        <div class="d-flex justify-content-end gap-2">

                            <a asp-action="TablaGeneral"
                                   asp-controller="Concesion"
                                   class="btn btn-outline-secondary">

                                <i class="bi bi-eraser"></i>
                                Limpiar filtros
                            </a>

                            <button type="submit"
                                    class="btn btn-primary">

                                <i class="bi bi-search"></i>
                                Buscar
                            </button>

                        </div>

                    </div>
                </div>

            </form>
            
        </div>
        <div id="panelsStayOpen-collapseConcesiones" class="accordion-collapse collapse show" aria-labelledby="panelsStayOpen-headingConcesiones">
            @if (Model.Listado != null && Model.Listado.Count() > 0)
            {
                <div class="card shadow-sm">
                    <div class="card-body p-0 table-responsive">
                        <table class="table table-hover align-middle mb-0 table-bordered">
                            <thead class="table-light">
                                <tr>
                                    <th>Concesión</th>
                                    <th>Difunto/s</th>
                                    <th>Sección</th>
                                    <th>Parcela</th>
                                    <th>Titular</th>
                                    <th>Vencimiento</th>
                                    <th>Estado</th>
                                    <th>Acción</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var opc in Model.Listado)
                                {
                                    string parcela = "";
                                    string estadoTramiteDisplay = EnumHelper.GetDisplayNameByValue<EstadosConcesionEnum>(opc.EstadoTramiteId);

                                    if (opc.TipoParcelaId == (int)TipoParcelaEnum.Nicho) //nicho
                                    {
                                        parcela = $"Nicho {opc.NroParcela.ToString()} Fila {opc.NroFila.ToString()}";
                                    }
                                    else if (opc.TipoParcelaId == (int)TipoParcelaEnum.Fosa)//fosa
                                    {
                                        parcela = $"Fosa {opc.NroParcela.ToString()}";
                                    }
                                    else if (opc.TipoParcelaId == (int)TipoParcelaEnum.Panteon) //panteon
                                    {
                                        parcela = $"Lote {opc.NroParcela.ToString()}";
                                    }

                                    string colorFila = string.Empty;

                                    DateOnly hoy = DateOnly.FromDateTime(DateTime.Today);

                                    if (opc.EstadoTramiteId == (int)EstadosConcesionEnum.Vencido)
                                    {
                                        colorFila = "table-danger";
                                    }
                                    else if (opc.Vencimiento.HasValue)
                                    {
                                        DateOnly vencimiento = opc.Vencimiento.Value;

                                        if (vencimiento.Year == hoy.Year && vencimiento >= hoy)
                                        {
                                            colorFila = "table-warning";
                                        }
                                    }
                                    else if (opc.EstadoTramiteId == (int)EstadosConcesionEnum.Caducado)
                                    {
                                        colorFila = "table-dark";
                                    }

                                    <tr class="@colorFila">
                                        <td>@(opc.Concesion != null ? opc.Concesion.Value.ToString("D5") : "---")</td>
                                        <td>
                                            @(opc.Difuntos != null && opc.Difuntos.Any()
                                                                                ? Html.Raw(string.Join("<br>",
                                                                                opc.Difuntos.Select(d => $"{d.Apellido.ToUpper()}, {d.Nombre.ToUpper()}")))
                                                                                : "---")
                                        </td>
                                        <td>@opc.NombreSeccion.ToUpper()</td>
                                        <td>@parcela</td>
                                        <td>
                                            @(opc.Titulares != null && opc.Titulares.Any()
                                                                                ? Html.Raw(string.Join("<br>",
                                                                                opc.Titulares.Select(t => $"{t.Apellido.ToUpper()}, {t.Nombre.ToUpper()}")))
                                                                                : "---")
                                        </td>
                                        <td>@opc.Vencimiento?.ToString("dd/MM/yyyy")</td>
                                        <td>@estadoTramiteDisplay</td>
                                        <td>
                                            <a asp-action="Concesion" asp-controller="Concesion" asp-route-tramiteId="@opc.TramiteId" title="Ir a conesión" target="_blank"><i class="bi bi-box-arrow-in-right fs-3"></i></a>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>

                //paginador
                @* Paginador *@
                @if (Model.Paginacion.TotalPaginas > 0)
                {
                    @await Html.PartialAsync("_Paginador", new PaginacionDTO
                    {
                        PaginaActual = Model.Paginacion.PaginaActual,
                        TotalPaginas = Model.Paginacion.TotalPaginas,
                        TotalRegistros = Model.Paginacion.TotalRegistros,
                        RegistrosPorPagina = Model.Paginacion.RegistrosPorPagina,
                        Accion = "TablaGeneral",
                        Controlador = "Concesion",
                        Parametros = Model.Paginacion.Parametros
                    })
                }
            }
            else
            {
                <div class="alert alert-info" role="alert">
                    <i class="fas fa-info-circle"></i>
                    No hay concesiones
                </div>
            }
        </div>
    </div>
</div>


@* Renderizamos el manejador pasándole el DTO del modelo *@
<partial name="_SweetAlertHandler" model="Model.SweetAlert" />

@section Scripts {
    <partial name="_ValidationScriptsPartial" />

    <script src="~/js/ubicacion-selector.js"></script>

}