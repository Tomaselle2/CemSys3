@using CemSys3.Enumerables
@using CemSys3.Helpers.Enumerable
@using CemSys3.ViewModels.Concesion
@model HistorialConcesionVM

@{
    ViewData["Title"] = $"Historial Concesión";
    Layout = "~/Views/Shared/_Layout.cshtml";

    string nroConcesion = Model.Dto.NroConcesion.HasValue ? Model.Dto.NroConcesion.Value.ToString("D5") : "-----";
    string estadoTramite = EnumHelper.GetDisplayNameByValue<EstadosConcesionEnum>(Model.Dto.EstadoTramiteId);
    string claseEstado = Enum.GetName(typeof(EstadosConcesionEnum), Model.Dto.EstadoTramiteId); string fechaVencimiento = Model.Dto.Vencimiento != null ? Model.Dto.Vencimiento.Value.ToString("dd/MM/yyyy") : "--/--/----";
}

@await Html.PartialAsync("Concesion/_menuConcesion", Model.TramiteId)

<div class="contenidoConcesion">

    <div class="cardsConcesion-row my-4">
        <div class="cardConcesion">
            <div class="cardConcesion-content">
                <span class="labelConcesion">NRO. CONCESIÓN</span>
                <h2>@nroConcesion</h2>
            </div>
        </div>

        <div class="cardConcesion estado-card">
            <div class="cardConcesion-content">
                <div class="d-flex justify-content-between align-items-center">
                    <span class="labelConcesion">ESTADO</span>
                </div>
                <span class="badgeConcesion @claseEstado px-3 py-2">@estadoTramite</span>

                @if (Model.Dto.EstadoTramiteId == (int)EstadosConcesionEnum.SinContrato)
                {
                    <div class="btn-container">
                        <form asp-action="GenerarContrato" asp-controller="Concesion" method="get" class="mt-2">
                            <input type="hidden" name="idTramite" value="@Model.Dto.TramiteId" />
                            <button type="submit" class="btn btn-danger btn-sm">Generar contrato</button>
                        </form>
                    </div>
                }

                @if (Model.Dto.EstadoTramiteId == (int)EstadosConcesionEnum.Vencido)
                {
                    <div class="btn-container">
                        <form asp-action="GenerarContrato" asp-controller="Concesion" method="get" class="mt-2">
                            <input type="hidden" name="idTramite" value="@Model.Dto.TramiteId" />
                            <button type="submit" class="btn btn-danger btn-sm">Renovar contrato</button>
                        </form>
                    </div>
                }
            </div>
        </div>

        <div class="cardConcesion">
            <div class="cardConcesion-content">
                <span class="labelConcesion">VENCIMIENTO</span>
                <h2>@fechaVencimiento</h2>
            </div>
        </div>
    </div>



    <!-- Tabla de historial de tramites -->
    <div class="accordion" id="accordionPanelsStayOpenExample">
        <div class="accordion-item">
            <h2 class="accordion-header" id="panelsStayOpen-headingOne">
                <button class="accordion-button nueva-seccion acordeon-fijo" type="button" data-bs-toggle="" data-bs-target="#panelsStayOpen-collapseOne" aria-expanded="false" aria-controls="panelsStayOpen-collapseOne">
                    Historial de trámites (@Model.Tramites.Count())
                </button>
            </h2>
            <div id="panelsStayOpen-collapseOne" class="accordion-collapse collapse show" aria-labelledby="panelsStayOpen-headingOne">
                @* cuerpo del acordion *@
                @if (Model.Tramites.Any())
                {
                    <div class="card shadow-sm">
                        <div class="card-body p-0">
                            <table class="table table-hover mb-0">
                                <thead class="table-light">
                                    <tr>
                                        <th>Trámite</th>
                                        <th>Fecha inicio</th>
                                        <th>Tipo de Trámite</th>
                                        <th>Estado</th>
                                        <th>Acción</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var opc in Model.Tramites)
                                    {
                                        string tipoTramiteDisplay = EnumHelper.GetDisplayNameByValue<TipoTramiteEnum>(opc.TipoTramiteId);
                                        string estadoTramiteDisplay = EnumHelper.GetDisplayNameByValue<EstadosTramiteEnum>(opc.EstadoActualId);

                                        <tr>
                                            <td>@opc.Id</td>
                                            <td>@(opc.FechaCreacion.ToString("dd/MM/yyyy HH:mm"))</td>
                                            <td>@tipoTramiteDisplay</td>
                                            <td>@estadoTramiteDisplay</td>
                                            <td>
                                                <form asp-action="IrATramite" asp-controller="Tramite" target="_blank" method="get" style="display: inline-block;" data-skip-loader="true">
                                                    <input type="hidden" name="tramiteId" value="@opc.Id" />
                                                    <button type="submit" class="btn btn-secondary btn-sm" title="Ir al trámite">
                                                        <i class="bi bi-eye"></i>
                                                    </button>
                                                </form>
                                            </td>
                                        </tr>

                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>
                }
                else
                {
                    <div class="alert alert-info" role="alert">
                        <i class="fas fa-info-circle"></i>
                        No hay historial de tramites en esta concesión.
                    </div>
                }
                @* Fin cuerpo del acordeon *@
            </div>
        </div>
    </div>



    <!-- Tabla de historial de difuntos actuales -->
    <div class="accordion" id="accordionPanelsStayOpenExample">
        <div class="accordion-item">
            <h2 class="accordion-header" id="panelsStayOpen-headingOne">
                <button class="accordion-button nueva-seccion acordeon-fijo" type="button" data-bs-toggle="" data-bs-target="#panelsStayOpen-collapseOne" aria-expanded="false" aria-controls="panelsStayOpen-collapseOne">
                    Historial de titulares
                </button>
            </h2>
            <div id="panelsStayOpen-collapseOne" class="accordion-collapse collapse show" aria-labelledby="panelsStayOpen-headingOne">
                @* cuerpo del acordion *@
                @if (Model.Titulares.Any())
                {
                    <div class="card shadow-sm">
                        <div class="card-body p-0">
                            <table class="table table-hover mb-0">
                                <thead class="table-light">
                                    <tr>
                                        <th>Titular</th>
                                        <th>Fecha inicio</th>
                                        <th>Fecha fin</th>
                                        <th>Acción</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var opc in Model.Titulares)
                                    {
                                        <tr>
                                            <td>@($"{opc.Apellido?.ToUpper()}, {opc.Nombre?.ToUpper()}")</td>
                                            <td>@(opc.FechaInicio != null ? opc.FechaInicio?.ToString("dd/MM/yyyy HH:mm") : "")</td>
                                            <td>@(opc.FechaFin != null ? opc.FechaFin?.ToString("dd/MM/yyyy HH:mm") : "")</td>
                                            <td>
                                                <form asp-action="HistorialPersona" asp-controller="Persona" target="_blank" method="get" style="display: inline-block;" data-skip-loader="true">
                                                    <input type="hidden" name="id" value="@opc.PersonaId" />
                                                    <button type="submit" class="btn btn-secondary btn-sm" title="Ir al historial">
                                                        <i class="bi bi-clock"></i>
                                                    </button>
                                                </form>
                                            </td>
                                        </tr>

                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>
                }
                else
                {
                    <div class="alert alert-info" role="alert">
                        <i class="fas fa-info-circle"></i>
                        No hay titulares en esta concesión.
                    </div>
                }
                @* Fin cuerpo del acordeon *@
            </div>
        </div>
    </div>


</div>



@* Renderizamos el manejador pasándole el DTO del modelo *@
<partial name="_SweetAlertHandler" model="Model.SweetAlert" />