        }



        // Función para formatear el DNI con puntos cada 3 dígitos
        function formatearDNI(dni) {
            if (!dni) return "--------";
            return dni.replace(/\B(?=(\d{3})+(?!\d))/g, ".");
        }

                function SubirContrato() {
            btnSubirContrato.style.display = 'block';

            if (!btnSubirContrato.dataset.listenerAdded) {
                btnSubirContrato.addEventListener('click', () => {
                    const modalHTML = `
                    <div class="modal fade" id="modalSubirContrato" tabindex="-1">
                        <div class="modal-dialog">
                            <div class="modal-content">
                                <div class="modal-header">
                                    <h5 class="modal-title">Confirmar acción</h5>
                                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                                </div>
                                <div class="modal-body">
                                    <p>El contrato debe estar firmado y escaneado para continuar.</p>
                                    <p><strong>¿Desea confirmar el contrato?</strong></p>
                                </div>
                                <div class="modal-footer">
                                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">
                                        Cancelar
                                    </button>
                                    <button type="button" class="btn btn-primary" id="btnConfirmarContrato">
                                        Confirmar
                                    </button>
                                </div>
                            </div>
                        </div>
                    </div>
                    `;

                    document.body.insertAdjacentHTML('beforeend', modalHTML);

                    const modalElement = document.getElementById('modalSubirContrato');
                    const modal = new bootstrap.Modal(modalElement);
                    modal.show();

                    // BOTÓN CONFIRMAR
                    document.getElementById('btnConfirmarContrato').addEventListener('click', () => {
                        const btnConfirmar = document.getElementById('btnConfirmarContrato');

                        // Deshabilitar botón de confirmar
                        btnConfirmar.disabled = true;
                        btnConfirmar.innerHTML = '<span class="spinner-border spinner-border-sm me-2" role="status"></span> Procesando...';

                        // Obtener referencia al botón de generar contrato original
                        const btnGenerarOriginal = document.getElementById('btnGenerarContrato');

                        // Deshabilitar el botón de generar contrato si existe
                        if (btnGenerarOriginal) {
                            btnGenerarOriginal.disabled = true;
                        }

                        // CAMBIAR ACCIÓN DEL FORM PRINCIPAL
                        formPrincipal.action = '/Concesion/ContratoFirmado';
                        formPrincipal.target = '_self'; // importante

                        formPrincipal.submit();
                    });

                    // limpiar modal al cerrar
                    modalElement.addEventListener('hidden.bs.modal', () => {
                        modalElement.remove();
                    });
                });

                btnSubirContrato.dataset.listenerAdded = "true";
            }
