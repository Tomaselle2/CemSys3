@using CemSys3.Enumerables
@{
    ViewData["Title"] = $"Secciones";
}
<h1 class="title-page">Secciones</h1>
<div class="container3">
    <a asp-action="IndexSeccionesNichos" class="btn-inicio">
        <i class="bi bi-bricks"></i>
        <span>Nichos</span>
    </a>
    <a asp-action="IndexSeccionesFosas" class="btn-inicio">
        <i class="bi bi-water"></i>
        <span>Fosas</span>
    </a>
    <a asp-action="IndexSeccionesPanteones" class="btn-inicio">
        <i class="bi bi-house-door"></i>
        <span>Panteones</span>
    </a>
</div>
<hr />
@if (Context.Session.GetInt32("IdRol") == (int)RolUsuario.Administrador)
{
    <div class="container3 my-3">
        <a class="btn-inicio" data-no-loader href="@Url.Action("ExportarSecciones", "Seccion")">
            Descargar todas las secciones
        </a>

        <a class="btn-inicio" data-no-loader href="@Url.Action("ExportarParcelas", "Seccion")">
            Descargar todas las parcelas
        </a>
    </div>

    <form asp-action="ImportarSecciones" asp-controller="Seccion" method="post" enctype="multipart/form-data" class="mb-3">
        <input type="file" name="excel" accept=".xlsx" class="form-control shadow-sm mb-3" required />

        <button type="submit" class="btn btn-primary">Importar Secciones</button>
    </form>

    <form asp-action="ImportarParcelas" asp-controller="Seccion" method="post" enctype="multipart/form-data" class="mb-3">
        <input type="file" name="excel" accept=".xlsx" class="form-control shadow-sm mb-3" required />
        <button type="submit" class="btn btn-primary">Importar Parcelas</button>
    </form>

    
}



