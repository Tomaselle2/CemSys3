@using CemSys3.DTOs.Paginacion
@using CemSys3.ViewModels.Seccion
@using CemSys3.Helpers.Enumerable
@using CemSys3.Enumerables
@model SeccionVM

@{
    ViewData["Title"] = "Secciones de fosas";
    string vistaRedirigir = Model.TipoParcelaId switch
    {
        (int)TipoParcelaEnum.Nicho => "IndexSeccionesNichos",
        (int)TipoParcelaEnum.Fosa => "IndexSeccionesFosas",
        (int)TipoParcelaEnum.Panteon => "IndexSeccionesPanteones",
        _ => "IndexSeccionesPanteones"
    };
}

<div class="page-header-container">
    <a asp-action="Index" asp-controller="Seccion" class="btn btn-secondary m-3" title="Secciones"><i class="bi bi-arrow-left"></i></a>
    <h1 class="title-page">Gestión de secciones de fosas</h1>
</div>

<!--Formulario de registro-->
@if (Context.Session.GetInt32("IdRol") == (int)RolUsuario.Administrador) //Administrador
{
    <div class="accordion" id="accordionPanelsStayOpenExample">
        <div class="accordion-item">
            <h2 class="accordion-header" id="panelsStayOpen-headingOne">
                <button class="accordion-button nueva-seccion acordeon-fijo" type="button" data-bs-toggle="" data-bs-target="#panelsStayOpen-collapseOne" aria-expanded="false" aria-controls="panelsStayOpen-collapseOne">
                    @(Model.EsEdicion ? "Modificar sección" : "Nueva sección")
                </button>
            </h2>
            <div id="panelsStayOpen-collapseOne" class="accordion-collapse collapse show" aria-labelledby="panelsStayOpen-headingOne">
                <div class="accordion-body">
                    @* cuerpo del acordion *@
                    <form asp-action="Guardar" method="post" class="form-box">
                        <input type="hidden" asp-for="Id" />
                        <input type="hidden" asp-for="TipoParcelaId" />
                        <input type="hidden" asp-for="Filas" />
                        <input type="hidden" asp-for="TipoNumeracionParcelaId" />


                        <div class="form-columns-container3">
                            <div>
                                <label for="nombre" class="form-label">Nombre<span class="obligatorio"> * </span></label>
                                <input class="form-control" type="text" asp-for="Nombre" required maxlength="50" id="nombre" />
                                <span asp-validation-for="Nombre" class="text-danger"></span>
                            </div>

                            <div>
                                <label for="nroNichos" class="form-label">Cantidad de fosas<span class="obligatorio"> * </span></label>
                                <input class="form-control" type="number" asp-for="NroParcelas" required id="nroNichos" min="1" />
                                <span asp-validation-for="NroParcelas" class="text-danger"></span>
                            </div>
                        </div>
                        <div class="form-button-registrar">
                            <input class="btn @Model.ClaseBoton" type="submit" value="@Model.TextoBoton" />
                        </div>
                    </form>
                    @* Fin cuerpo del acordeon *@
                </div>
            </div>
        </div>
    </div>
}


<!-- Tabla -->
<div class="accordion" id="accordionPanelsStayOpenExample">
    <div class="accordion-item">
        <h2 class="accordion-header" id="panelsStayOpen-headingOne">
            <button class="accordion-button nueva-seccion acordeon-fijo" type="button" data-bs-toggle="" data-bs-target="#panelsStayOpen-collapseOne" aria-expanded="false" aria-controls="panelsStayOpen-collapseOne">
                Secciones registradas
            </button>
        </h2>
        <div id="panelsStayOpen-collapseOne" class="accordion-collapse collapse show" aria-labelledby="panelsStayOpen-headingOne">
            @* cuerpo del acordion *@
            @if (Model.ListadoSecciones.Any())
            {
                <div class="card shadow-sm">
                    <div class="card-body p-0">
                        <table class="table table-hover mb-0">
                            <thead class="table-light">
                                <tr>
                                    <th>Nombre</th>
                                    <th>Fosas</th>
                                    <th>Estado</th>
                                    <th>Acciones</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var opc in Model.ListadoSecciones)
                                {
                                    <tr>
                                        <td>@opc.Nombre.ToUpper()</td>
                                        <td>@opc.NroParcelas</td>
                                        <td>@(opc.Visibilidad == true ? "Activa" : "Inactiva")</td>
                                        <td>
                                            @if (Context.Session.GetInt32("IdRol") == (int)RolUsuario.Administrador && opc.Visibilidad == true) //Administrador
                                            {
                                                <form asp-action="Editar" asp-controller="Seccion" method="get" style="display: inline-block;"> 
                                                    <input type="hidden" asp-for="Id" value="@opc.Id" name="id" />
                                                    <input type="hidden" asp-for="TipoParcelaId" value="@opc.TipoParcelaId" name="TipoParcelaId" />

                                                    <button type="submit" class="btn btn-warning btn-sm btn-lista" title="Editar">
                                                        <i class="bi bi-pencil"></i>
                                                    </button>
                                                </form>
                                                <form asp-action="AddOne" asp-controller="Seccion" class="js-confirm"
                                                      method="get" style="display: inline-block;"
                                                      data-confirm-title="Confirmar acción"
                                                      data-confirm-message="¿Está seguro de agregar una fosa más?"
                                                      data-confirm-icon="question">
                                                    
                                                    <input type="hidden" asp-for="Id" name="id" value="@opc.Id" />
                                                    <input type="hidden" asp-for="TipoParcelaId" value="@opc.TipoParcelaId" name="TipoParcelaId" />


                                                    <button type="submit" class="btn btn-info btn-sm btn-lista js-confirm" title="Agregar fosa">
                                                        <i class="bi bi-plus-square"></i>
                                                    </button>
                                                </form>
                                                <form asp-action="Eliminar" asp-controller="Seccion" class="js-confirm"
                                                      method="get" style="display: inline-block;" id="formularioEliminar"
                                                      data-confirm-title="Confirmar eliminación"
                                                      data-confirm-message="¿Está seguro de eliminar la sección @opc.Nombre.ToUpper()?"
                                                      data-confirm-icon="warning">

                                                    <input type="hidden" asp-for="Id" name="id" value="@opc.Id" />
                                                    <input type="hidden" asp-for="TipoParcelaId" value="@opc.TipoParcelaId" name="TipoParcelaId" />


                                                    <button type="submit" class="btn btn-danger btn-sm btn-lista" title="Eliminar">
                                                        <i class="bi bi-trash"></i>
                                                    </button>
                                                </form>
                                            }

                                            @if (Context.Session.GetInt32("IdRol") == (int)RolUsuario.Empleado) //Empleado
                                            {
                                                <form asp-action="Index" asp-controller="Parcela" method="get" style="display: inline-block;">
                                                    <input type="hidden" name="seccionId" value="@opc.Id" />

                                                    <button type="submit" class="btn btn-secondary btn-lista btn-sm" title="Inspeccionar">
                                                        <i class="bi bi-eye"></i>
                                                    </button>
                                                </form>
                                            }
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            }
            else
            {
                <div class="alert alert-info mt-3" role="alert">
                    <i class="bi bi-info-circle me-2"></i> No se encontraron registros de secciones.
                </div>
            }
            @* Fin cuerpo del acordeon *@

            @* Paginador *@
            @if (Model.Paginacion.TotalPaginas > 0)
            {
                @await Html.PartialAsync("_Paginador", new PaginacionDTO
                {
                    PaginaActual = Model.Paginacion.PaginaActual,
                        TotalPaginas = Model.Paginacion.TotalPaginas,
                        TotalRegistros = Model.Paginacion.TotalRegistros,
                        RegistrosPorPagina = Model.Paginacion.RegistrosPorPagina,
                        Accion = @vistaRedirigir,
                        Controlador = "Seccion",
                        Parametros = Model.Paginacion.Parametros
                        })
                        }
        </div>
    </div>
</div>

@if (Context.Session.GetInt32("IdRol") == (int)RolUsuario.Administrador)
{
    <div class="accordion mt-4" id="accordionEliminarParcela">
        <div class="accordion-item">
            <h2 class="accordion-header" id="headingEliminarParcela">
                <button class="accordion-button acordeon-fijo" type="button" data-bs-toggle="" data-bs-target="#collapseEliminarParcela" aria-expanded="false" aria-controls="collapseEliminarParcela">
                    Eliminar fosa individual
                </button>
            </h2>
            <div id="collapseEliminarParcela" class="accordion-collapse collapse show" aria-labelledby="headingEliminarParcela">
                <div class="accordion-body">
                    <form asp-action="EliminarParcela" asp-controller="Seccion" method="get" class="form-box js-confirm"
                          data-confirm-title="Confirmar eliminación"
                          data-confirm-message="¿Está seguro de ELIMINAR DEFINITIVAMENTE la fosa seleccionada? Esta acción no se puede deshacer, ni siquiera desde la base de datos."
                          data-confirm-icon="warning">
                        <input type="hidden" asp-for="TipoParcelaId" />

                        <div class="form-columns-container3">
                            <div>
                                <label for="selectSeccionEliminar" class="form-label">Sección<span class="obligatorio"> * </span></label>
                                <select class="form-select" id="selectSeccionEliminar" required>
                                    <option value="">Seleccione una sección</option>
                                </select>
                            </div>

                            <div>
                                <label for="selectParcelaEliminar" class="form-label">Fosa<span class="obligatorio"> * </span></label>
                                <select class="form-select" id="selectParcelaEliminar" name="parcelaId" required disabled>
                                    <option value="">Seleccione primero una sección</option>
                                </select>
                            </div>
                        </div>

                        <div class="form-button-registrar">
                            <button type="submit" class="btn btn-danger" id="btnEliminarParcela" disabled>Eliminar fosa</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
}

@* Renderizamos el manejador pasándole el DTO del modelo *@
<partial name="_SweetAlertHandler" model="Model.SweetAlert" />

@section Scripts {
    <partial name="_ValidationScriptsPartial" />

    <script>
        (function() {
            const tipoParcelaId = @Model.TipoParcelaId;
            const selectSeccion = document.getElementById('selectSeccionEliminar');
            const selectParcela = document.getElementById('selectParcelaEliminar');
            const btnEliminar = document.getElementById('btnEliminarParcela');

            if (!selectSeccion) return;

            fetch(`/Seccion/ObtenerSeccionesPorTipo?tipoParcelaId=${tipoParcelaId}`)
                .then(r => r.json())
                .then(data => {
                    data.forEach(s => {
                        const opt = document.createElement('option');
                        opt.value = s.id;
                        opt.textContent = s.nombre;
                        selectSeccion.appendChild(opt);
                    });
                });

            selectSeccion.addEventListener('change', function() {
                const seccionId = this.value;
                selectParcela.innerHTML = '';
                btnEliminar.disabled = true;

                if (!seccionId) {
                    selectParcela.innerHTML = '<option value="">Seleccione primero una sección</option>';
                    selectParcela.disabled = true;
                    return;
                }

                selectParcela.innerHTML = '<option value="">Cargando...</option>';

                fetch(`/Seccion/ObtenerParcelasEliminables?seccionId=${seccionId}`)
                    .then(r => r.json())
                    .then(data => {
                        selectParcela.innerHTML = '';
                        if (data.length === 0) {
                            selectParcela.innerHTML = '<option value="">No hay parcelas disponibles para eliminar</option>';
                            selectParcela.disabled = true;
                        } else {
                            selectParcela.innerHTML = '<option value="">Seleccione una parcela</option>';
                            data.forEach(p => {
                                const opt = document.createElement('option');
                                opt.value = p.id;
                                opt.textContent = p.descripcion;
                                selectParcela.appendChild(opt);
                            });
                            selectParcela.disabled = false;
                        }
                    });
            });

            selectParcela.addEventListener('change', function() {
                btnEliminar.disabled = !this.value;
            });
        })();
    </script>
}

