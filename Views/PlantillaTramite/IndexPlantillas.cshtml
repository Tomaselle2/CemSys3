@using CemSys3.Enumerables
@{
    ViewData["Title"] = "Plantillas de trámites";
}


<div class="page-header-container">
    <a asp-action="Index" asp-controller="Configuracion" class="btn btn-secondary m-3" title="Configuración"><i class="bi bi-arrow-left"></i></a>
    <h1 class="title-page">Plantillas de trámites</h1>
</div>

<div class="container3">
    <a asp-action="CambioTitularPresente" asp-route-plantillaId="@((int)TipoAutorizacionEnum.Cambio_Titular_Ambos_Presentes)" asp-controller="PlantillaTramite" class="btn-inicio">
        <i class="bi bi-ui-radios"></i>
        <span>Cambio de Titular - Ambos Presentes</span>
    </a>

    <a asp-action="AceptacionTitularidad" asp-route-plantillaId="@((int)TipoAutorizacionEnum.AceptacionTitularidad)" asp-controller="PlantillaTramite" class="btn-inicio">
        <i class="bi bi-ui-radios"></i>
        <span>Aceptación de Titularidad</span>
    </a>

    <a asp-action="CremacionAutorizacion" asp-route-plantillaId="@((int)TipoAutorizacionEnum.CremacionAutorizacion)" asp-controller="PlantillaTramite" class="btn-inicio">
        <i class="bi bi-ui-radios"></i>
        <span>Cremación - Autorización</span>
    </a>
</div>

