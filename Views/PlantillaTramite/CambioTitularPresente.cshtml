@using CemSys3.ViewModels.PlantillaTramite
@model PlantillaTramiteVM

@{
    ViewData["Title"] = "Plantilla de Cambio de Titularidad - Ambos Presentes";
}

<div class="page-header-container">
    <a asp-action="Index" asp-controller="PlantillaTramite" class="btn btn-secondary m-3" title="Configuración"><i class="bi bi-arrow-left"></i></a>
    <h1 class="title-page">Cambio de Titular</h1>
</div>

<h3>Ambos titulares se encuentran presentes</h3>

<div>
    <strong>Variables disponibles:</strong>
    <ul>
        <li>{TitularesActuales}</li>
        <li>{NuevosTitulares}</li>
        <li>{Parcela}</li>
        <li>{Fecha}</li>
    </ul>
</div>

<form asp-action="Guardar" asp-controller="PlantillaTramite" method="post">
    <input type="hidden" asp-for="vista" />
    <input type="hidden" asp-for="Dto.Id" />
    <input type="hidden" asp-for="Dto.TipoTramiteId" />
    <input type="hidden" asp-for="Dto.TipoEscenario" />


    <div class="mb-3">
        <label>Nombre<span class="obligatorio"> *</span></label>
        <input type="text" class="form-control shadow-sm" asp-for="Dto.Nombre" />
    </div>

    <textarea id="editor" asp-for="Dto.Contenido"></textarea>
    <br />
    <button type="submit" class="btn btn-primary">Guardar</button>
</form>


@* <p>Lo que ve el empleado</p>
<div id="preview" style="border:1px solid #ccc; padding:15px;">
    @Html.Raw(Model.Dto.Contenido)
</div> *@

<partial name="_SweetAlertHandler" model="Model.SweetAlert" />

<script src="https://cdn.ckeditor.com/ckeditor5/41.4.2/classic/ckeditor.js"></script>
@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function () {
        // inicializar CKEditor acá
            ClassicEditor
            .create(document.querySelector('#editor'), {
            toolbar: [
            'heading', '|',
            'bold', 'italic',
            'link',
            'bulletedList', 'numberedList',
            '|',
            'imageUpload',
            '|',
            'undo', 'redo'
            ],
            ckfinder: {
            uploadUrl: '/PlantillaTramite/SubirImagen' // 👈 CLAVE
            }
            })
            .then(editor => {

            document.querySelector('form').addEventListener('submit', function () {
            document.querySelector('#editor').value = editor.getData();
            });

            })
            .catch(error => console.error(error));
        });
        
    </script>
}
