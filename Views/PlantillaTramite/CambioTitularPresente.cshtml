@using CemSys3.ViewModels.PlantillaTramite
@model PlantillaTramiteVM

@{
    ViewData["Title"] = "Plantilla de Cambio de Titularidad - Ambos Presentes";
}

<div class="page-header-container">
    <a asp-action="IndexPlantillas" asp-controller="PlantillaTramite" class="btn btn-secondary m-3" title="Configuración"><i class="bi bi-arrow-left"></i></a>
    <h1 class="title-page">Cambio de Titular</h1>
</div>

<h3>Ambos titulares se encuentran presentes</h3>

<div>
    <strong>Variables disponibles:</strong>
    <ul>
        <li>{Fecha}</li>
        <li>{articuloTitularActual}</li>
        <li>{sr/sraTitularActual}</li>
        <li>{TitularesActuales}</li>
        <li>{DniTitularActual}</li>
        <li>{Parcela}</li>
        <li>{Difuntos}</li>
        <li>{articuloNuevoTitular}</li>
        <li>{sr/sraNuevoTitular}</li>
        <li>{NuevosTitulares}</li>
        <li>{DniNuevosTitulares}</li>
    </ul>
</div>

<form asp-action="Guardar" asp-controller="PlantillaTramite" method="post">
    <input type="hidden" asp-for="vista" />
    <input type="hidden" asp-for="Dto.PlantillaId" />
    <input type="hidden" asp-for="Dto.TipoTramiteId" />
    <input type="hidden" asp-for="Dto.TipoAutorizacionId" />


    <div class="mb-3">
        <label>Nombre<span class="obligatorio"> *</span></label>
        <input type="text" class="form-control shadow-sm" asp-for="Dto.Nombre" />
    </div>

    <textarea id="editor" asp-for="Dto.Contenido"></textarea>
    <br />
    <button type="submit" class="btn btn-primary">Guardar</button>
</form>

<partial name="_SweetAlertHandler" model="Model.SweetAlert" />

<script src="~/tinymce/js/tinymce/tinymce.min.js" referrerpolicy="origin" crossorigin="anonymous"></script>

@section Scripts {
    <script>
        tinymce.init({
        selector: '#editor',
        license_key: 'gpl',
        language: 'es_MX',
        menu: {
          file: { title: 'File', items: 'newdocument restoredraft | preview | importword exportpdf exportword | print | deleteallconversations' },
          edit: { title: 'Edit', items: 'undo redo | cut copy paste pastetext | selectall | searchreplace' },
          view: { title: 'View', items: 'code suggestededits revisionhistory | visualaid visualchars visualblocks | spellchecker | preview fullscreen | showcomments' },
          insert: { title: 'Insert', items: 'image link media addcomment pageembed codesample inserttable | math | charmap emoticons hr | pagebreak nonbreaking anchor tableofcontents | insertdatetime' },
          format: { title: 'Format', items: 'bold italic underline strikethrough superscript subscript codeformat | styles blocks fontfamily fontsize align lineheight | forecolor backcolor | language | removeformat' },
          tools: { title: 'Tools', items: 'spellchecker spellcheckerlanguage | a11ycheck code wordcount' },
          table: { title: 'Table', items: 'inserttable | cell row column | advtablesort | tableprops deletetable' }
        },
        toolbar: 'undo redo | styles forecolor | bold italic | alignleft aligncenter alignright alignjustify | outdent indent | image | code',
        statusbar: false,
        plugins: 'image code autoresize',

        // Configuración de autoresize
                autoresize_bottom_margin: 20,      // Margen inferior en píxeles
                autoresize_min_height: 200,         // Altura mínima (evita que se encoja demasiado)
                autoresize_max_height: 800,         // Altura máxima (opcional, evita que crezca infinitamente)
                autoresize_overflow_padding: 10,    // Padding adicional
           
        });
    </script>
}

