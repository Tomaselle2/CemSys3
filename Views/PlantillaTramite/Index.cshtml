@using CemSys3.Enumerables
@{
    ViewData["Title"] = "Plantillas de trámites";
}


<div class="page-header-container">
    <a asp-action="Index" asp-controller="Configuracion" class="btn btn-secondary m-3" title="Configuración"><i class="bi bi-arrow-left"></i></a>
    <h1 class="title-page">Plantillas de trámites</h1>
</div>

<p>Ir a plantilla de cambio de titularidad</p>

<a asp-action="CambioTitularPresente" asp-route-plantillaId="@((int)PlantillasTramitesEnum.CambioTipo1)" asp-controller="PlantillaTramite" class="btn-inicio">
    <i class="bi bi-ui-radios"></i>
    <span>Cambio de Titular - Ambos Presentes.</span>
</a>